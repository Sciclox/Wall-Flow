<Window x:Class="WallFlow.Windows.OnlineGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent"
        Width="860" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="{DynamicResource AppFontFamily}">


    <Window.Resources>
        <!-- Colors -->
        <Color x:Key="Accent">#0A84FF</Color>
        <Color x:Key="AccentHover">#409CFF</Color>
        <Color x:Key="Surface">#2C2C2E</Color>
        <Color x:Key="SurfaceAlt">#1C1C1E</Color>
        <Color x:Key="Border">#3A3A3C</Color>
        <Color x:Key="TextPrimary">White</Color>
        <Color x:Key="TextSecondary">#CCCCCC</Color>
        <Color x:Key="TextMuted">#888888</Color>
        <Color x:Key="Danger">#FF453A</Color>
 
        <!-- Brushes -->
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#502C2C2E" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#301C1C1E" />
        <SolidColorBrush x:Key="BorderBrush" Color="#1EFFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
 
        <!-- Shadows -->
        <DropShadowEffect x:Key="TileShadow" BlurRadius="12" Opacity="0.45" ShadowDepth="3" Color="Black" />
        <DropShadowEffect x:Key="ElevatedShadow" BlurRadius="20" Opacity="0.5" ShadowDepth="5" Color="Black" />

        <!-- ComboBox toggle button (transparent full-area background) -->
        <ControlTemplate x:Key="DarkComboToggleButton" TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" />
        </ControlTemplate>

        <!-- ComboBox dark template (click anywhere to open) -->
        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <Border x:Name="MainBorder" CornerRadius="6"
                        Background="Transparent"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Full-area toggle button (spans both columns) -->
                        <ToggleButton Grid.ColumnSpan="2" x:Name="ToggleButton"
                            Template="{StaticResource DarkComboToggleButton}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press" Focusable="False"
                            Background="Transparent" />

                        <!-- Content + chevron on top (not interactive) -->
                        <ContentPresenter Grid.Column="0"
                            Margin="8,4,4,4"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            IsHitTestVisible="False" />
                        <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                   Width="26" IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Popup x:Name="Popup" AllowsTransparency="True"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       Placement="Bottom" Focusable="False"
                       PopupAnimation="Fade">
                    <Grid MinWidth="{TemplateBinding ActualWidth}">
                        <Border CornerRadius="6" Background="#252525"
                                BorderBrush="#333333" BorderThickness="1"
                                Margin="0,4,0,0"
                                Effect="{StaticResource ElevatedShadow}">
                            <ScrollViewer>
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>
        <!-- Search box border premium style with focus visual states -->
        <Style x:Key="SearchBoxBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="#181818" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="32" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="8" Opacity="0.3" ShadowDepth="0" Color="{DynamicResource AccentColor}" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Premium Custom Vertical ScrollBar Style -->
        <Style x:Key="PremiumVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#1DFFFFFF"
                                                        x:Name="ThumbBorder" Width="5" HorizontalAlignment="Center" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#45FFFFFF" />
                                                        <Setter TargetName="ThumbBorder" Property="Width" Value="6" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Apply button premium style with gradient and hover glow -->
        <Style x:Key="ApplyButtonStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="0.0" />
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="0.0" />
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="6" Opacity="0.3" ShadowDepth="0" Color="{DynamicResource AccentColor}" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary button premium style with glass hover effect -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#12FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2DFFFFFF" />
                    <Setter Property="BorderBrush" Value="#22FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="8" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#95202022" Offset="0.0" />
                <GradientStop Color="#650F0F11" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#38FFFFFF" Offset="0.0" />
                <GradientStop Color="#12FFFFFF" Offset="1.0" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ─── Top bar ─── -->
            <Border Grid.Row="0" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Source toggle -->
                    <Border Grid.Column="0" x:Name="SourceToggle" CornerRadius="7" Background="#141416"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="2" Margin="4,0,12,0" Cursor="Hand"
                            MouseLeftButtonUp="SourceToggle_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Local tab -->
                            <Border Grid.Column="0" x:Name="LocalTab" CornerRadius="5" Padding="12,5" Background="#636366" Margin="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" Opacity="0.2" ShadowDepth="1.5" Color="Black" />
                                </Border.Effect>
                                <TextBlock x:Name="LocalText" Text="Local" FontSize="13"
                                           FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <!-- Online tab -->
                            <Border Grid.Column="1" x:Name="OnlineTab" CornerRadius="5" Padding="12,5" Background="Transparent" Margin="1">
                                <TextBlock x:Name="OnlineText" Text="Online" FontSize="13"
                                           FontWeight="Normal" Foreground="#98989D" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Search box -->
                    <Border Grid.Column="1" Style="{StaticResource SearchBoxBorderStyle}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox Grid.Column="0" x:Name="SearchBox" FontSize="13" Foreground="White"
                                     Background="Transparent" BorderThickness="0" Padding="28,6,6,6"
                                     CaretBrush="White" IsTabStop="False"
                                     VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged" />
                            <Border Grid.Column="1" x:Name="SearchClearBtn" Width="24" Height="24" CornerRadius="4"
                                    Background="Transparent" Cursor="Hand" Visibility="Collapsed"
                                    MouseLeftButtonUp="SearchClearBtn_Click"
                                    Margin="0,0,4,0">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Folder button -->
                    <Border Grid.Column="2" x:Name="FolderBtn" Width="30" Height="30" CornerRadius="6" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonUp="FolderBtn_Click" Margin="0,0,6,0"
                            MouseEnter="FolderBtn_MouseEnter" MouseLeave="FolderBtn_MouseLeave"
                            ToolTip="Cambiar carpeta de wallpapers">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Close button -->
                    <Border Grid.Column="3" x:Name="CloseBtn" Width="30" Height="30" CornerRadius="6" Background="Transparent"
                            Cursor="Hand" MouseLeftButtonUp="CloseBtn_Click"
                            MouseEnter="CloseBtn_MouseEnter" MouseLeave="CloseBtn_MouseLeave">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Suggested Category Badges -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="6,6,0,2">
                        <TextBlock Text="Sugeridos:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        
                        <Border CornerRadius="10" Background="#1AFFFFFF" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonUp="Category_Click">
                            <TextBlock Text="Cyberpunk" FontSize="11" Foreground="White" />
                        </Border>
                        <Border CornerRadius="10" Background="#1AFFFFFF" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonUp="Category_Click">
                            <TextBlock Text="Anime" FontSize="11" Foreground="White" />
                        </Border>
                        <Border CornerRadius="10" Background="#1AFFFFFF" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonUp="Category_Click">
                            <TextBlock Text="Minimalista" FontSize="11" Foreground="White" />
                        </Border>
                        <Border CornerRadius="10" Background="#1AFFFFFF" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonUp="Category_Click">
                            <TextBlock Text="Naturaleza" FontSize="11" Foreground="White" />
                        </Border>
                        <Border CornerRadius="10" Background="#1AFFFFFF" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonUp="Category_Click">
                            <TextBlock Text="Espacio" FontSize="11" Foreground="White" />
                        </Border>
                        <Border CornerRadius="10" Background="#1AFFFFFF" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonUp="Category_Click">
                            <TextBlock Text="Abstracto" FontSize="11" Foreground="White" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─── Gallery / Detail ─── -->
            <Grid Grid.Row="1">
                <!-- Gallery view -->
                <Grid x:Name="GalleryView" Visibility="Visible">
                    <Grid.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </Grid.RenderTransform>
                    <Grid>
                        <ListBox x:Name="WallpaperListBox" Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Standard"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource PremiumVerticalScrollBar}" />
                            </ListBox.Resources>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Loading overlay -->
                        <Border x:Name="LoadingOverlay" Background="#CC1A1A1A" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ProgressBar x:Name="Spinner" IsIndeterminate="True" Width="180" Height="3"
                                             Foreground="{StaticResource AccentBrush}" Background="#333333"
                                             BorderThickness="0" Margin="0,0,0,14" />
                                <TextBlock Text="Cargando..." FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Empty overlay -->
                        <Border x:Name="EmptyOverlay" Background="#CC1A1A1A" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                           Foreground="#444444" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                <TextBlock x:Name="EmptyText" Text="No se encontraron wallpapers"
                                           FontSize="15"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Detail view -->
                <Grid x:Name="DetailView" Visibility="Collapsed" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform X="150" Y="0" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Detail header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" x:Name="BackBtn" Style="{StaticResource SecondaryButtonStyle}"
                                MouseLeftButtonUp="BackBtn_Click" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Volver" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Column="1" x:Name="DetailTitle" FontSize="15"
                                   FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <Border Grid.Column="2" x:Name="ViewOnlineBtn" Style="{StaticResource SecondaryButtonStyle}"
                                MouseLeftButtonUp="ViewOnline_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Ver online" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Preview image -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Border CornerRadius="8" Background="#111111"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PreviewBorder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Border.Background>
                                        <ImageBrush x:Name="PreviewBrush" Stretch="Uniform" />
                                    </Border.Background>
                                </Border>
                                <!-- Inner shadow overlay -->
                                <Border IsHitTestVisible="False" CornerRadius="8" BorderThickness="1">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="Black" Opacity="0.25" />
                                    </Border.BorderBrush>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="LoadingText" Text="Cargando..." FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>

                    <!-- Detail actions -->
                    <Border Grid.Row="2" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Resolution selector -->
                            <ComboBox x:Name="ResolutionCombo" FontSize="13" Foreground="White"
                                      Background="Transparent" BorderBrush="#333333" BorderThickness="1"
                                      MinWidth="100" SelectedIndex="0"
                                      Template="{StaticResource DarkComboBoxTemplate}">
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#252525" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#CCCCCC" />
                                </ComboBox.Resources>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#252525" />
                                        <Setter Property="Foreground" Value="#CCCCCC" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="8,4" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3D3D3D" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="#555555" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.Items>
                                    <ComboBoxItem Content="4K" Tag="4k" />
                                    <ComboBoxItem Content="2K" Tag="2k" />
                                    <ComboBoxItem Content="HD" Tag="hd" />
                                    <ComboBoxItem Content="Phone 4K" Tag="phone-4k" />
                                    <ComboBoxItem Content="Phone HD" Tag="phone-hd" />
                                </ComboBox.Items>
                            </ComboBox>

                            <!-- Apply button -->
                            <Border Grid.Column="1" x:Name="ApplyBtn" Style="{StaticResource ApplyButtonStyle}"
                                    MouseLeftButtonUp="ApplyBtn_Click" Margin="8,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Aplicar" FontSize="13" FontWeight="SemiBold"
                                               Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Save button -->
                            <Border Grid.Column="2" x:Name="SaveBtn" Style="{StaticResource SecondaryButtonStyle}" Padding="14,7"
                                    MouseLeftButtonUp="SaveBtn_Click" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Guardar" FontSize="13" FontWeight="SemiBold"
                                               Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Status text (right-aligned via star spacer) -->
                            <TextBlock Grid.Column="4" x:Name="StatusText" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ─── Footer: sort + pagination ─── -->
            <Border Grid.Row="2" x:Name="FooterBar" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="SortCombo" FontSize="13" Foreground="White"
                               Background="Transparent" BorderBrush="#333333" BorderThickness="1"
                               MinWidth="160" Margin="0,0,12,0" SelectedIndex="0"
                               SelectionChanged="SortCombo_SelectionChanged"
                               Template="{StaticResource DarkComboBoxTemplate}">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#252525" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#CCCCCC" />
                        </ComboBox.Resources>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#252525" />
                                <Setter Property="Foreground" Value="#CCCCCC" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="8,4" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3D3D3D" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="#555555" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.Items>
                            <ComboBoxItem Content="Ordenar por..." Tag="" IsEnabled="False" Visibility="Collapsed" />
                            <ComboBoxItem Content="Nombre (A-Z)" Tag="name-asc" />
                            <ComboBoxItem Content="Nombre (Z-A)" Tag="name-desc" />
                            <ComboBoxItem Content="Más nuevos primero" Tag="date-desc" />
                            <ComboBoxItem Content="Más antiguos primero" Tag="date-asc" />
                            <ComboBoxItem Content="Tamaño (Menor a Mayor)" Tag="size-asc" />
                            <ComboBoxItem Content="Tamaño (Mayor a Menor)" Tag="size-desc" />
                        </ComboBox.Items>
                    </ComboBox>

                    <!-- Pagination segmented control -->
                    <Border Grid.Column="1" x:Name="PaginationGroup" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Background="#2D2D2D" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Prev -->
                            <Border Grid.Column="0" x:Name="PrevBtn" Padding="10,4" Background="Transparent"
                                    Cursor="Hand" IsEnabled="False"
                                    MouseLeftButtonUp="PrevBtn_Click">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </Border>

                            <!-- Page text -->
                            <TextBlock Grid.Column="1" x:Name="PageText" Text="Página 1 de 1"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Padding="10,4" />

                            <!-- Next -->
                            <Border Grid.Column="2" x:Name="NextBtn" Padding="10,4" Background="Transparent"
                                    Cursor="Hand" IsEnabled="False"
                                    MouseLeftButtonUp="NextBtn_Click">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Column="4" x:Name="FooterStatus" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
