<Window x:Class="WallFlow.Windows.BookmarkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WallFlowWindow}"
        Title="Editar Marcador"
        Width="380"
        Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="#E0FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#10FFFFFF" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource FrostedFlyoutBorder}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Title -->
                <RowDefinition Height="*" />    <!-- Inputs -->
                <RowDefinition Height="Auto" /> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="Editar Marcador" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" FontFamily="{DynamicResource AppFontFamily}"/>

            <!-- Inputs -->
            <StackPanel Grid.Row="1" Orientation="Vertical">
                <!-- Name Input -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Nombre:" Foreground="#A0FFFFFF" FontSize="12.5" VerticalAlignment="Center" FontFamily="{DynamicResource AppFontFamily}"/>
                    <Border Grid.Column="1" CornerRadius="6" Background="#20FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" Height="28">
                        <TextBox x:Name="NameTextBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                 FontSize="12" VerticalAlignment="Center" Margin="8,0" FontFamily="{DynamicResource AppFontFamily}"/>
                    </Border>
                </Grid>

                <!-- URL Input -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Dirección:" Foreground="#A0FFFFFF" FontSize="12.5" VerticalAlignment="Center" FontFamily="{DynamicResource AppFontFamily}"/>
                    <Border Grid.Column="1" CornerRadius="6" Background="#20FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" Height="28">
                        <TextBox x:Name="UrlTextBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                 FontSize="12" VerticalAlignment="Center" Margin="8,0" FontFamily="{DynamicResource AppFontFamily}"/>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="SaveButton" Content="Guardar" Click="SaveButton_Click" Width="85" Height="28" Margin="0,0,8,0" Style="{StaticResource DialogButtonStyle}" FontSize="12"/>
                <Button x:Name="CancelButton" Content="Cancelar" Click="CancelButton_Click" Width="85" Height="28" Style="{StaticResource DialogButtonStyle}" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
