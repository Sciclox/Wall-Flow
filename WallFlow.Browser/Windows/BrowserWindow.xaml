<Window x:Class="WallFlow.Windows.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:services="clr-namespace:WallFlow.Services"
        Style="{StaticResource WallFlowWindow}"
        Title="Navegador"
        Width="600"
        Height="700"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Topmost="False"
        ShowInTaskbar="True"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged"
        ResizeMode="CanResize"
        FontFamily="{DynamicResource AppFontFamily}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" 
                      ResizeBorderThickness="6" 
                      CornerRadius="8" 
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Maximize and Restore Icon string codes using Google Material Symbols Outlined -->
        <sys:String x:Key="MaximizeIcon">&#xe3c6;</sys:String>
        <sys:String x:Key="RestoreIcon">&#xf4c8;</sys:String>

        <!-- Style for Header Navigation Buttons -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A0FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{StaticResource MaterialIconsFont}" />
            <Setter Property="FontSize" Value="20.5" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="19" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextBlock.FontFamily="{TemplateBinding FontFamily}" TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Styled Pin/Close Buttons -->
        <Style x:Key="HeaderAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="19" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextBlock.FontFamily="{TemplateBinding FontFamily}" TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Tabs Dropdown Button -->
        <Style x:Key="TabsDropdownButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#10FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#25FFFFFF" />
                                <Setter Property="BorderBrush" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Group Tabs -->
        <Style x:Key="GroupTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="#E0FFFFFF" />
            <Setter Property="BorderBrush" Value="#10FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentGroupBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style for Bookmark Buttons -->
        <Style x:Key="BookmarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="#E0FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#10FFFFFF" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Address Bar Buttons (like StarButton) -->
        <Style x:Key="AddressBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="14" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"
                                               TextBlock.FontFamily="{StaticResource MaterialIconsFont}" TextBlock.FontSize="14" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Window Control Buttons (Minimize / Maximize) -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#EEEEEEEE" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{StaticResource MaterialIconsFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextBlock.FontFamily="{TemplateBinding FontFamily}" TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Window Close Button -->
        <Style x:Key="WindowCloseControlButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextBlock.FontFamily="{TemplateBinding FontFamily}" TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#F1707A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Translucent Dark Border matching Wall-Flow Theme -->
    <Border x:Name="RootBorder" Style="{StaticResource FrostedFlyoutBorder}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                <RotateTransform x:Name="RootRotate" Angle="0" />
                <TranslateTransform x:Name="RootTranslate" X="0" Y="0" />
            </TransformGroup>
        </Border.RenderTransform>
        <Grid x:Name="MainGrid" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Row 0: Title & Actions -->
                <RowDefinition Height="Auto" /> <!-- Row 1: Address Bar & Navigation -->
                <RowDefinition Height="Auto" /> <!-- Row 2: Bookmarks Bar -->
                <RowDefinition Height="*" />    <!-- Row 3: WebView2 Content -->
            </Grid.RowDefinitions>

            <!-- Row 0: Title & Window Actions -->
            <Grid x:Name="TitleRow" Grid.Row="0" Margin="0,6,0,0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title Left (Tab Groups Bar) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Groups List -->
                    <ItemsControl x:Name="GroupsItemsControl"
                                  AllowDrop="True"
                                  DragOver="GroupsItemsControl_DragOver"
                                  Drop="GroupsItemsControl_Drop">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="GroupButton_Click" 
                                        Style="{StaticResource GroupTabButtonStyle}" 
                                        Margin="0,0,6,0"
                                        AllowDrop="True"
                                        PreviewMouseLeftButtonDown="GroupButton_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="GroupButton_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="GroupButton_PreviewMouseLeftButtonUp"
                                        DragOver="GroupButton_DragOver"
                                        Drop="GroupButton_Drop">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Renombrar" Click="RenameGroupMenu_Click" />
                                            <MenuItem Header="Cerrar grupo" Click="CloseGroupMenu_Click" />
                                            <MenuItem Header="Mover a nueva ventana" Click="MoveGroupToNewWindowMenu_Click" />
                                            <MenuItem Header="Unir ventana a este grupo" SubmenuOpened="MergeWindowSubMenu_SubmenuOpened" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid VerticalAlignment="Center">
                                            <!-- Read-only TextBlock -->
                                            <TextBlock x:Name="GroupNameTextBlock" 
                                                       Text="{Binding Name}" 
                                                       FontFamily="{DynamicResource AppFontFamily}" 
                                                       FontSize="13" 
                                                       VerticalAlignment="Center" 
                                                       MaxWidth="100" 
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="Visible"/>
                                            
                                            <!-- Editable TextBox -->
                                            <TextBox x:Name="GroupNameTextBox" 
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                     FontFamily="{DynamicResource AppFontFamily}" 
                                                     FontSize="13" 
                                                     Foreground="White"
                                                     CaretBrush="White"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     VerticalAlignment="Center"
                                                     MaxWidth="100"
                                                     Visibility="Collapsed"
                                                     LostFocus="GroupNameTextBox_LostFocus"
                                                     KeyDown="GroupNameTextBox_KeyDown"
                                                     PreviewMouseLeftButtonDown="GroupNameTextBox_PreviewMouseLeftButtonDown"/>
                                        </Grid>
                                        <Viewbox Width="9" Height="4.5" Margin="6,1,0,0" VerticalAlignment="Center">
                                            <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#80FFFFFF" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Viewbox>
                                    </StackPanel>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter TargetName="GroupNameTextBlock" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="GroupNameTextBox" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                     <!-- Add Group Button -->
                    <Button x:Name="AddGroupButton" 
                            Click="AddGroupButton_Click" 
                            ToolTip="Nuevo grupo de pestañas"
                            Width="36"
                            Height="34"
                            Margin="6,0,0,0"
                            Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Border" 
                                        Background="#15FFFFFF" 
                                        BorderBrush="#10FFFFFF" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        SnapsToDevicePixels="True"
                                        Cursor="Hand">
                                    <Path Data="M 6,10 L 14,10 M 10,6 L 10,14" 
                                          Stroke="#A0FFFFFF" 
                                          StrokeThickness="1.5" 
                                          StrokeStartLineCap="Round" 
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          Width="12"
                                          Height="12"
                                          Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#25FFFFFF" />
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#20FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#35FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Actions Right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- New Window Button -->
                    <Button x:Name="NewWindowButton" 
                             Click="NewWindowButton_Click" 
                             Style="{StaticResource HeaderButtonStyle}" 
                             ToolTip="Nueva ventana" 
                             Margin="0,0,4,0"
                             Content="&#xe89e;" />

                    <!-- Tile Button -->
                    <Button x:Name="TileButton" 
                             Click="TileButton_Click" 
                             Style="{StaticResource HeaderButtonStyle}" 
                             ToolTip="Organizar ventanas en mosaico" 
                             Margin="0,0,4,0"
                             Content="&#xe9b0;" />

                    <!-- Merge Windows Button -->
                    <Button x:Name="MergeWindowsButton" 
                             Click="MergeWindowsButton_Click" 
                             Style="{StaticResource HeaderButtonStyle}" 
                             ToolTip="Unificar todas las ventanas en esta" 
                             Margin="0,0,4,0"
                             Content="&#xe0b3;" />

                    <!-- Pin Button -->
                    <Button x:Name="PinButton" 
                             Click="PinButton_Click" 
                             Style="{StaticResource HeaderButtonStyle}" 
                             ToolTip="Mantener visible (Anclar)" 
                             Margin="0,0,4,0"
                             Content="&#xf3ab;" />

                    <!-- Separator -->
                    <Border Width="1" Height="14" Background="#30FFFFFF" VerticalAlignment="Center" Margin="4,0,8,0" SnapsToDevicePixels="True" />
                    <!-- Minimize Button -->
                    <Button x:Name="MinimizeButton" 
                              Click="MinimizeButton_Click" 
                              Style="{StaticResource WindowControlButtonStyle}" 
                              ToolTip="Minimizar" 
                              Margin="0">
                        <TextBlock Text="&#xe931;"
                                   FontFamily="{StaticResource MaterialIconsFont}"
                                   FontSize="22"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="-5" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>

                    <!-- Maximize Button -->
                    <Button x:Name="MaximizeButton" 
                               Content="{StaticResource MaximizeIcon}" 
                               Click="MaximizeButton_Click" 
                               Style="{StaticResource WindowControlButtonStyle}" 
                               ToolTip="Maximizar / Restaurar" 
                               Margin="0" />
                    
                    <!-- Close Button -->
                    <Button x:Name="CloseButton" 
                               Click="CloseButton_Click" 
                               Style="{StaticResource WindowCloseControlButtonStyle}" 
                               ToolTip="Cerrar"
                               FontSize="22"
                               Content="&#xe5cd;" 
                               Margin="0" />
                </StackPanel>
            </Grid>

            <!-- Row 1: Navigation Buttons & Address Bar -->
            <Grid x:Name="AddressBarRow" Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Nav Buttons -->
                    <ColumnDefinition Width="*" />    <!-- Address Bar -->
                </Grid.ColumnDefinitions>

                <!-- Navigation Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button x:Name="BackButton" 
                            Content="&#xe5c4;" 
                            Click="BackButton_Click" 
                            Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Atrás" />
                    <Button x:Name="ForwardButton" 
                            Content="&#xe5c8;" 
                            Click="ForwardButton_Click" 
                            Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Adelante" />
                    <Button x:Name="RefreshButton" 
                            Content="&#xe5d5;" 
                            Click="RefreshButton_Click" 
                            Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Recargar" />
                    <Button x:Name="HomeButton" 
                            Content="&#xe9b2;" 
                            Click="HomeButton_Click" 
                            Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Inicio" />
                    <Button x:Name="ToggleBookmarksButton" 
                            Content="&#xe98b;" 
                            Click="ToggleBookmarksButton_Click" 
                            PreviewMouseLeftButtonDown="ToggleBookmarksButton_PreviewMouseLeftButtonDown"
                            Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Mostrar / Ocultar marcadores" />
                </StackPanel>

                <!-- Address Bar TextBox (with active focus glow) -->
                <Border x:Name="AddressBorder" Grid.Column="1" CornerRadius="12" BorderThickness="1" Height="38">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#20FFFFFF" />
                            <Setter Property="BorderBrush" Value="#15FFFFFF" />
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Background" Value="#30FFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SecurityIcon" Text="&#xea07;" FontFamily="{StaticResource MaterialIconsFont}" FontSize="14" Foreground="#60FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="AddressTextBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                 FontSize="14" VerticalAlignment="Center" KeyDown="AddressTextBox_KeyDown"
                                 TextChanged="AddressTextBox_TextChanged" PreviewKeyDown="AddressTextBox_PreviewKeyDown"
                                 MouseDoubleClick="AddressTextBox_MouseDoubleClick"
                                 FontFamily="{DynamicResource AppFontFamily}" Padding="0,4" />
                        
                        <Button x:Name="StarButton" Grid.Column="2" 
                                Content="&#xf09a;" 
                                Style="{StaticResource AddressBarButtonStyle}"
                                Click="StarButton_Click" 
                                ToolTip="Añadir a marcadores" />
                    </Grid>
                </Border>

                <!-- AutoComplete Popup -->
                <Popup x:Name="AutoCompletePopup" 
                       Grid.Column="1"
                       PlacementTarget="{Binding ElementName=AddressBorder}" 
                       Placement="Bottom" 
                       IsOpen="False" 
                       StaysOpen="False" 
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <!-- Glassy background matching the app theme -->
                    <Border Background="#F51E1E1E" 
                            BorderBrush="#25FFFFFF" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Width="{Binding ElementName=AddressBorder, Path=ActualWidth}" 
                            Padding="4" 
                            Margin="0,4,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <ListBox x:Name="SuggestionsListBox" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="White" 
                                 MaxHeight="200"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Focusable="False"
                                 PreviewMouseLeftButtonUp="SuggestionsListBox_PreviewMouseLeftButtonUp">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#25FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xea07;" FontFamily="{StaticResource MaterialIconsFont}" FontSize="13" Foreground="#80FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Vertical">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Url}" Foreground="#80FFFFFF" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <!-- Row 2: Bookmarks Bar (Removed - replaced by BookmarksPopup) -->

            <!-- Row 3: WebView2 Content Container & New Tab Overlay -->
            <Border x:Name="WebViewBorder" Grid.Row="3" CornerRadius="8" ClipToBounds="True" Background="#FF121212">
                <Grid>
                    <!-- WebView2 Composition Host (DirectComposition-based, supports CornerRadius clipping) -->
                    <services:WebView2CompositionHost x:Name="WebViewHost" />

                    <!-- New Tab Page Overlay -->
                    <Grid x:Name="NewTabPageOverlay" Background="#FF151518" Visibility="Collapsed">
                        <!-- Dark background dimmer on top of the wallpaper image -->
                        <Grid x:Name="NewTabBackgroundDimmer" Background="#C0101012"/>
                        
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380" Margin="0,0,0,40">
                            <!-- Logo and Title -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <TextBlock Text="&#xea07;" FontFamily="{StaticResource MaterialIconsFont}" FontSize="42" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="Wall-Flow" FontFamily="{DynamicResource AppFontFamily}" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="Navegador" FontFamily="{DynamicResource AppFontFamily}" FontSize="12" Foreground="#80FFFFFF" VerticalAlignment="Bottom" Margin="6,0,0,4"/>
                            </StackPanel>

                            <!-- Centered Search Box -->
                            <Border CornerRadius="8" Background="#12FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" Height="42" Padding="12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xe8b6;" FontFamily="{StaticResource MaterialIconsFont}" FontSize="14" Foreground="#80FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="NewTabSearchTextBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                                             FontSize="14" VerticalAlignment="Center" FontFamily="{DynamicResource AppFontFamily}" 
                                             TextChanged="NewTabSearchTextBox_TextChanged" PreviewKeyDown="NewTabSearchTextBox_PreviewKeyDown"
                                             GotFocus="NewTabSearchTextBox_GotFocus"/>
                                    
                                    <!-- Placeholder Text -->
                                    <TextBlock x:Name="NewTabSearchPlaceholder" Grid.Column="1" Text="Buscar en Google o escribir dirección..."
                                               Foreground="#50FFFFFF" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Autocomplete Suggestions inside New Tab Page -->
                            <Border x:Name="NewTabSuggestionsBorder" CornerRadius="8" Background="#F018181C" BorderBrush="#15FFFFFF" BorderThickness="1" Margin="0,4,0,0" Padding="4" Visibility="Collapsed">
                                <ListBox x:Name="NewTabSuggestionsListBox" Background="Transparent" BorderThickness="0" Foreground="White" MaxHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False" PreviewMouseLeftButtonUp="NewTabSuggestionsListBox_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="Margin" Value="0,1"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#25FFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xea07;" FontFamily="{StaticResource MaterialIconsFont}" FontSize="13" Foreground="#80FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1" Orientation="Vertical">
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Url}" Foreground="#80FFFFFF" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Dynamic Shortcuts WrapPanel -->
                            <WrapPanel x:Name="NewTabShortcutsPanel" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <!-- Dynamic shortcut borders will be added here -->
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Tabs Dropdown Popup -->
            <Popup x:Name="TabsPopup" AllowsTransparency="True" StaysOpen="False" PlacementTarget="{Binding ElementName=TabsDropdownButton}" Placement="Bottom" PopupAnimation="Fade">
                <Border Width="240" CornerRadius="8" Background="#F01C1C22" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="6" Margin="0,4,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="2" Opacity="0.5"/>
                    </Border.Effect>
                    <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TabsPopupPanel">
                            <!-- Dynamic items will be added here -->
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- Bookmarks Dropdown Popup -->
            <Popup x:Name="BookmarksPopup" AllowsTransparency="True" StaysOpen="False" PlacementTarget="{Binding ElementName=ToggleBookmarksButton}" Placement="Bottom" PopupAnimation="Fade">
                <Border Width="220" CornerRadius="8" Background="#F01C1C22" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="6" Margin="0,4,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="2" Opacity="0.5"/>
                    </Border.Effect>
                    <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BookmarksPopupPanel">
                            <!-- Dynamic bookmark items will be added here -->
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- Holographic Beam Overlay (spans all rows, visible during materialize/dematerialize) -->
            <Rectangle x:Name="HologramBeam"
                       Grid.Row="0"
                       Grid.RowSpan="4"
                       Width="120"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Stretch"
                       Opacity="0"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00007AFF" Offset="0" />
                        <GradientStop Color="#A0007AFF" Offset="0.3" />
                        <GradientStop Color="#E0AF52DE" Offset="0.5" />
                        <GradientStop Color="#A0007AFF" Offset="0.7" />
                        <GradientStop Color="#00007AFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Effect>
                    <BlurEffect Radius="20" />
                </Rectangle.Effect>
            </Rectangle>
        </Grid>
    </Border>
</Window>
