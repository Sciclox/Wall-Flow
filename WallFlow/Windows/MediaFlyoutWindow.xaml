<Window x:Class="WallFlow.Windows.MediaFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WallFlowWindow}"
        Title="Media Control"
        Width="300"
        Height="170"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        FontFamily="{DynamicResource AppFontFamily}">

    <Window.Resources>
        <!-- Circular Control Button Style matching Dock styles -->
        <Style x:Key="MediaControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="19" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.FontFamily="Segoe MDL2 Assets" TextBlock.FontSize="14" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                <!-- Purple glow on hover -->
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.6" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentActiveBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Scale up on Hover -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                
                <EventTrigger RoutedEvent="PreviewMouseDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.88" Duration="0:0:0.06" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.88" Duration="0:0:0.06" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="PreviewMouseUp">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.12">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Translucent Dark Border matching Dock/PowerWindow -->
    <Border x:Name="RootBorder" Style="{StaticResource FrostedFlyoutBorder}">

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />    <!-- Track info (Title, Artist) -->
                <RowDefinition Height="Auto" /> <!-- Playback Controls -->
            </Grid.RowDefinitions>

            <!-- Album Art Background Overlay -->
            <Border x:Name="BgImageBorder"
                    Grid.RowSpan="2"
                    Margin="-16"
                    CornerRadius="8"
                    Opacity="0.22"
                    Visibility="Collapsed">
                <Border.Background>
                    <ImageBrush x:Name="BgImageBrush" Stretch="UniformToFill" />
                </Border.Background>
            </Border>

            <!-- Song Info Block -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,10">
                <TextBlock x:Name="TitleText"
                           Text="Título de la Canción"
                           Foreground="White"
                           FontFamily="{DynamicResource AppFontFamily}"
                           FontSize="13.5"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText"
                           Text="Artista"
                           Foreground="#A0FFFFFF"
                           FontFamily="{DynamicResource AppFontFamily}"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!-- Playback Control Buttons (Previous, Play/Pause, Next) -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Skip Previous -->
                <Button Style="{StaticResource MediaControlButtonStyle}"
                        Content="&#xE892;"
                        Click="Prev_Click" />

                <!-- Play / Pause (Larger center button) -->
                <Button x:Name="PlayPauseButton"
                        Style="{StaticResource MediaControlButtonStyle}"
                        Content="&#xE768;"
                        Click="PlayPause_Click"
                        Width="44" Height="44"
                        Margin="12,0">
                    <!-- Overrides default templates to handle custom corner radius on larger width/height -->
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="22" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextBlock.FontFamily="Segoe MDL2 Assets" TextBlock.FontSize="16" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                                    <Setter TargetName="Border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.75" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentActiveBrush}" />
                                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Skip Next -->
                <Button Style="{StaticResource MediaControlButtonStyle}"
                        Content="&#xE893;"
                        Click="Next_Click" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
