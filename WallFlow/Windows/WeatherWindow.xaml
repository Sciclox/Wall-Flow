<Window x:Class="WallFlow.Windows.WeatherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WallFlowWindow}"
        Title="Weather"
        Width="450" Height="210"
        ShowInTaskbar="False"
        Topmost="True"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Outfit Font Resource -->

    </Window.Resources>

    <Border x:Name="RootBorder" Style="{StaticResource FrostedFlyoutBorder}">

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top Info Card -->
                <RowDefinition Height="*" />    <!-- Horizontal 3-Day Forecast -->
            </Grid.RowDefinitions>

            <!-- Row 0: Top Info Card (distributed exactly like reference image) -->
            <Border Grid.Row="0"
                    Background="#0CFFFFFF"
                    BorderBrush="#15FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,10">
                <Grid>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Line 1: City & Temp or TextBox -->
                        <Grid HorizontalAlignment="Center">
                            <!-- Normal Title & Temp -->
                            <StackPanel x:Name="CityHeaderPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="CityText"
                                           Text="Cargando..."
                                           Foreground="#FFFFFFFF"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="TempText"
                                           Text=""
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- City Search Box (Initially hidden) -->
                            <TextBox x:Name="CitySearchBox"
                                     Visibility="Collapsed"
                                     Width="200"
                                     Background="#20FFFFFF"
                                     Foreground="#FFFFFFFF"
                                     CaretBrush="#FFFFFFFF"
                                     BorderBrush="#40FFFFFF"
                                     BorderThickness="1"
                                     Padding="6,2"
                                     FontFamily="{DynamicResource AppFontFamily}"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     KeyDown="CitySearchBox_KeyDown"
                                     LostFocus="CitySearchBox_LostFocus"
                                     VerticalAlignment="Center" />
                        </Grid>

                        <!-- Line 2: Feels Like, Condition, Humidity -->
                        <TextBlock x:Name="ConditionText"
                                   Text="Cargando..."
                                   Foreground="#C0FFFFFF"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />

                        <!-- Line 3: Pressure, Visibility, Cloudiness -->
                        <TextBlock x:Name="StatsText"
                                   Text=""
                                   Foreground="#75FFFFFF"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontSize="11"
                                   FontWeight="Normal"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- Edit Location Button (Top-Right) -->
                    <Button x:Name="EditCityButton"
                            Content="&#xE70F;"
                            FontFamily="Segoe MDL2 Assets"
                            Foreground="#40FFFFFF"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="24" Height="24"
                            FontSize="10"
                            Cursor="Hand"
                            Click="EditCityButton_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="-6,-4,0,0"
                            ToolTip="Cambiar ubicación" />
                </Grid>
            </Border>

            <!-- Row 1: Horizontal Forecast Cards -->
            <ItemsControl x:Name="ForecastItems" Grid.Row="1">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0CFFFFFF"
                                BorderBrush="#15FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="3,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Temp Info -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DayName}"
                                               Foreground="#EEFFFFFF"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold" />
                                    
                                    <TextBlock Text="{Binding MinTemp, StringFormat='Min: {0}'}"
                                               Foreground="#A0FFFFFF"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="10.5"
                                               FontWeight="Normal"
                                               Margin="0,3,0,0" />

                                    <TextBlock Text="{Binding MaxTemp, StringFormat='Max: {0}'}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Margin="0,1,0,0" />
                                </StackPanel>

                                <!-- Icon -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Glyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="26"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="8,0,2,0">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="{DynamicResource AccentHoverColor}" Offset="0" /> <!-- Light Accent -->
                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="1" /> <!-- Vibrant Accent -->
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
