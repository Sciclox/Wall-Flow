<Window x:Class="WallFlow.Windows.YouTubeMusicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Style="{StaticResource WallFlowWindow}"
        Title="YouTube Music"
        Width="500"
        Height="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        FontFamily="{DynamicResource AppFontFamily}">

    <Window.Resources>
        <!-- Style for Header Navigation Buttons -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A0FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="16" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.FontFamily="Segoe MDL2 Assets" TextBlock.FontSize="13" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Styled Pin/Close Buttons -->
        <Style x:Key="HeaderAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="16" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.FontFamily="Segoe MDL2 Assets" TextBlock.FontSize="13" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Translucent Dark Border matching Wall-Flow Theme -->
    <Border x:Name="RootBorder" Style="{StaticResource FrostedFlyoutBorder}">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- WebView2 Content -->
            </Grid.RowDefinitions>

            <!-- Header Controls -->
            <Grid Grid.Row="0" Margin="4,2,4,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Navigation -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Music Note Icon -->
                    <TextBlock x:Name="MusicNoteIcon" Text="&#xE189;" 
                               FontFamily="Segoe MDL2 Assets" 
                               FontSize="16" 
                               Foreground="{DynamicResource AccentBrush}" 
                               VerticalAlignment="Center" 
                               Margin="2,0,8,0" />
                    
                    <TextBlock Text="YouTube Music" 
                               Foreground="White" 
                               FontFamily="{DynamicResource AppFontFamily}" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center" />

                    <!-- Browser Navigation Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                        <Button x:Name="BackButton" 
                                Content="&#xE72B;" 
                                Click="BackButton_Click" 
                                Style="{StaticResource HeaderButtonStyle}" 
                                ToolTip="Atrás" />
                        <Button x:Name="ForwardButton" 
                                Content="&#xE72A;" 
                                Click="ForwardButton_Click" 
                                Style="{StaticResource HeaderButtonStyle}" 
                                ToolTip="Adelante" />
                        <Button x:Name="RefreshButton" 
                                Content="&#xE72C;" 
                                Click="RefreshButton_Click" 
                                Style="{StaticResource HeaderButtonStyle}" 
                                ToolTip="Recargar" />
                    </StackPanel>
                </StackPanel>

                <!-- Window actions (Pin and Close) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pin Button (Toggles keeping window open) -->
                    <Button x:Name="PinButton" 
                            Content="&#xE718;" 
                            Click="PinButton_Click" 
                            Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Mantener visible (Anclar)" 
                            Margin="0,0,4,0" />
                    
                    <!-- Close Button -->
                    <Button x:Name="CloseButton" 
                            Content="&#xE711;" 
                            Click="CloseButton_Click" 
                            Style="{StaticResource HeaderAccentButtonStyle}" 
                            ToolTip="Ocultar reproductor (sigue sonando)" />
                </StackPanel>
            </Grid>

            <!-- WebView2 Browser Control Panel -->
            <Border Grid.Row="1" CornerRadius="12" ClipToBounds="True" Background="#FF121212">
                <wv2:WebView2 x:Name="webView" />
            </Border>
        </Grid>
    </Border>
</Window>
