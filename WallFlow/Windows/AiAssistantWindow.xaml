<Window x:Class="WallFlow.Windows.AiAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Style="{StaticResource WallFlowWindow}"
        Title="Asistente IA"
        Width="540"
        Height="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        FontFamily="{DynamicResource AppFontFamily}">

    <Window.Resources>
        <!-- Style for Header Navigation Buttons -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A0FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="16" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#20FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Styled Pin/Close Buttons -->
        <Style x:Key="HeaderAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="16" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for AI Provider Tab Buttons -->
        <Style x:Key="AiTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#90FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#18FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Translucent Dark Border matching Wall-Flow Theme -->
    <Border x:Name="RootBorder" Style="{StaticResource FrostedFlyoutBorder}">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- WebView2 Content -->
            </Grid.RowDefinitions>

            <!-- Header Controls -->
            <Grid Grid.Row="0" Margin="4,2,4,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & AI Selection Tabs -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- AI Icon (Lucide Sparkles) -->
                    <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="2,0,8,0">
                        <Path Data="M12 3L10.088 8.813A2 2 0 0 1 8.813 10.088L3 12L8.813 13.912A2 2 0 0 1 10.088 15.187L12 21L13.912 15.187A2 2 0 0 1 15.187 13.912L21 12L15.187 10.088A2 2 0 0 1 13.912 8.813L12 3Z"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Viewbox>

                    <!-- AI Selector Pills Container -->
                    <Border Background="#15FFFFFF" CornerRadius="14" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabChatGpt"
                                    Content="ChatGPT"
                                    Style="{StaticResource AiTabButtonStyle}"
                                    Click="TabChatGpt_Click" />
                            <Button x:Name="TabGemini"
                                    Content="Gemini"
                                    Style="{StaticResource AiTabButtonStyle}"
                                    Click="TabGemini_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Browser Navigation Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                        <Button x:Name="BackButton" Click="BackButton_Click" Style="{StaticResource HeaderButtonStyle}" ToolTip="Atrás">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M19 12H5 M12 19l-7-7 7-7" Stroke="#D0FFFFFF" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="ForwardButton" Click="ForwardButton_Click" Style="{StaticResource HeaderButtonStyle}" ToolTip="Adelante">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M5 12h14 M12 5l7 7-7 7" Stroke="#D0FFFFFF" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="RefreshButton" Click="RefreshButton_Click" Style="{StaticResource HeaderButtonStyle}" ToolTip="Recargar">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8 M3 3v5h5 M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16 M21 21v-5h-5" Stroke="#D0FFFFFF" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Window actions (Pin and Close) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pin Button -->
                    <Button x:Name="PinButton" Click="PinButton_Click" Style="{StaticResource HeaderButtonStyle}" ToolTip="Mantener visible (Anclar)" Margin="0,0,4,0">
                        <Viewbox Width="14" Height="14">
                            <Path x:Name="PinIconPath" Data="M12 17v5 M9 2h6 M12 2v7 M5 9h14 M7 9l1 8h8l1-8" Stroke="#D0FFFFFF" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>

                    <!-- Close Button -->
                    <Button x:Name="CloseButton" Click="CloseButton_Click" Style="{StaticResource HeaderAccentButtonStyle}" ToolTip="Ocultar asistente">
                        <Viewbox Width="14" Height="14">
                            <Path Data="M18 6L6 18 M6 6l12 12" Stroke="#FFFFFFFF" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- WebView2 Browser Control Panel -->
            <Border Grid.Row="1" CornerRadius="12" ClipToBounds="True" Background="#FF121212">
                <wv2:WebView2 x:Name="webView" />
            </Border>
        </Grid>
    </Border>
</Window>
