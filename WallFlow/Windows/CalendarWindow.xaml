<Window x:Class="WallFlow.Windows.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WallFlowWindow}"
        Title="Calendar"
        Width="410"
        Height="310"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

    <Border x:Name="RootBorder" Style="{StaticResource FrostedFlyoutBorder}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left Date Display Pane -->
            <Border Grid.Column="0" 
                    Background="#0DFFFFFF" 
                    BorderBrush="#1AFFFFFF" 
                    BorderThickness="0,0,1,0" 
                    CornerRadius="8,0,0,8">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <!-- Day Name (e.g. VIERNES) -->
                        <TextBlock x:Name="TodayDayNameText"
                                   Text="VIERNES"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />

                        <!-- Month Name (e.g. JULIO) -->
                        <TextBlock x:Name="TodayMonthText"
                                   Text="JULIO"
                                   Foreground="#A0FFFFFF"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,4" />

                        <!-- Day Number (Large 03) -->
                        <TextBlock x:Name="TodayDayNumberText"
                                   Text="03"
                                   Foreground="White"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontSize="56"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column 1: Right Calendar Grid -->
            <Grid Grid.Column="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Month/Year Header & Nav -->
                    <RowDefinition Height="Auto" /> <!-- Week Days Header -->
                    <RowDefinition Height="*" />    <!-- Days Grid -->
                </Grid.RowDefinitions>

                <!-- Row 0: Month/Year Header & Navigation -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Button x:Name="PrevButton" Content="&#xE760;"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="#A0FFFFFF"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Width="24" Height="24"
                            Click="PrevButton_Click"
                            Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock x:Name="MonthYearText"
                               Text="JULIO 2026"
                               Foreground="White"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <Button x:Name="NextButton" Content="&#xE761;"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="#A0FFFFFF"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Width="24" Height="24"
                            Click="NextButton_Click"
                            Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Row 1: Weekdays Headers (L, M, M, J, V, S, D) -->
                <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,8">
                    <TextBlock Text="L" Foreground="#60FFFFFF" FontFamily="{DynamicResource AppFontFamily}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="M" Foreground="#60FFFFFF" FontFamily="{DynamicResource AppFontFamily}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="M" Foreground="#60FFFFFF" FontFamily="{DynamicResource AppFontFamily}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="J" Foreground="#60FFFFFF" FontFamily="{DynamicResource AppFontFamily}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="V" Foreground="#60FFFFFF" FontFamily="{DynamicResource AppFontFamily}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="S" Foreground="#60FFFFFF" FontFamily="{DynamicResource AppFontFamily}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="D" Foreground="#60FFFFFF" FontFamily="{DynamicResource AppFontFamily}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                </UniformGrid>

                <!-- Row 2: Days Grid -->
                <UniformGrid x:Name="DaysGrid" Grid.Row="2" Columns="7" Rows="6" />
            </Grid>
        </Grid>
    </Border>
</Window>
