                                            <ComboBoxItem Content="Ninguno" />
                                            <ComboBoxItem Content="Lluvia" />
                                            <ComboBoxItem Content="Nieve" />
                                            <ComboBoxItem Content="Niebla" />
                                            <ComboBoxItem Content="Luciérnagas" />
                                            <ComboBoxItem Content="Tormenta Eléctrica" />
                                            <ComboBoxItem Content="Estrellas Fugaces" />
                                            <ComboBoxItem Content="Aurora Boreal" />
                                            <ComboBoxItem Content="Pétalos de Sakura" />
                                            <ComboBoxItem Content="Hojas de Otoño" />
                                            <ComboBoxItem Content="Partículas de Energía" />
                                        </ComboBox>

                                        <Grid Margin="0,4,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Velocidad del efecto:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EffectSpeedValueText" Text="1.0x" Foreground="White" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="EffectSpeedSlider" Minimum="0.2" Maximum="3.0" Value="1.0" IsSnapToTickEnabled="True" TickFrequency="0.1" ValueChanged="EffectSpeedSlider_ValueChanged" Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,4,0,0" />
                                        </Grid>

                                        <Grid Margin="0,4,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tamaño de partículas:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EffectSizeValueText" Text="1.0x" Foreground="White" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="EffectSizeSlider" Minimum="0.5" Maximum="2.5" Value="1.0" IsSnapToTickEnabled="True" TickFrequency="0.1" ValueChanged="EffectSizeSlider_ValueChanged" Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,4,0,0" />
                                        </Grid>

                                        <Grid Margin="0,4,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Densidad de partículas:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EffectDensityValueText" Text="100%" Foreground="White" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="EffectDensitySlider" Minimum="20" Maximum="300" Value="100" IsSnapToTickEnabled="True" TickFrequency="10" ValueChanged="EffectDensitySlider_ValueChanged" Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,4,0,0" />
                                        </Grid>

                                        <CheckBox x:Name="MouseInteractionCheck" Content="Interacción con el puntero del ratón" Margin="0,4,0,4" Checked="MouseInteractionCheck_Changed" Unchecked="MouseInteractionCheck_Changed" />
                                    </StackPanel>
                                </Border>

                                <!-- Colores Personalizados de Efectos -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel x:Name="EffectColorsSectionPanel">
                                        <TextBlock Text="Colores de Efectos Personalizados" FontFamily="{DynamicResource AppFontFamily}" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Define tonos a medida para cada efecto en vivo." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                                        <StackPanel x:Name="ColorPanel_Rain" Visibility="Collapsed" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Gotas:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Rain_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Rain_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Destello:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Rain2_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Rain2_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="ColorPanel_Snow" Visibility="Collapsed" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Copos:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Snow_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Snow_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Brillo:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Snow2_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Snow2_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="ColorPanel_Fog" Visibility="Collapsed" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Nubes:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Fog_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Fog_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Bruma:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Fog2_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Fog2_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="ColorPanel_Fireflies" Visibility="Collapsed" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Núcleo:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Fireflies_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Fireflies_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Resplandor:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Fireflies2_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Fireflies2_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="ColorPanel_Thunderstorm" Visibility="Collapsed" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Rayo:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Thunderstorm_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Thunderstorm_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Relámpago:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Thunderstorm2_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Thunderstorm2_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="ColorPanel_Stars" Visibility="Collapsed" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Estrella:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Stars_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Stars_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Estela:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Stars2_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Stars2_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="ColorPanel_Aurora" Visibility="Collapsed" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Verde Aurora:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Aurora_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Aurora_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Violeta Aurora:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Aurora2_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Aurora2_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="ColorPanel_Sakura" Visibility="Collapsed" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Pétalo Principal:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Sakura_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Sakura_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Pétalo Sombra:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Sakura2_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Sakura2_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="ColorPanel_Leaves" Visibility="Collapsed" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Hoja Dorada:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Leaves_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Leaves_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Hoja Roja:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Leaves2_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Leaves2_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="ColorPanel_Energy" Visibility="Collapsed" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Plasma:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Energy_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Energy_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Aura:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" /><TextBox x:Name="EffectColor_Energy2_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" Width="120" Height="28" HorizontalAlignment="Right" /><Border x:Name="EffectColor_Energy2_Preview" Grid.Column="2" Width="24" Height="24" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6,0,0,0" /></Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                    </TabItem>
                </TabControl>
                </ScrollViewer>
            </Grid>

            <!-- ═══════ Footer: action buttons ═══════ -->
            <Border Grid.Row="4" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" x:Name="ResetBtn" CornerRadius="6"
                            Background="#1AFFFFFF" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" Padding="14,7" Cursor="Hand"
                            MouseLeftButtonUp="Reset_Click"
                            MouseEnter="ResetBtn_MouseEnter" MouseLeave="ResetBtn_MouseLeave">
                        <TextBlock Text="Restablecer" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <Border Grid.Column="3" x:Name="SaveBtn" CornerRadius="6"
                            Padding="20,7" Cursor="Hand"
                            MouseLeftButtonUp="Save_Click"
                            MouseEnter="SaveBtn_MouseEnter" MouseLeave="SaveBtn_MouseLeave"
                            Background="#AF52DE">
                        <TextBlock Text="Guardar" FontSize="13" FontWeight="SemiBold"
                                   Foreground="White" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
