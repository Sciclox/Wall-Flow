                                            <TextBlock Text="Color Hex:" Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="AccentHexBox" Grid.Column="1"
                                                     MaxLength="9" TextChanged="AccentColor_Changed" />
                                            <Border x:Name="AccentPreview" Grid.Column="2"
                                                    Width="26" Height="26" CornerRadius="5"
                                                    Background="#AF52DE"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    Margin="8,0,0,0" />
                                        </Grid>

                                        <CheckBox x:Name="UseDefaultDockBgCheck"
                                                  Content="Usar fondo predeterminado del dock"
                                                  Checked="UseDefaultDockBg_Changed"
                                                  Unchecked="UseDefaultDockBg_Changed"
                                                  Margin="0,10,0,4" />

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Fondo Dock Hex:" Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="DockBgHexBox" Grid.Column="1"
                                                     MaxLength="9" TextChanged="DockBgColor_Changed" />
                                            <Border x:Name="DockBgPreview" Grid.Column="2"
                                                    Width="26" Height="26" CornerRadius="5"
                                                    Background="#B40B0B0B"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Temas de color -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Temas de Color Rápidos"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Selecciona un preset para cambiar colores de acento, borde y dock al instante."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                                        <WrapPanel>
                                            <Button Content="Cyberpunk" Click="ThemePreset_Click" Tag="cyberpunk" Style="{StaticResource ThemeButtonStyle}" />
                                            <Button Content="Dracula" Click="ThemePreset_Click" Tag="dracula" Style="{StaticResource ThemeButtonStyle}" />
                                            <Button Content="Tokyo Night" Click="ThemePreset_Click" Tag="tokyo_night" Style="{StaticResource ThemeButtonStyle}" />
                                            <Button Content="Nord Frost" Click="ThemePreset_Click" Tag="nord_frost" Style="{StaticResource ThemeButtonStyle}" />
                                            <Button Content="Rose Pine" Click="ThemePreset_Click" Tag="rose_pine" Style="{StaticResource ThemeButtonStyle}" />
                                            <Button Content="Vaporwave" Click="ThemePreset_Click" Tag="vaporwave" Style="{StaticResource ThemeButtonStyle}" />
                                            <Button Content="Glass Light" Click="ThemePreset_Click" Tag="glass_light" Style="{StaticResource ThemeButtonStyle}" />
                                            <Button Content="Emerald" Click="ThemePreset_Click" Tag="emerald" Style="{StaticResource ThemeButtonStyle}" />
                                            <Button Content="Aero Sunset" Click="ThemePreset_Click" Tag="sunset" Style="{StaticResource ThemeButtonStyle}" />
                                            <Button Content="Solarized" Click="ThemePreset_Click" Tag="solarized" Style="{StaticResource ThemeButtonStyle}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Color del Borde Animado -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Color del Borde Animado"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Gradiente animado de 3 paradas para el borde del dock."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                        <CheckBox x:Name="UseWallpaperBorderCheck"
                                                   Content="Usar colores del wallpaper"
                                                   Checked="UseWallpaperBorder_Changed"
                                                   Unchecked="UseWallpaperBorder_Changed" />

                                        <TextBlock Text="Temas de gradiente rápidos:" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,8,0,0" />
                                        <WrapPanel x:Name="GradientPresetsGrid" Margin="0,4,0,4">
                                            <Border Width="68" Height="22" CornerRadius="11" Margin="2" Cursor="Hand" ToolTip="Gradiente Ocean"
                                                    MouseLeftButtonUp="GradientPreset_Click" MouseEnter="Preset_MouseEnter"
                                                    MouseLeave="Preset_MouseLeave" Tag="#007AFF,#5856D6,#AF52DE"
                                                    BorderThickness="1" BorderBrush="#30FFFFFF">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#007AFF" Offset="0" />
                                                        <GradientStop Color="#5856D6" Offset="0.5" />
                                                        <GradientStop Color="#AF52DE" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="Ocean" Foreground="White" FontSize="9" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="68" Height="22" CornerRadius="11" Margin="2" Cursor="Hand" ToolTip="Gradiente Sunset"
                                                    MouseLeftButtonUp="GradientPreset_Click" MouseEnter="Preset_MouseEnter"
                                                    MouseLeave="Preset_MouseLeave" Tag="#FF6B35,#FF2D87,#D946EF"
                                                    BorderThickness="1" BorderBrush="#30FFFFFF">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FF6B35" Offset="0" />
                                                        <GradientStop Color="#FF2D87" Offset="0.5" />
                                                        <GradientStop Color="#D946EF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="Sunset" Foreground="White" FontSize="9" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="68" Height="22" CornerRadius="11" Margin="2" Cursor="Hand" ToolTip="Gradiente Aurora"
                                                    MouseLeftButtonUp="GradientPreset_Click" MouseEnter="Preset_MouseEnter"
                                                    MouseLeave="Preset_MouseLeave" Tag="#06D6A0,#118AB2,#7B2FF7"
                                                    BorderThickness="1" BorderBrush="#30FFFFFF">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#06D6A0" Offset="0" />
                                                        <GradientStop Color="#118AB2" Offset="0.5" />
                                                        <GradientStop Color="#7B2FF7" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="Aurora" Foreground="White" FontSize="9" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="68" Height="22" CornerRadius="11" Margin="2" Cursor="Hand" ToolTip="Gradiente Neon"
                                                    MouseLeftButtonUp="GradientPreset_Click" MouseEnter="Preset_MouseEnter"
                                                    MouseLeave="Preset_MouseLeave" Tag="#00F5FF,#BF00FF,#FF006E"
                                                    BorderThickness="1" BorderBrush="#30FFFFFF">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00F5FF" Offset="0" />
                                                        <GradientStop Color="#BF00FF" Offset="0.5" />
                                                        <GradientStop Color="#FF006E" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="Neon" Foreground="White" FontSize="9" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="68" Height="22" CornerRadius="11" Margin="2" Cursor="Hand" ToolTip="Gradiente Lava"
                                                    MouseLeftButtonUp="GradientPreset_Click" MouseEnter="Preset_MouseEnter"
                                                    MouseLeave="Preset_MouseLeave" Tag="#FF4500,#FF0080,#7B00FF"
                                                    BorderThickness="1" BorderBrush="#30FFFFFF">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FF4500" Offset="0" />
                                                        <GradientStop Color="#FF0080" Offset="0.5" />
                                                        <GradientStop Color="#7B00FF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="Lava" Foreground="White" FontSize="9" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="68" Height="22" CornerRadius="11" Margin="2" Cursor="Hand" ToolTip="Gradiente Pastel"
                                                    MouseLeftButtonUp="GradientPreset_Click" MouseEnter="Preset_MouseEnter"
                                                    MouseLeave="Preset_MouseLeave" Tag="#A78BFA,#F472B6,#FB923C"
                                                    BorderThickness="1" BorderBrush="#30FFFFFF">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#A78BFA" Offset="0" />
                                                        <GradientStop Color="#F472B6" Offset="0.5" />
                                                        <GradientStop Color="#FB923C" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="Pastel" Foreground="White" FontSize="9" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </WrapPanel>

                                        <StackPanel Margin="0,6,0,0">
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Inicio:" Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="12" VerticalAlignment="Center" />
                                                <TextBox x:Name="BorderHex1" Grid.Column="1"
                                                         MaxLength="9" TextChanged="BorderColor_Changed" />
                                                <Border x:Name="BorderPreview1" Grid.Column="2"
                                                        Width="22" Height="22" CornerRadius="5"
                                                        Background="#007AFF" BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" Margin="8,0,0,0" />
                                            </Grid>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Centro:" Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="12" VerticalAlignment="Center" />
                                                <TextBox x:Name="BorderHex2" Grid.Column="1"
                                                         MaxLength="9" TextChanged="BorderColor_Changed" />
                                                <Border x:Name="BorderPreview2" Grid.Column="2"
                                                        Width="22" Height="22" CornerRadius="5"
                                                        Background="#5856D6" BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" Margin="8,0,0,0" />
                                            </Grid>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Final:" Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="12" VerticalAlignment="Center" />
                                                <TextBox x:Name="BorderHex3" Grid.Column="1"
                                                         MaxLength="9" TextChanged="BorderColor_Changed" />
                                                <Border x:Name="BorderPreview3" Grid.Column="2"
                                                        Width="22" Height="22" CornerRadius="5"
                                                        Background="#AF52DE" BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" Margin="8,0,0,0" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Animated gradient preview bar -->
                                        <Border x:Name="BorderGradientPreview" Margin="0,8,0,0" Height="28" CornerRadius="6"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush x:Name="PreviewGradientBrush" StartPoint="0,0" EndPoint="1,1">
                                                    <LinearGradientBrush.RelativeTransform>
                                                        <RotateTransform x:Name="PreviewGradientRotation" Angle="0" CenterX="0.5" CenterY="0.5" />
                                                    </LinearGradientBrush.RelativeTransform>
                                                    <GradientStop Color="#007AFF" Offset="0" />
                                                    <GradientStop Color="#5856D6" Offset="0.5" />
                                                    <GradientStop Color="#AF52DE" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Efectos de Fondo de Pantalla -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Efectos de Fondo de Pantalla"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Personaliza las animaciones de partículas y su comportamiento."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                        <TextBlock Text="Efecto activo:" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" Margin="0,0,0,4" />
                                        <ComboBox x:Name="WeatherEffectCombo" Margin="0,0,0,10" Height="28"
                                                  Foreground="White" BorderBrush="#30FFFFFF"
                                                  SelectionChanged="WeatherEffectCombo_SelectionChanged">
                                            <ComboBoxItem Content="Ninguno" />
                                            <ComboBoxItem Content="Lluvia" />
                                            <ComboBoxItem Content="Nieve" />
                                            <ComboBoxItem Content="Estrellas" />
                                            <ComboBoxItem Content="Hojas de Cerezo" />
                                            <ComboBoxItem Content="Luciérnagas" />
                                            <ComboBoxItem Content="Burbujas" />
                                            <ComboBoxItem Content="Aurora Boreal" />
                                            <ComboBoxItem Content="Hojas de Otoño" />
                                            <ComboBoxItem Content="Partículas de Energía" />
                                            <ComboBoxItem Content="Tormenta Eléctrica" />
                                        </ComboBox>

                                        <!-- Speed Slider -->
                                        <Grid Margin="0,4,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Velocidad del efecto:"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EffectSpeedValueText" Text="1.0x"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="EffectSpeedSlider"
                                                    Minimum="0.2" Maximum="3.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                    Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,4,0,0"
                                                    ValueChanged="EffectSpeedSlider_ValueChanged" />
                                        </Grid>

                                        <!-- Size Slider -->
                                        <Grid Margin="0,4,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tamaño de las partículas:"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EffectSizeValueText" Text="1.0x"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="EffectSizeSlider"
                                                    Minimum="0.2" Maximum="3.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                    Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,4,0,0"
                                                    ValueChanged="EffectSizeSlider_ValueChanged" />
                                        </Grid>

                                        <!-- Density Slider -->
                                        <Grid Margin="0,4,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cantidad de partículas:"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="EffectDensityValueText" Text="100%"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="EffectDensitySlider"
                                                    Minimum="20" Maximum="200" Value="100" TickFrequency="10" IsSnapToTickEnabled="True"
                                                    Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,4,0,0"
                                                    ValueChanged="EffectDensitySlider_ValueChanged" />
                                        </Grid>

                                        <CheckBox x:Name="MouseInteractionCheck"
                                                  Content="Interactuar con el mouse (repeler/atraer)"
                                                  Margin="0,4,0,4" />

                                        <!-- Section: Colores de los Efectos -->
                                        <StackPanel x:Name="EffectColorsSectionPanel" Visibility="Collapsed" Margin="0,4,0,0">
                                            <Border Height="1" Background="#1FFFFFFF" Margin="0,8,0,12" />
                                            <TextBlock Text="Colores del Efecto Activo"
                                                       FontFamily="{DynamicResource AppFontFamily}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="White" Margin="0,0,0,2" />
                                            <TextBlock Text="Personaliza el gradiente de color del efecto de fondo actualmente seleccionado."
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />

                                            <!-- Panel Lluvia -->
                                            <StackPanel x:Name="ColorPanel_Rain" Visibility="Collapsed">
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Lluvia Color 1 Hex:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBox x:Name="EffectColor_Rain_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" />
                                                    <Border x:Name="EffectColor_Rain_Preview" Grid.Column="2" Width="26" Height="26" CornerRadius="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0" />
                                                </Grid>
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Lluvia Color 2 Hex:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBox x:Name="EffectColor_Rain2_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" />
                                                    <Border x:Name="EffectColor_Rain2_Preview" Grid.Column="2" Width="26" Height="26" CornerRadius="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- Panel Nieve -->
                                            <StackPanel x:Name="ColorPanel_Snow" Visibility="Collapsed">
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Nieve Color 1 Hex:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBox x:Name="EffectColor_Snow_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" />
                                                    <Border x:Name="EffectColor_Snow_Preview" Grid.Column="2" Width="26" Height="26" CornerRadius="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0" />
                                                </Grid>
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Nieve Color 2 Hex:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBox x:Name="EffectColor_Snow2_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" />
                                                    <Border x:Name="EffectColor_Snow2_Preview" Grid.Column="2" Width="26" Height="26" CornerRadius="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- Panel Burbujas -->
                                            <StackPanel x:Name="ColorPanel_Fog" Visibility="Collapsed">
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Burbujas Color 1 Hex:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBox x:Name="EffectColor_Fog_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" />
                                                    <Border x:Name="EffectColor_Fog_Preview" Grid.Column="2" Width="26" Height="26" CornerRadius="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0" />
                                                </Grid>
                                                <Grid Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Burbujas Color 2 Hex:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBox x:Name="EffectColor_Fog2_Hex" Grid.Column="1" MaxLength="9" TextChanged="EffectColor_TextChanged" />
                                                    <Border x:Name="EffectColor_Fog2_Preview" Grid.Column="2" Width="26" Height="26" CornerRadius="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- Panel Luciérnagas -->
                                            <StackPanel x:Name="ColorPanel_Fireflies" Visibility="Collapsed">
