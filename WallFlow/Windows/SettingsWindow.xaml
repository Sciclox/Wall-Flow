<Window x:Class="WallFlow.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        Width="800" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        Opacity="1"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Color x:Key="Surface">#2C2C2E</Color>
        <Color x:Key="Border">#3A3A3C</Color>
        <Color x:Key="TextSecondary">#CCCCCC</Color>
        <Color x:Key="TextMuted">#888888</Color>

        <SolidColorBrush x:Key="SurfaceBrush" Color="#502C2C2E" />
        <SolidColorBrush x:Key="BorderBrush" Color="#1EFFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />

        <!-- Storyboard to rotate the preview gradient -->
        <Storyboard x:Key="RotateGradientPreview" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PreviewGradientRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:6" />
        </Storyboard>

        <!-- Custom Dark TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="#80AF52DE" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" Margin="4,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#AF52DE"/>
                                <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reusable Action Button Style -->
        <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#30FFFFFF" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#50FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="checkBoxBorder"
                                    Background="#15FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="16" Height="16" Margin="0,0,8,0">
                                <Grid x:Name="markGrid">
                                    <TextBlock x:Name="optionMark"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1" x:Name="contentPresenter"
                                              Focusable="False"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#AF52DE"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#AF52DE"/>
                                <Setter TargetName="optionMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="templateRoot" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition MinWidth="0" SharedSizeGroup="ComboBoxButton" Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="toggleButton" Grid.ColumnSpan="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="false" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="toggleRoot"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" SnapsToDevicePixels="true">
                                            <Border x:Name="splitBorder" BorderBrush="Transparent"
                                                    BorderThickness="1" HorizontalAlignment="Right"
                                                    Margin="0" SnapsToDevicePixels="true" Width="0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              IsHitTestVisible="false" Margin="{TemplateBinding Padding}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <Grid Grid.Column="1" SnapsToDevicePixels="True" Margin="0,0,10,0">
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2"
                                   Placement="Bottom" Margin="1"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border x:Name="dropDownBorder" Background="#2C2C2E"
                                        BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="6"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}">
                                    <ScrollViewer x:Name="TemplatesScrollViewer" SnapsToDevicePixels="true">
                                        <Grid RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0"/>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2C2C2E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#AF52DE" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#AF52DE" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom TabControl Style with Hidden Headers -->
        <Style x:Key="HiddenHeadersTabControl" TargetType="TabControl">
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme Preset Button Style -->
        <Style x:Key="ThemeButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="78" />
        </Style>

        <!-- Hotkey Label Style -->
        <Style x:Key="HotkeyLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!-- Hotkey TextBox Style -->
        <Style x:Key="HotkeyTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="130" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" Margin="6,4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#AF52DE"/>
                                <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hotkey Action Button Style -->
        <Style x:Key="HotkeyActionBtnStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="30" />
        </Style>

        <!-- Hotkey Clear Button Style -->
        <Style x:Key="HotkeysClearBtnStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Background" Value="#AF52DE" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="8" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#95202022" Offset="0.0" />
                <GradientStop Color="#650F0F11" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#38FFFFFF" Offset="0.0" />
                <GradientStop Color="#12FFFFFF" Offset="1.0" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

            <!-- ═══════ Top bar ═══════ -->
            <Border Grid.Row="0" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ajustes de Interfaz"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Border Grid.Column="1" x:Name="CloseBtn" Width="30" Height="30" CornerRadius="6"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            MouseLeftButtonUp="CloseBtn_Click"
                            MouseEnter="CloseBtn_MouseEnter"
                            MouseLeave="CloseBtn_MouseLeave">
                        <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="11" Foreground="#CCFFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════ Scrollable content area ═══════ -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar -->
                <Border Grid.Column="0" CornerRadius="8" Background="#401A1A1C"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                    <StackPanel Margin="4,8">
                        <Button x:Name="TabBtn0" Style="{StaticResource SidebarNavButtonStyle}"
                                Click="TabBtn_Click" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Global" FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtn1" Style="{StaticResource SidebarNavButtonStyle}"
                                Click="TabBtn_Click" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                <TextBlock Text="&#xE9A1;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Dock" FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtn2" Style="{StaticResource SidebarNavButtonStyle}"
                                Click="TabBtn_Click" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                <TextBlock Text="&#xE752;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Spotlight" FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtn3" Style="{StaticResource SidebarNavButtonStyle}"
                                Click="TabBtn_Click" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Wallpaper Local" FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtn4" Style="{StaticResource SidebarNavButtonStyle}"
                                Click="TabBtn_Click" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Online &amp; Efectos" FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right TabControl -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <TabControl x:Name="SettingsTabControl"
                                Style="{StaticResource HiddenHeadersTabControl}">

                    <!-- ═══ TabItem 0: Global (WallFlow) ═══ -->
                    <TabItem>
                            <StackPanel Margin="0,0,4,0">
                                <!-- Section: Componentes y Módulos del Sistema -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Componentes y Módulos del Sistema"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Activa o desactiva las funciones principales de WallFlow según tus preferencias."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />

                                        <!-- Dock de WallFlow -->
                                        <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Dock de WallFlow (Barra de tareas)" Foreground="White" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Muestra la barra interactiva de aplicaciones fijadas, widgets y estado en pantalla." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" x:Name="EnableDockCheck" VerticalAlignment="Center" Checked="EnableDockCheck_Changed" Unchecked="EnableDockCheck_Changed" />
                                            </Grid>
                                        </Border>

                                        <!-- Buscador Spotlight -->
                                        <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Buscador Spotlight" Foreground="White" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Buscador rápido estilo macOS para abrir apps, archivos y portapapeles (Atajo: Alt+Espacio)." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" x:Name="EnableSpotlightCheck" VerticalAlignment="Center" Checked="EnableSpotlightCheck_Changed" Unchecked="EnableSpotlightCheck_Changed" />
                                            </Grid>
                                        </Border>

                                        <!-- Barra de tareas de Windows -->
                                        <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Barra de tareas de Windows" Foreground="White" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Oculta la barra de tareas predeterminada de Windows para una experiencia inmersiva." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" x:Name="HideWindowsTaskbarGlobalCheck" VerticalAlignment="Center" Checked="HideWindowsTaskbarGlobalCheck_Changed" Unchecked="HideWindowsTaskbarGlobalCheck_Changed" />
                                            </Grid>
                                        </Border>

                                        <!-- Efectos Dinámicos de Wallpaper -->
                                        <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Efectos Dinámicos de Wallpaper" Foreground="White" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Efectos climáticos animados sobre el fondo de pantalla (Lluvia, Nieve, etc.)." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" x:Name="EnableWallpaperEffectsGlobalCheck" VerticalAlignment="Center" Checked="EnableWallpaperEffectsGlobalCheck_Changed" Unchecked="EnableWallpaperEffectsGlobalCheck_Changed" />
                                            </Grid>
                                        </Border>

                                        <!-- Cambio Automático de Fondos -->
                                        <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Rotación Automática de Wallpapers" Foreground="White" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Cambia el fondo de pantalla periódicamente entre tus imágenes locales." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" x:Name="EnableAutoChangeGlobalCheck" VerticalAlignment="Center" Checked="EnableAutoChangeGlobalCheck_Changed" Unchecked="EnableAutoChangeGlobalCheck_Changed" />
                                            </Grid>
                                        </Border>

                                        <!-- Efectos de Sonido -->
                                        <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Efectos de Sonido" Foreground="White" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Reproduce sonidos táctiles al interactuar con las ventanas y botones." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" x:Name="EnableSoundsGlobalCheck" VerticalAlignment="Center" Checked="EnableSoundsGlobalCheck_Changed" Unchecked="EnableSoundsGlobalCheck_Changed" />
                                            </Grid>
                                        </Border>

                                        <!-- Centro de Portapapeles -->
                                        <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Centro de Portapapeles" Foreground="White" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="Guarda historial de elementos copiados y permite buscarlos rápidamente (Atajo: Alt+C)." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" x:Name="EnableClipboardGlobalCheck" VerticalAlignment="Center" Checked="EnableClipboardGlobalCheck_Changed" Unchecked="EnableClipboardGlobalCheck_Changed" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Sistema e Inicio -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Configuración Global de WallFlow"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Ajustes principales del sistema, inicio de Windows y rendimiento."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                                        <CheckBox x:Name="StartWithWindowsCheck"
                                                  Content="Iniciar WallFlow con Windows"
                                                  Margin="0,0,0,4" />
                                    </StackPanel>
                                </Border>

                                <!-- Section: Sistema de Audio y Sonido -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Sistema de Audio y Sonido"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Efectos de sonido al interactuar con el dock y ventanas."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                                        <CheckBox x:Name="SoundEnabledCheck"
                                                  Content="Efectos de sonido activados"
                                                  Margin="0,0,0,8"
                                                  Checked="SoundEnabledCheck_Changed"
                                                  Unchecked="SoundEnabledCheck_Changed" />

                                        <StackPanel x:Name="SoundOptionsPanel">
                                            <Grid Margin="0,4,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="50" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Volumen de efectos:"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SoundVolumeText" Text="80%"
                                                           Foreground="White" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="SoundVolumeSlider"
                                                        Minimum="0" Maximum="100" Value="80" IsSnapToTickEnabled="True" TickFrequency="5"
                                                        ValueChanged="SoundVolumeSlider_ValueChanged"
                                                        Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,4,0,0" />
                                            </Grid>

                                            <TextBlock Text="Perfil de sonido:" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" Margin="0,0,0,4" />
                                            <ComboBox x:Name="SoundProfileCombo" Height="28" FontSize="12"
                                                      Background="#15FFFFFF" Foreground="White" BorderBrush="#25FFFFFF"
                                                      SelectionChanged="SoundProfileCombo_SelectionChanged">
                                                <ComboBoxItem Content="Zen (Suave / Orgánico)" Tag="Zen" />
                                                <ComboBoxItem Content="Cyberpunk (Sintetizado)" Tag="Cyber" />
                                                <ComboBoxItem Content="Soft (Sutil)" Tag="Soft" />
                                                <ComboBoxItem Content="Arcade (Retro)" Tag="Arcade" />
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Tipografía de la Aplicación -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Tipografía de la Aplicación"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Selecciona la fuente de la interfaz o sube archivos de fuente personalizados (.ttf / .otf)."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                        <ComboBox x:Name="AppFontCombo" Margin="0,0,0,10" Height="28"
                                                  Background="#15FFFFFF" Foreground="White" BorderBrush="#25FFFFFF"
                                                  >
                                            <ComboBoxItem Content="Segoe UI (Sistema)" />
                                            <ComboBoxItem Content="Inter" />
                                            <ComboBoxItem Content="Roboto" />
                                            <ComboBoxItem Content="Outfit" />
                                        </ComboBox>

                                        <Button x:Name="UploadFontBtn" Style="{StaticResource SettingsActionButtonStyle}"
                                                FontSize="12" Content="Subir Fuente Personalizada"
                                                Click="UploadFontBtn_Click" />
                                    </StackPanel>
                                </Border>

                                <!-- Section: Atajos Globales del Sistema -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Atajos de Teclado Globales"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,4" />
                                        <TextBlock Text="Combinaciones de teclas para abrir funciones principales de WallFlow."
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="0,0,0,10" TextWrapping="Wrap" />

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Opciones de Energía" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="Hotkey_Power_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="0" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="Power" />
                                            <Button Grid.Row="0" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="Power" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ajustes" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="Hotkey_Settings_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="2" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="Settings" />
                                            <Button Grid.Row="2" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="Settings" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Navegador Web" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="4" Grid.Column="3" x:Name="Hotkey_WebBrowser_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="4" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="WebBrowser" />
                                            <Button Grid.Row="4" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="WebBrowser" />

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Mostrar/Ocultar Dock" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="6" Grid.Column="3" x:Name="Hotkey_ToggleDock_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="6" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="ToggleDock" />
                                            <Button Grid.Row="6" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="ToggleDock" />

                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Centro de Portapapeles" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="8" Grid.Column="3" x:Name="Hotkey_Clipboard_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="8" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="Clipboard" />
                                            <Button Grid.Row="8" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="Clipboard" />

                                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Reproductor YouTube" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="10" Grid.Column="3" x:Name="Hotkey_YouTube_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="10" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="YouTube" />
                                            <Button Grid.Row="10" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="YouTube" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                    </TabItem>

                    <!-- ═══ TabItem 1: Dock ═══ -->
                    <TabItem>
                            <StackPanel Margin="0,0,4,0">
                                <!-- Section: Estado del Dock -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Habilitar Dock de WallFlow"
                                                           FontFamily="{DynamicResource AppFontFamily}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="White" Margin="0,0,0,2" />
                                                <TextBlock Text="Activa o desactiva la barra interactiva de WallFlow en la pantalla."
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" x:Name="EnableDockInTabCheck" VerticalAlignment="Center" Checked="EnableDockInTabCheck_Changed" Unchecked="EnableDockInTabCheck_Changed" />
                                        </Grid>
                                        <Border x:Name="DockDisabledWarningBorder" Background="#25FF453A" BorderBrush="#50FF453A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" Visibility="Collapsed">
                                            <TextBlock Text="⚠️ El Dock se encuentra actualmente desactivado. Actívalo para ver y usar la barra en pantalla." FontSize="11.5" Foreground="#FF9999" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="DockSettingsContainer">
                                <!-- Section: Posición y Pantalla -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Posición y Pantalla"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Configura la pantalla y la posición del Dock en el escritorio."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                                        <TextBlock Text="Monitor principal de despliegue:" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" Margin="0,0,0,4" />
                                        <ComboBox x:Name="MonitorCombo" Margin="0,0,0,10" Height="28"
                                                  Background="#15FFFFFF" Foreground="White" BorderBrush="#25FFFFFF"
                                                   />

                                        <TextBlock Text="Posición en pantalla:" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" Margin="0,0,0,4" />
                                        <ComboBox x:Name="DockPositionCombo" Margin="0,0,0,4" Height="28"
                                                  Background="#15FFFFFF" Foreground="White" BorderBrush="#25FFFFFF"
                                                  >
                                            <ComboBoxItem Content="Abajo (Predeterminado)" Tag="Bottom" />
                                            <ComboBoxItem Content="Arriba" Tag="Top" />
                                            <ComboBoxItem Content="Izquierda" Tag="Left" />
                                            <ComboBoxItem Content="Derecha" Tag="Right" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Dimensiones y Bordes -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Dimensiones y Bordes"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Ajusta el tamaño de íconos y el grosor del borde del Dock."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Alto del Dock:"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DockHeightValueText" Text="56 px"
                                                       Foreground="White" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="DockHeightSlider"
                                                    Minimum="40" Maximum="80" Value="56" IsSnapToTickEnabled="True" TickFrequency="2"
                                                    ValueChanged="DockHeightSlider_ValueChanged"
                                                    Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,4,0,0" />
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Grosor de borde:"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ThicknessValueText" Text="3.8 px"
                                                       Foreground="White" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="ThicknessSlider"
                                                    Minimum="1" Maximum="10" Value="3.8" IsSnapToTickEnabled="True" TickFrequency="0.2"
                                                    ValueChanged="ThicknessSlider_ValueChanged"
                                                    Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,4,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Motor de Ocultación Automática -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Ocultación Automática"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Permite que el Dock se oculte automáticamente al perder el foco."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                                        <CheckBox x:Name="AutoHideCheck"
                                                  Content="Ocultar Dock automáticamente"
                                                  Margin="0,0,0,8"
                                                    />

                                        <CheckBox x:Name="HideTaskbarCheck"
                                                  Content="Ocultar barra de tareas de Windows"
                                                  Margin="0,0,0,10"
                                                  Checked="HideTaskbarCheck_Changed"
                                                  Unchecked="HideTaskbarCheck_Changed" />

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Duración de animación:"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AutoHideDurationValueText" Text="200 ms"
                                                       Foreground="White" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="AutoHideDurationSlider"
                                                    Minimum="50" Maximum="500" Value="200" IsSnapToTickEnabled="True" TickFrequency="25"
                                                    ValueChanged="AutoHideDurationSlider_ValueChanged"
                                                    Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,4,0,0" />
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Retardo antes de ocultar:"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AutoHideDelayValueText" Text="0 ms"
                                                       Foreground="White" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="AutoHideDelaySlider"
                                                    Minimum="0" Maximum="2000" Value="0" IsSnapToTickEnabled="True" TickFrequency="100"
                                                    ValueChanged="AutoHideDelaySlider_ValueChanged"
                                                    Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,4,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Temas y Colores del Dock -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Temas y Colores del Dock"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Personaliza el resaltado, color de fondo y degradados del borde."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                        <!-- Temáticas Completas del Dock -->
                                        <TextBlock Text="Temáticas completas del Dock:" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,0,0,4" />
                                        <WrapPanel x:Name="ThemePresetsGrid" Margin="0,0,0,10">
                                            <Button Content="Cyberpunk" Click="ThemePreset_Click" Tag="cyberpunk" Style="{StaticResource ThemeButtonStyle}" ToolTip="Acento Neón Rosa, Degradado Neón/Cian, Fondo Oscuro" />
                                            <Button Content="Dracula" Click="ThemePreset_Click" Tag="dracula" Style="{StaticResource ThemeButtonStyle}" ToolTip="Acento Púrpura, Degradado Rosa/Cian, Fondo Vampiro" />
                                            <Button Content="Tokyo Night" Click="ThemePreset_Click" Tag="tokyo_night" Style="{StaticResource ThemeButtonStyle}" ToolTip="Acento Azul Noche, Degradado Púrpura/Cian" />
                                            <Button Content="Nord Frost" Click="ThemePreset_Click" Tag="nord_frost" Style="{StaticResource ThemeButtonStyle}" ToolTip="Acento Azul Ártico, Degradado Glacial" />
                                            <Button Content="Rose Pine" Click="ThemePreset_Click" Tag="rose_pine" Style="{StaticResource ThemeButtonStyle}" ToolTip="Acento Rosado Cálido, Degradado Menta/Dorado" />
                                            <Button Content="Vaporwave" Click="ThemePreset_Click" Tag="vaporwave" Style="{StaticResource ThemeButtonStyle}" ToolTip="Acento Magenta Retro, Degradado Púrpura/Cian Eléctrico" />
                                            <Button Content="Glass Light" Click="ThemePreset_Click" Tag="glass_light" Style="{StaticResource ThemeButtonStyle}" ToolTip="Acento Azul Translúcido, Degradado Blanco Cristalino" />
                                            <Button Content="Emerald" Click="ThemePreset_Click" Tag="emerald" Style="{StaticResource ThemeButtonStyle}" ToolTip="Acento Verde Esmeralda, Degradado Bosque Menta" />
                                            <Button Content="Aero Sunset" Click="ThemePreset_Click" Tag="sunset" Style="{StaticResource ThemeButtonStyle}" ToolTip="Acento Atardecer Naranja, Degradado Carmesí" />
                                            <Button Content="Solarized" Click="ThemePreset_Click" Tag="solarized" Style="{StaticResource ThemeButtonStyle}" ToolTip="Acento Azul Solar, Degradado Amarillo/Cian" />
