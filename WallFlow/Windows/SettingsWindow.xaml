                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Modo de Selección:" Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11" Margin="0,0,0,4" />
                                                <ComboBox x:Name="AutoModeCombo" Height="28" FontSize="12"
                                                          Background="#15FFFFFF" Foreground="White" BorderBrush="#25FFFFFF"
                                                          SelectionChanged="AutoModeCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Secuencial" />
                                                    <ComboBoxItem Content="Aleatorio" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Intervalo de Tiempo:" Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11" Margin="0,0,0,4" />
