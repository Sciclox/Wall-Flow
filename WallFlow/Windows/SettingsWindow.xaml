<Window x:Class="WallFlow.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        Width="800" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        Opacity="0"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Color x:Key="Surface">#2C2C2E</Color>
        <Color x:Key="Border">#3A3A3C</Color>
        <Color x:Key="TextSecondary">#CCCCCC</Color>
        <Color x:Key="TextMuted">#888888</Color>

        <SolidColorBrush x:Key="SurfaceBrush" Color="#502C2C2E" />
        <SolidColorBrush x:Key="BorderBrush" Color="#1EFFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />

        <!-- Storyboard to rotate the preview gradient -->
        <Storyboard x:Key="RotateGradientPreview" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PreviewGradientRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:6" />
        </Storyboard>

        <!-- Custom Dark TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="#80AF52DE" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" Margin="4,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#AF52DE"/>
                                <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reusable Action Button Style -->
        <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#30FFFFFF" />
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#50FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="checkBoxBorder"
                                    Background="#15FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="16" Height="16" Margin="0,0,8,0">
                                <Grid x:Name="markGrid">
                                    <TextBlock x:Name="optionMark"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1" x:Name="contentPresenter"
                                              Focusable="False"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#AF52DE"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#AF52DE"/>
                                <Setter TargetName="optionMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="templateRoot" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition MinWidth="0" SharedSizeGroup="ComboBoxButton" Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="toggleButton" Grid.ColumnSpan="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="false" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="toggleRoot"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" SnapsToDevicePixels="true">
                                            <Border x:Name="splitBorder" BorderBrush="Transparent"
                                                    BorderThickness="1" HorizontalAlignment="Right"
                                                    Margin="0" SnapsToDevicePixels="true" Width="0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              IsHitTestVisible="false" Margin="{TemplateBinding Padding}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <Grid Grid.Column="1" SnapsToDevicePixels="True" Margin="0,0,10,0">
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Grid.ColumnSpan="2"
                                   Placement="Bottom" Margin="1"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border x:Name="dropDownBorder" Background="#2C2C2E"
                                        BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="6"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}">
                                    <ScrollViewer x:Name="TemplatesScrollViewer" SnapsToDevicePixels="true">
                                        <Grid RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0"/>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2C2C2E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#AF52DE" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#AF52DE" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom TabControl Style with Hidden Headers -->
        <Style x:Key="HiddenHeadersTabControl" TargetType="TabControl">
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme Preset Button Style -->
        <Style x:Key="ThemeButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="78" />
        </Style>

        <!-- Hotkey Label Style -->
        <Style x:Key="HotkeyLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <!-- Hotkey TextBox Style -->
        <Style x:Key="HotkeyTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="130" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" Margin="6,4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#AF52DE"/>
                                <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hotkey Action Button Style -->
        <Style x:Key="HotkeyActionBtnStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="30" />
        </Style>

        <!-- Hotkey Clear Button Style -->
        <Style x:Key="HotkeysClearBtnStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Background" Value="#AF52DE" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="8" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#95202022" Offset="0.0" />
                <GradientStop Color="#650F0F11" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#38FFFFFF" Offset="0.0" />
                <GradientStop Color="#12FFFFFF" Offset="1.0" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

            <!-- ═══════ Top bar ═══════ -->
            <Border Grid.Row="0" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ajustes de Interfaz"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Border Grid.Column="1" x:Name="CloseBtn" Width="30" Height="30" CornerRadius="6"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            MouseLeftButtonUp="CloseBtn_Click"
                            MouseEnter="CloseBtn_MouseEnter"
                            MouseLeave="CloseBtn_MouseLeave">
                        <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="11" Foreground="#CCFFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════ Scrollable content area ═══════ -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar -->
                <Border Grid.Column="0" CornerRadius="8" Background="#401A1A1C"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                    <StackPanel Margin="4,8">
                        <Button x:Name="TabBtn0" Style="{StaticResource SidebarNavButtonStyle}"
                                Click="TabBtn_Click" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Apariencia" FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtn1" Style="{StaticResource SidebarNavButtonStyle}"
                                Click="TabBtn_Click" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                <TextBlock Text="&#xE9A1;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Dock" FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtn2" Style="{StaticResource SidebarNavButtonStyle}"
                                Click="TabBtn_Click" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                <TextBlock Text="&#xF1AD;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Elementos" FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtn3" Style="{StaticResource SidebarNavButtonStyle}"
                                Click="TabBtn_Click" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Sistema" FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtn4" Style="{StaticResource SidebarNavButtonStyle}"
                                Click="TabBtn_Click" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Atajos" FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtn5" Style="{StaticResource SidebarNavButtonStyle}"
                                Click="TabBtn_Click" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Navegador" FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TabBtn6" Style="{StaticResource SidebarNavButtonStyle}"
                                Click="TabBtn_Click" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Margin="6,0">
                                <TextBlock Text="&#xE752;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Spotlight" FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="12.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right TabControl -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <TabControl x:Name="SettingsTabControl"
                                Style="{StaticResource HiddenHeadersTabControl}">

                    <!-- ═══ TabItem 0: Apariencia ═══ -->
                    <TabItem>
                            <StackPanel Margin="0,0,4,0">
                                <!-- Section: Color de Hover y Widgets -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Color de Hover y Widgets"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Se utiliza para el resaltado de botones y fondo de widgets."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                        <CheckBox x:Name="UseWallpaperHoverCheck"
                                                   Content="Usar color del wallpaper"
                                                   Checked="UseWallpaperHover_Changed"
                                                   Unchecked="UseWallpaperHover_Changed" />

                                        <TextBlock Text="Paleta de colores rápidos:" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,8,0,0" />
                                        <WrapPanel x:Name="ColorPaletteGrid" Margin="0,4,0,4">
                                            <Border Width="20" Height="20" CornerRadius="10" Margin="2" Background="#FF453A" Cursor="Hand"
                                                    MouseLeftButtonUp="PaletteColor_Click" MouseEnter="PaletteColor_MouseEnter"
                                                    MouseLeave="PaletteColor_MouseLeave" ToolTip="Rojo" BorderThickness="1.5" BorderBrush="Transparent" />
                                            <Border Width="20" Height="20" CornerRadius="10" Margin="2" Background="#FF9F0A" Cursor="Hand"
                                                    MouseLeftButtonUp="PaletteColor_Click" MouseEnter="PaletteColor_MouseEnter"
                                                    MouseLeave="PaletteColor_MouseLeave" ToolTip="Naranja" BorderThickness="1.5" BorderBrush="Transparent" />
                                            <Border Width="20" Height="20" CornerRadius="10" Margin="2" Background="#FFD60A" Cursor="Hand"
                                                    MouseLeftButtonUp="PaletteColor_Click" MouseEnter="PaletteColor_MouseEnter"
                                                    MouseLeave="PaletteColor_MouseLeave" ToolTip="Amarillo" BorderThickness="1.5" BorderBrush="Transparent" />
                                            <Border Width="20" Height="20" CornerRadius="10" Margin="2" Background="#30D158" Cursor="Hand"
                                                    MouseLeftButtonUp="PaletteColor_Click" MouseEnter="PaletteColor_MouseEnter"
                                                    MouseLeave="PaletteColor_MouseLeave" ToolTip="Verde" BorderThickness="1.5" BorderBrush="Transparent" />
                                            <Border Width="20" Height="20" CornerRadius="10" Margin="2" Background="#64D2FF" Cursor="Hand"
                                                    MouseLeftButtonUp="PaletteColor_Click" MouseEnter="PaletteColor_MouseEnter"
                                                    MouseLeave="PaletteColor_MouseLeave" ToolTip="Celeste" BorderThickness="1.5" BorderBrush="Transparent" />
                                            <Border Width="20" Height="20" CornerRadius="10" Margin="2" Background="#0A84FF" Cursor="Hand"
                                                    MouseLeftButtonUp="PaletteColor_Click" MouseEnter="PaletteColor_MouseEnter"
                                                    MouseLeave="PaletteColor_MouseLeave" ToolTip="Azul" BorderThickness="1.5" BorderBrush="Transparent" />
                                            <Border Width="20" Height="20" CornerRadius="10" Margin="2" Background="#5E5CE6" Cursor="Hand"
                                                    MouseLeftButtonUp="PaletteColor_Click" MouseEnter="PaletteColor_MouseEnter"
                                                    MouseLeave="PaletteColor_MouseLeave" ToolTip="Índigo" BorderThickness="1.5" BorderBrush="Transparent" />
                                            <Border Width="20" Height="20" CornerRadius="10" Margin="2" Background="#D946EF" Cursor="Hand"
                                                    MouseLeftButtonUp="PaletteColor_Click" MouseEnter="PaletteColor_MouseEnter"
                                                    MouseLeave="PaletteColor_MouseLeave" ToolTip="Fucsia" BorderThickness="1.5" BorderBrush="Transparent" />
                                            <Border Width="20" Height="20" CornerRadius="10" Margin="2" Background="#E5E7EB" Cursor="Hand"
                                                    MouseLeftButtonUp="PaletteColor_Click" MouseEnter="PaletteColor_MouseEnter"
                                                    MouseLeave="PaletteColor_MouseLeave" ToolTip="Plata" BorderThickness="1.5" BorderBrush="Transparent" />
