                                        <!-- ═══ TabItem 3: Wallpaper Local ═══ -->
                    <TabItem>
                            <StackPanel Margin="0,0,4,0">
                                <!-- Rotación Automática -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Rotación Automática de Fondos"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Cambia el fondo de pantalla automáticamente en la Galería Local."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                                        <CheckBox x:Name="AutoChangeCheck"
                                                  Content="Activar rotación automática de fondos"
                                                  Margin="0,0,0,10"
                                                  Checked="AutoChangeCheck_Changed" Unchecked="AutoChangeCheck_Changed" />

                                        <Grid x:Name="AutoChangeOptionsPanel" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Modo de Selección:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                                <ComboBox x:Name="AutoModeCombo" Height="28" FontSize="12" Background="#15FFFFFF" Foreground="White" BorderBrush="#25FFFFFF" SelectionChanged="AutoModeCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Secuencial" />
                                                    <ComboBoxItem Content="Aleatorio" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="Intervalo de Tiempo:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                                <ComboBox x:Name="AutoIntervalCombo" Height="28" FontSize="12" Background="#15FFFFFF" Foreground="White" BorderBrush="#25FFFFFF" SelectionChanged="AutoIntervalCombo_SelectionChanged">
                                                    <ComboBoxItem Content="30 segundos" />
                                                    <ComboBoxItem Content="1 minuto" />
                                                    <ComboBoxItem Content="5 minutos" />
                                                    <ComboBoxItem Content="10 minutos" />
                                                    <ComboBoxItem Content="30 minutos" />
                                                    <ComboBoxItem Content="1 hora" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Atajos de Galería Local -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Atajos de Galería Local"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Combinaciones de teclas para la ventana de fondos locales."
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Abrir Galería Local:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" x:Name="Hotkey_LocalGallery_Text" Style="{StaticResource HotkeyTextBoxStyle}" Width="120" />
                                            <Button Grid.Column="3" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="LocalGallery" />
                                            <Button Grid.Column="5" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="LocalGallery" />
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Siguiente Fondo:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" x:Name="Hotkey_NextWallpaper_Text" Style="{StaticResource HotkeyTextBoxStyle}" Width="120" />
