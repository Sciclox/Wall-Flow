                                                    Background="#1AFFFFFF" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" Padding="12,5" Cursor="Hand"
                                                    MouseLeftButtonUp="DetectWeatherLocation_Click"
                                                    MouseEnter="DetectLocationBtn_MouseEnter"
                                                    MouseLeave="DetectLocationBtn_MouseLeave">
                                                <TextBlock Text="Autodetectar" FontSize="11"
                                                           Foreground="White" VerticalAlignment="Center" />
                                            </Border>
