                                                MouseEnter="OpenSettingsBtn_MouseEnter"
                                                MouseLeave="OpenSettingsBtn_MouseLeave">
                                            <TextBlock Text="Abrir Configuración de Windows" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Fuentes -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Fuentes Personalizadas"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Sube tus propios archivos de fuente (.ttf / .otf) para usarlos en la interfaz."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                        <Button x:Name="UploadFontBtn" Style="{StaticResource SettingsActionButtonStyle}"
                                                FontSize="13"
                                                Content="Subir Fuente"
                                                Click="UploadFontBtn_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                    </TabItem>

                    <!-- ═══ TabItem 4: Atajos ═══ -->
                    <TabItem>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Atajos de Teclado Globales"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="White" Margin="0,0,0,8" />
