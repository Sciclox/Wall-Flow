                                                      Content="Notificaciones" Margin="0,0,0,8" />
                                            <CheckBox x:Name="ShowIconRecycleBinCheck" Grid.Row="4" Grid.Column="0"
                                                      Content="Papelera" Margin="0,0,0,8" />
                                            <CheckBox x:Name="ShowIconShowDesktopCheck" Grid.Row="4" Grid.Column="1"
                                                      Content="Mostrar Escritorio" Margin="0,0,0,8" />
                                            <CheckBox x:Name="ShowIconPowerCheck" Grid.Row="5" Grid.Column="0"
                                                      Content="Apagar" Margin="0,0,0,8" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Ubicación para el Clima -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,6,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Ubicación para el Clima"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Escribe una ciudad o coordenadas (ej. -12.04,-77.03) para el pronóstico."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="WeatherCityBox" Height="28"
                                                     VerticalContentAlignment="Center" Margin="0,0,8,0" Padding="6,2" />
