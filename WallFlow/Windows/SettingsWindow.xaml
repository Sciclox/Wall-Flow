                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Fondo Anterior:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" x:Name="Hotkey_PrevWallpaper_Text" Style="{StaticResource HotkeyTextBoxStyle}" Width="120" />
                                            <Button Grid.Column="3" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="PrevWallpaper" />
                                            <Button Grid.Column="5" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="PrevWallpaper" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                    </TabItem>

                    <!-- ═══ TabItem 4: Online & Efectos ═══ -->
                    <TabItem>
                            <StackPanel Margin="0,0,4,0">
                                <!-- Galería Online y Atajo -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Galería Online de Wallpapers"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Descarga wallpapers en HD, 4K y ultra resolución desde scrapers online."
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                                        <Grid Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Abrir Galería Online:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" x:Name="Hotkey_OnlineGallery_Text" Style="{StaticResource HotkeyTextBoxStyle}" Width="120" />
