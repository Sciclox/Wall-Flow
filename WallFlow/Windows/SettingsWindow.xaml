                                            <Border x:Name="BorderPreview3" Grid.Column="2" Width="26" Height="26" CornerRadius="5" Background="#AF52DE" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0" />
