                                            <ComboBoxItem Content="5 aplicaciones" Tag="5" />
                                            <ComboBoxItem Content="6 aplicaciones" Tag="6" />
                                            <ComboBoxItem Content="8 aplicaciones" Tag="8" />
                                            <ComboBoxItem Content="10 aplicaciones" Tag="10" />
