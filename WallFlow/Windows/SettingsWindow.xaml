                                                    <ComboBoxItem Content="1 minuto" />
                                                    <ComboBoxItem Content="5 minutos" />
                                                    <ComboBoxItem Content="10 minutos" />
                                                    <ComboBoxItem Content="30 minutos" />
                                                    <ComboBoxItem Content="1 hora" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                    </TabItem>

                    <!-- ═══ TabItem 3: Sistema ═══ -->
                    <TabItem>
                            <StackPanel Margin="0,0,4,0">
                                <!-- Section: Navegador Predeterminado -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Navegador Web Predeterminado"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Registra WallFlow como navegador web en Windows para abrir enlaces desde la búsqueda Spotlight."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                        <TextBlock x:Name="DefaultBrowserStatusText" Text="Estado: No registrado"
                                                   FontSize="12"
                                                   Foreground="#8A8A8F" Margin="0,0,0,8" />

                                        <Border x:Name="RegisterBrowserBtn" CornerRadius="6"
                                                Background="#1AFFFFFF" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" Padding="14,7" Cursor="Hand"
                                                MouseLeftButtonUp="RegisterBrowser_Click"
                                                MouseEnter="RegisterBrowserBtn_MouseEnter"
                                                MouseLeave="RegisterBrowserBtn_MouseLeave">
                                            <TextBlock Text="Registrar como Navegador" FontSize="13" Foreground="White" />
                                        </Border>

                                        <Border x:Name="OpenSystemDefaultAppsBtn" CornerRadius="6"
                                                Background="#AF52DE" Padding="14,7" Cursor="Hand"
