                                                    <Button Grid.Column="3" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="PinnedApps_Spotlight" />
                                                    <Button Grid.Column="5" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="PinnedApps_Spotlight" />
                                                </Grid>

                                                <Grid Margin="0,0,0,0">
