                                            <Button Grid.Row="8" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="Clipboard" />

                                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Reproductor de YouTube" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="10" Grid.Column="3" x:Name="Hotkey_YouTube_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="10" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="YouTube" />
                                            <Button Grid.Row="10" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="YouTube" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Navegación -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Navegación"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Galería Local" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="Hotkey_LocalGallery_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="0" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="LocalGallery" />
                                            <Button Grid.Row="0" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="LocalGallery" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Galería Online" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="Hotkey_OnlineGallery_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="2" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="OnlineGallery" />
                                            <Button Grid.Row="2" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="OnlineGallery" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Siguiente Fondo" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="4" Grid.Column="3" x:Name="Hotkey_NextWallpaper_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="4" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="NextWallpaper" />
                                            <Button Grid.Row="4" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="NextWallpaper" />

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Fondo Anterior" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="6" Grid.Column="3" x:Name="Hotkey_PrevWallpaper_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="6" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="PrevWallpaper" />
                                            <Button Grid.Row="6" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="PrevWallpaper" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Sistema -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Sistema"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Opciones de Energía" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="Hotkey_Power_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="0" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="Power" />
                                            <Button Grid.Row="0" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="Power" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ajustes" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="Hotkey_Settings_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="2" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="Settings" />
                                            <Button Grid.Row="2" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="Settings" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Navegador Web" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="4" Grid.Column="3" x:Name="Hotkey_WebBrowser_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="4" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="WebBrowser" />
                                            <Button Grid.Row="4" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="WebBrowser" />

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Mostrar/Ocultar Dock" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="6" Grid.Column="3" x:Name="Hotkey_ToggleDock_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="6" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="ToggleDock" />
                                            <Button Grid.Row="6" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="ToggleDock" />

                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Anclar/Desanclar App en Spotlight" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="8" Grid.Column="3" x:Name="Hotkey_TogglePinApp_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="8" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="TogglePinApp" />
                                            <Button Grid.Row="8" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="TogglePinApp" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                    </TabItem>

                    <!-- ═══ TabItem 5: Navegador ═══ -->
                    <TabItem>
                        <TabItem.Header>
                            <TextBlock Text="Navegador" FontFamily="{DynamicResource AppFontFamily}" FontSize="13" />
                        </TabItem.Header>
                            <StackPanel Margin="0,0,4,0">
                                <!-- Section: Colores del Navegador -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Colores del Navegador Web"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Personaliza los colores del navegador integrado. Puedes heredar los colores del Dock o definir colores personalizados."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                        <CheckBox x:Name="BrowserUseDockColorsCheck"
                                                  Content="Heredar colores del Dock"
                                                  Checked="BrowserUseDockColors_Changed"
                                                  Unchecked="BrowserUseDockColors_Changed"
                                                  Margin="0,0,0,12" />

                                        <Grid x:Name="BrowserColorsGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Fondo Hex:" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                                             <TextBox Grid.Row="0" Grid.Column="1" x:Name="BrowserBgHexBox"
                                                      MaxLength="9" TextChanged="BrowserBgHex_Changed" Width="130" Height="30" Padding="10,4" FontSize="12" HorizontalAlignment="Right" />
                                             <Border Grid.Row="0" Grid.Column="2" x:Name="BrowserBgPreview"
                                                    Width="24" Height="24" CornerRadius="4"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0" />
                                             <Border Grid.Row="0" Grid.Column="3" Width="30" Height="30" CornerRadius="4"
                                                    Background="#AF52DE" BorderBrush="#AF52DE" BorderThickness="1"
                                                    Cursor="Hand" Tag="BrowserBgHexBox" Margin="4,0,0,0"
                                                    MouseLeftButtonUp="BrowserColorPicker_Click">
                                                <TextBlock Text="🎨" Foreground="White" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Acento Hex:" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                                             <TextBox Grid.Row="2" Grid.Column="1" x:Name="BrowserAccentHexBox"
                                                      MaxLength="9" TextChanged="BrowserAccentHex_Changed" Width="130" Height="30" Padding="10,4" FontSize="12" HorizontalAlignment="Right" />
                                             <Border Grid.Row="2" Grid.Column="2" x:Name="BrowserAccentPreview"
                                                    Width="24" Height="24" CornerRadius="4"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8,0,0,0" />
                                             <Border Grid.Row="2" Grid.Column="3" Width="30" Height="30" CornerRadius="4"
                                                    Background="#AF52DE" BorderBrush="#AF52DE" BorderThickness="1"
                                                    Cursor="Hand" Tag="BrowserAccentHexBox" Margin="4,0,0,0"
                                                    MouseLeftButtonUp="BrowserColorPicker_Click">
                                                <TextBlock Text="🎨" Foreground="White" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

