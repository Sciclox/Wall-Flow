                    </TabItem>

                    <!-- ═══ TabItem 1: Dock ═══ -->
                    <TabItem>
                            <StackPanel Margin="0,0,4,0">
                                <!-- Section: Comportamiento y Dimensiones -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Comportamiento y Dimensiones"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Ajusta el comportamiento de ocultación y grosor del dock."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                        <CheckBox x:Name="StartWithWindowsCheck"
                                                  Content="Iniciar WallFlow con Windows"
                                                  Margin="0,0,0,10" />
                                        <CheckBox x:Name="AutoHideCheck"
                                                  Content="Ocultar el dock automáticamente"
                                                  Margin="0,0,0,10" />
                                        <CheckBox x:Name="HideTaskbarCheck"
                                                  Content="Ocultar la barra de tareas de Windows"
                                                  Margin="0,0,0,10" />

                                        <TextBlock Text="Posición del dock:" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" Margin="0,0,0,4" />
                                        <ComboBox x:Name="DockPositionCombo" Margin="0,0,0,10" Height="28"
                                                  Foreground="White" BorderBrush="#30FFFFFF">
                                            <ComboBoxItem Content="Arriba" Tag="Top" />
                                            <ComboBoxItem Content="Abajo" Tag="Bottom" />
                                        </ComboBox>

                                        <TextBlock Text="Fuente de la aplicación:" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" Margin="0,0,0,4" />
                                        <ComboBox x:Name="AppFontCombo" Margin="0,0,0,10" Height="28"
                                                  Foreground="White" BorderBrush="#30FFFFFF">
                                            <ComboBoxItem Content="Outfit" />
                                            <ComboBoxItem Content="Share Tech Mono" />
                                            <ComboBoxItem Content="Orbitron" />
                                            <ComboBoxItem Content="Lobster Two" />
                                            <ComboBoxItem Content="Dancing Script" />
                                            <ComboBoxItem Content="Pacifico" />
                                            <ComboBoxItem Content="Cinzel" />
                                            <ComboBoxItem Content="Montserrat" />
                                            <ComboBoxItem Content="Playfair Display" />
                                            <ComboBoxItem Content="Comfortaa" />
                                            <ComboBoxItem Content="Caveat" />
                                            <ComboBoxItem Content="Roboto Mono" />
                                        </ComboBox>

                                        <!-- Border Thickness -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Grosor del borde animado:"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ThicknessValueText" Text="3.8 px"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="ThicknessSlider"
                                                    Minimum="1.0" Maximum="8.0" Value="3.8" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                    Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,6,0,0"
                                                    ValueChanged="ThicknessSlider_ValueChanged" />
                                        </Grid>

                                        <!-- Dock Height -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Altura del Dock (escala):"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DockHeightValueText" Text="56 px"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="DockHeightSlider"
                                                    Minimum="40" Maximum="80" Value="56" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,6,0,0"
                                                    ValueChanged="DockHeightSlider_ValueChanged" />
                                        </Grid>

                                        <!-- Monitor Selection -->
                                        <TextBlock Text="Monitor de visualización:" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" Margin="0,10,0,4" />
                                        <ComboBox x:Name="MonitorCombo" Margin="0,0,0,10" Height="28"
                                                  Foreground="White" BorderBrush="#30FFFFFF" />

                                        <!-- Auto-Hide Duration -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Duración de animación de ocultar:"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AutoHideDurationValueText" Text="200 ms"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="AutoHideDurationSlider"
                                                    Minimum="100" Maximum="1000" Value="200" TickFrequency="50" IsSnapToTickEnabled="True"
                                                    Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,6,0,0"
                                                    ValueChanged="AutoHideDurationSlider_ValueChanged" />
                                        </Grid>

                                        <!-- Auto-Hide Delay -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Retraso antes de ocultar:"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AutoHideDelayValueText" Text="0 ms"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" x:Name="AutoHideDelaySlider"
                                                    Minimum="0" Maximum="2000" Value="0" TickFrequency="100" IsSnapToTickEnabled="True"
                                                    Foreground="#AF52DE" Background="#15FFFFFF" Margin="0,6,0,0"
                                                    ValueChanged="AutoHideDelaySlider_ValueChanged" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Efectos de Sonido -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Efectos de Sonido de Interfaz"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Personaliza y activa los sonidos al interactuar con el dock y los widgets."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                        <CheckBox x:Name="SoundEnabledCheck"
                                                  Content="Activar efectos de sonido"
                                                  Checked="SoundEnabledCheck_Changed"
                                                  Unchecked="SoundEnabledCheck_Changed"
                                                  Margin="0,0,0,8" />

                                        <StackPanel x:Name="SoundOptionsPanel" Margin="0,0,0,4">
                                            <Grid Margin="0,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Volumen de Sonido:" Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11" />
                                                <TextBlock Grid.Column="1" x:Name="SoundVolumeText" Text="50%"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </Grid>
                                            <Slider x:Name="SoundVolumeSlider" Height="28"
                                                    Minimum="0" Maximum="100" Value="50" TickFrequency="5" IsSnapToTickEnabled="True"
                                                    Foreground="#AF52DE" Background="#15FFFFFF"
                                                    ValueChanged="SoundVolumeSlider_ValueChanged" />

                                            <TextBlock Text="Perfil de sonido:" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" Margin="0,8,0,4" />
                                            <ComboBox x:Name="SoundProfileCombo" Height="28"
                                                      SelectionChanged="SoundProfileCombo_SelectionChanged">
                                                <ComboBoxItem Content="Zen" Tag="Zen" />
                                                <ComboBoxItem Content="Cyberpunk" Tag="Cyberpunk" />
                                                <ComboBoxItem Content="Holographic" Tag="Holographic" />
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                    </TabItem>

                    <!-- ═══ TabItem 2: Elementos ═══ -->
                    <TabItem>
                            <StackPanel Margin="0,0,4,0">
                                <!-- Section: Elementos Visibles del Dock -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Elementos Visibles del Dock"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Selecciona qué widgets o elementos mostrar u ocultar en el dock principal."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <CheckBox x:Name="ShowClockCheck" Grid.Row="0" Grid.Column="0"
                                                      Content="Fecha y Reloj" Margin="0,0,0,8" />
                                            <CheckBox x:Name="ShowWeatherCheck" Grid.Row="0" Grid.Column="1"
                                                      Content="Widget del Clima" Margin="0,0,0,8" />
                                            <CheckBox x:Name="ShowMediaCheck" Grid.Row="1" Grid.Column="0"
                                                      Content="Reproductor de Música" Margin="0,0,0,8" />
                                            <CheckBox x:Name="ShowCpuCheck" Grid.Row="1" Grid.Column="1"
                                                      Content="Rendimiento: CPU" Margin="0,0,0,8" />
                                            <CheckBox x:Name="ShowRamCheck" Grid.Row="2" Grid.Column="0"
                                                      Content="Rendimiento: RAM" Margin="0,0,0,8" />
                                            <CheckBox x:Name="ShowNetCheck" Grid.Row="2" Grid.Column="1"
                                                      Content="Rendimiento: Red" Margin="0,0,0,8" />
                                            <CheckBox x:Name="Use24HourCheck" Grid.Row="3" Grid.Column="0"
                                                      Content="Formato de 24 horas" Margin="0,0,0,8" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Iconos del Dock -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,6,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Iconos del Dock"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Selecciona qué botones mostrar u ocultar en la barra de herramientas principal."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <CheckBox x:Name="ShowIconPinnedAppsCheck" Grid.Row="0" Grid.Column="0"
                                                      Content="Aplicaciones Fijadas" Margin="0,0,0,8" />
                                            <CheckBox x:Name="ShowIconLocalGalleryCheck" Grid.Row="0" Grid.Column="1"
                                                      Content="Galería Local" Margin="0,0,0,8" />
                                            <CheckBox x:Name="ShowIconOnlineGalleryCheck" Grid.Row="1" Grid.Column="0"
                                                      Content="Galería Online" Margin="0,0,0,8" />
                                            <CheckBox x:Name="ShowIconYouTubeMusicCheck" Grid.Row="1" Grid.Column="1"
                                                      Content="YouTube Music" Margin="0,0,0,8" />
                                            <CheckBox x:Name="ShowIconWebBrowserCheck" Grid.Row="2" Grid.Column="0"
