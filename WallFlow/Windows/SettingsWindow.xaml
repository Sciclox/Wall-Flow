                                    <StackPanel>
                                        <TextBlock Text="Configuración del Buscador Spotlight"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Personaliza el buscador de aplicaciones y archivos estilo macOS."
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />

                                        <CheckBox x:Name="SpotlightShowFavoritesCheck"
                                                  Content="Mostrar aplicaciones favoritas"
                                                  Margin="0,0,0,8" />

                                        <!-- Atajos de Teclado del Buscador -->
