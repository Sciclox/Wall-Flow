                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,12" TextWrapping="Wrap" />

                                <!-- Section: Widgets -->
                                <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Widgets"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,10" />
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Aplicaciones Fijadas" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="0" Grid.Column="3" x:Name="Hotkey_PinnedApps_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="0" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="PinnedApps" />
                                            <Button Grid.Row="0" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="PinnedApps" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Clima" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2" Grid.Column="3" x:Name="Hotkey_Weather_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="2" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="Weather" />
                                            <Button Grid.Row="2" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="Weather" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Calendario" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="4" Grid.Column="3" x:Name="Hotkey_Calendar_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="4" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="Calendar" />
                                            <Button Grid.Row="4" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="Calendar" />

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Controles Multimedia" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
                                            <TextBox Grid.Row="6" Grid.Column="3" x:Name="Hotkey_Media_Text" Style="{StaticResource HotkeyTextBoxStyle}" />
                                            <Button Grid.Row="6" Grid.Column="5" Content="Capturar" Style="{StaticResource HotkeyActionBtnStyle}" Click="CaptureHotkey_Click" Tag="Media" />
                                            <Button Grid.Row="6" Grid.Column="7" Content="&#xE10A;" Style="{StaticResource HotkeysClearBtnStyle}" Click="ClearHotkey_Click" Tag="Media" />

                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Centro de Portapapeles" Style="{StaticResource HotkeyLabelStyle}" VerticalAlignment="Center" />
