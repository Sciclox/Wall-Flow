                                            <ComboBoxItem Content="Personalizado" Tag="Personalizado" />
                                            <ComboBoxItem Content="Medianoche" Tag="Midnight" />
                                            <ComboBoxItem Content="Océano" Tag="Ocean" />
                                            <ComboBoxItem Content="Bosque" Tag="Forest" />
                                            <ComboBoxItem Content="Atardecer" Tag="Sunset" />
                                            <ComboBoxItem Content="Carmesí" Tag="Crimson" />
                                            <ComboBoxItem Content="Verde Agua" Tag="Teal" />
                                            <ComboBoxItem Content="Ámbar" Tag="Warm" />
                                            <ComboBoxItem Content="Rosa" Tag="Rose" />
                                            <ComboBoxItem Content="Pizarra" Tag="Slate" />
                                            <ComboBoxItem Content="Violeta" Tag="Violet" />
