                                    <StackPanel>
                                        <TextBlock Text="Efectos Visuales en Vivo"
                                                   FontFamily="{DynamicResource AppFontFamily}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="White" Margin="0,0,0,2" />
                                        <TextBlock Text="Añade efectos interactivos de clima y partículas sobre tus fondos."
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                                        <TextBlock Text="Efecto activo:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
