<Window x:Class="WallFlow.Windows.ClipboardSpiralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard Particle Overlay"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        WindowState="Normal"
        Loaded="Window_Loaded">
    
    <Canvas x:Name="ParticleCanvas" Background="Transparent" IsHitTestVisible="False" />
</Window>
