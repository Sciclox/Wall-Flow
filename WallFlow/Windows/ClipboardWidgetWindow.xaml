<Window x:Class="WallFlow.Windows.ClipboardWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Companion Clipboard Widget"
        Height="85"
        Width="85"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Hover Scale & Glow Storyboard -->
        <Storyboard x:Key="HoverStart">
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="HoverEnd">
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.2" />
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="Transparent" Opacity="0.75" RenderTransformOrigin="0.5,0.5" Cursor="Hand"
            MouseEnter="RootBorder_MouseEnter" MouseLeave="RootBorder_MouseLeave" ToolTip="Doble clic para expandir, arrastra para mover">
        <Border.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1.0" ScaleY="1.0" />
        </Border.RenderTransform>

        <Grid x:Name="WidgetGrid">
            <!-- Card Stack Graphic -->
            
            <!-- Card 3 (Back) -->
            <Border x:Name="BackCardBorder" Width="38" Height="52" CornerRadius="8" Background="{DynamicResource DockBackgroundBrush}" BorderBrush="#20FFFFFF" BorderThickness="1.2"
                    RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-6,-4,0,0">
                <Border.RenderTransform>
                    <RotateTransform Angle="-14" />
                </Border.RenderTransform>
            </Border>

            <!-- Card 2 (Middle) -->
            <Border x:Name="MiddleCardBorder" Width="40" Height="54" CornerRadius="8" Background="{DynamicResource DockBackgroundBrush}" BorderBrush="#35FFFFFF" BorderThickness="1.2"
                    RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,-2,0,0">
                <Border.RenderTransform>
                    <RotateTransform Angle="8" />
                </Border.RenderTransform>
            </Border>

            <!-- Card 1 (Front - glowing active card) -->
            <Border x:Name="FrontCardBorder" Width="42" Height="56" CornerRadius="8" Background="{DynamicResource DockBackgroundBrush}" BorderBrush="{DynamicResource DockBorderBrush}" BorderThickness="1.5"
                    RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                <Border.RenderTransform>
                    <RotateTransform x:Name="FrontCardRotate" Angle="-3" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect x:Name="GlowEffect" Color="{DynamicResource AccentColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.4" />
                </Border.Effect>

                <Grid>
                    <!-- Small glowing clip icon inside -->
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
