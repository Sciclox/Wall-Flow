<Application x:Class="WallFlow.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppFontFamily">pack://application:,,,/Fonts/#SF Pro Display</FontFamily>
            <FontFamily x:Key="LucideIconsFont">pack://application:,,,/Fonts/#lucide</FontFamily>

            <Color x:Key="AccentColor">#AF52DE</Color>
            <Color x:Key="AccentHoverColor">#C57BFA</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="#AF52DE" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#C57BFA" />
            <SolidColorBrush x:Key="AccentHoverTileBrush" Color="#65C57BFA" />
            <SolidColorBrush x:Key="AccentHoverBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#18AF52DE" />
            <SolidColorBrush x:Key="AccentActiveBrush" Color="#65AF52DE" />
            <SolidColorBrush x:Key="AccentGroupBrush" Color="#30AF52DE" />

            <Color x:Key="BorderColor1">#007AFF</Color>
            <Color x:Key="BorderColor2">#FB2BFF</Color>
            <Color x:Key="BorderColor3">#00F5FF</Color>
            <LinearGradientBrush x:Key="VisualizerWaveBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFD39BFF" Offset="0" />
                <GradientStop Color="#FFAF52DE" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>
