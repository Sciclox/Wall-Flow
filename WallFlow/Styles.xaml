<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="DockBackgroundBrush" Color="#B40B0B0B" />

    <Style TargetType="Window" x:Key="WallFlowWindow">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    </Style>

    <!-- ==================== TOOLTIP (Dark Theme Global) ==================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#F21E1E1E" />
        <Setter Property="Foreground" Value="#EEEEEEEE" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="BorderBrush" Value="#25FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== CONTEXT MENU (Dark Theme Global) ==================== -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#F2181818" BorderBrush="#25FFFFFF" BorderThickness="1"
                            CornerRadius="10" Padding="4,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" Color="Black" Direction="270" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#EEEEEEEE" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="14,7" Margin="2,1">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#25007AFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="#20FFFFFF" />
        <Setter Property="Margin" Value="10,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" Margin="{TemplateBinding Margin}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="FrostedFlyoutBorder">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource DockBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="#35FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.55" Color="Black" Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" x:Key="ImageTile">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <ControlTemplate x:Key="FrostedScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.Thumb>
                    <Thumb>
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="#30FFFFFF"
                                        BorderBrush="#50FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Height="4" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <DataTemplate x:Key="WallpaperItemTemplate">
        <Border CornerRadius="8" Background="Transparent" Padding="8,6" Margin="0,2">
            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="36" CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding FilePath}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" Foreground="White"
                               FontSize="14" FontWeight="Normal"
                               TextTrimming="CharacterEllipsis" MaxWidth="400" />
                    <TextBlock Text="{Binding FilePath}" Foreground="#888888"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis" MaxWidth="400" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource FrostedScrollBar}" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter CanContentScroll="False"
                                                 Margin="{TemplateBinding Padding}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Bottom"
                                   Height="8"
                                   Margin="20,0,20,4"
                                   Minimum="0"
                                   Maximum="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ScrollableWidth, Mode=OneWay}"
                                   Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=HorizontalOffset, Mode=OneWay}"
                                   ViewportSize="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ViewportWidth, Mode=OneWay}"
                                   Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ComputedHorizontalScrollBarVisibility, Mode=OneWay}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
