                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="MusicIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="MusicIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="MusicGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- Window Active State Trigger -->
                                <DataTrigger Binding="{Binding IsYouTubeMusicOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="ActiveMusicState">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="MusicIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="MusicIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="MusicGlow" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
