<Window x:Class="WallFlow.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WallFlowWindow}"
        Title="WallFlow Dock"
        Width="1920"
        Height="56"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        FontFamily="{DynamicResource AppFontFamily}">

    <Window.Resources>
        <!-- Storyboard for sound waves animation -->
        <Storyboard x:Key="SoundWavesPlaying" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="WaveBar1" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.2" To="0.9" Duration="0:0:0.48" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WaveBar2" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.2" To="0.65" Duration="0:0:0.35" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WaveBar3" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.2" To="1.0" Duration="0:0:0.55" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WaveBar4" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.2" To="0.55" Duration="0:0:0.31" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WaveBar5" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.2" To="0.85" Duration="0:0:0.51" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="WaveBar6" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.2" To="0.7" Duration="0:0:0.41" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ==================== WINDOW ICON BUTTON (macOS style: no box, pure scale) ==================== -->
        <Style x:Key="WindowIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Smooth macOS-like hover scale animation -->
            <!-- Smooth macOS-like hover scale animation with elastic bounce -->
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.22" Duration="0:0:0.35">
                                <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.22" Duration="0:0:0.35">
                                <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.30">
                                <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.30">
                                <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="PreviewMouseDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.88" Duration="0:0:0.06" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.88" Duration="0:0:0.06" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="PreviewMouseUp">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.30">
                                <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.30">
                                <DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="4" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>


        <!-- ==================== WEATHER BUTTON STYLE (No hover box, hand cursor, large) ==================== -->
        <Style x:Key="WeatherButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <!-- Animated Sun Grid -->
                            <Grid x:Name="SunGrid" Width="38" Height="38" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="SunScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                
                                <!-- Sun Glow -->
                                <Ellipse x:Name="SunGlow" Width="30" Height="30" Opacity="0.35">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="6" />
                                    </Ellipse.Effect>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FFFFD700" Offset="0" />
                                            <GradientStop Color="#00FFD700" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                
                                <!-- Expanding Heatwave Flare (Solar Flare) -->
                                <Ellipse x:Name="SunFlare" Width="20" Height="20" Stroke="#FFFFE082" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="FlareScale" ScaleX="0.8" ScaleY="0.8" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- Rotating Sun Rays (8-spoke premium vector path) -->
                                <Path x:Name="SunRays" Stroke="#FFFFA500" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 19,5 L 19,9 M 19,29 L 19,33 M 5,19 L 9,19 M 29,19 L 33,19 M 9.1,9.1 L 11.9,11.9 M 28.9,28.9 L 26.1,26.1 M 9.1,28.9 L 11.9,26.1 M 28.9,9.1 L 26.1,11.9" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SunRaysRotation" Angle="0" />
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Sun Core -->
                                <Ellipse x:Name="SunCore" Width="14" Height="14" Fill="#FFFFD700">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#FFFFA500" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>

                            <!-- Animated Moon Grid -->
                            <Grid x:Name="MoonGrid" Width="38" Height="38" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="MoonRotation" Angle="0" />
                                </Grid.RenderTransform>

                                <!-- Moon Glow -->
                                <Ellipse x:Name="MoonGlow" Width="30" Height="30" Opacity="0.25">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="8" />
                                    </Ellipse.Effect>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FFAF52DE" Offset="0" />
                                            <GradientStop Color="#00AF52DE" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Twinkling Stars next to moon -->
                                <Ellipse x:Name="Star1" Width="2.5" Height="2.5" Fill="White" Margin="24,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Ellipse x:Name="Star2" Width="2" Height="2" Fill="White" Margin="8,22,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

                                <!-- Crescent Moon Path (using Exclude CombinedGeometry) -->
                                <Path Fill="#FFECEFF1" Stroke="#FFAFB0B2" StrokeThickness="0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Data>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <EllipseGeometry Center="18,18" RadiusX="8" RadiusY="8" />
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <EllipseGeometry Center="14,14" RadiusX="8" RadiusY="8" />
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Path.Data>
                                    <Path.Effect>
                                        <DropShadowEffect Color="#FFB0BEC5" BlurRadius="4" ShadowDepth="0" Opacity="0.6" />
                                    </Path.Effect>
                                </Path>
                            </Grid>

                            <!-- Default text/glyph content presenter -->
                            <Border x:Name="DefaultPresenterBorder" Visibility="Visible">
                                <ContentPresenter x:Name="ContentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextBlock.FontFamily="Segoe MDL2 Assets" />
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Sun Content Trigger -->
                            <Trigger Property="Content" Value="&#xE706;">
                                <Setter TargetName="SunGrid" Property="Visibility" Value="Visible" />
                                <Setter TargetName="DefaultPresenterBorder" Property="Visibility" Value="Collapsed" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="SunAnimBoard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Rotate Sun Rays -->
                                            <DoubleAnimation Storyboard.TargetName="SunRaysRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:8" />
                                            <!-- Pulse Sun Core -->
                                            <DoubleAnimation Storyboard.TargetName="SunScale" Storyboard.TargetProperty="ScaleX" From="0.95" To="1.08" Duration="0:0:1.5" AutoReverse="True">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SunScale" Storyboard.TargetProperty="ScaleY" From="0.95" To="1.08" Duration="0:0:1.5" AutoReverse="True">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <!-- Expand and Fade Solar Flare -->
                                            <DoubleAnimation Storyboard.TargetName="FlareScale" Storyboard.TargetProperty="ScaleX" From="0.8" To="1.6" Duration="0:0:1.6" />
                                            <DoubleAnimation Storyboard.TargetName="FlareScale" Storyboard.TargetProperty="ScaleY" From="0.8" To="1.6" Duration="0:0:1.6" />
                                            <DoubleAnimation Storyboard.TargetName="SunFlare" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:1.6" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SunAnimBoard" />
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Moon Content Trigger -->
                            <Trigger Property="Content" Value="&#xE708;">
                                <Setter TargetName="MoonGrid" Property="Visibility" Value="Visible" />
                                <Setter TargetName="DefaultPresenterBorder" Property="Visibility" Value="Collapsed" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="MoonAnimBoard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Rock Moon Cradle -->
                                            <DoubleAnimation Storyboard.TargetName="MoonRotation" Storyboard.TargetProperty="Angle" From="-6" To="6" Duration="0:0:3" AutoReverse="True" />
                                            <!-- Twinkle Star 1 -->
                                            <DoubleAnimation Storyboard.TargetName="Star1" Storyboard.TargetProperty="Opacity" From="0.1" To="1.0" Duration="0:0:0.8" AutoReverse="True" />
                                            <!-- Twinkle Star 2 -->
                                            <DoubleAnimation Storyboard.TargetName="Star2" Storyboard.TargetProperty="Opacity" From="1.0" To="0.2" Duration="0:0:1.2" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="MoonAnimBoard" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Gentle hover scale effect, but NO background box or glow -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#EEEEEEEE" />
                </Trigger>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.15" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.15" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.1" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- GPU-Accelerated Rotation Trigger -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="BorderRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:6" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- ==================== MAIN TASKBAR (Black translucent background with GPU animated border) ==================== -->
    <Border x:Name="TaskbarBorder"
            Width="1920" Height="56"
            Background="#B40B0B0B"
            BorderThickness="3.8"
            CornerRadius="8"
            VerticalAlignment="Top" HorizontalAlignment="Stretch">
        
        <!-- Bottom border: Rotating LinearGradient -->
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <LinearGradientBrush.RelativeTransform>
                    <RotateTransform x:Name="BorderRotate" Angle="0" CenterX="0.5" CenterY="0.5" />
                </LinearGradientBrush.RelativeTransform>
                <GradientStop Color="#007AFF" Offset="0" />
                <GradientStop Color="#5856D6" Offset="0.5" />
                <GradientStop Color="#AF52DE" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid x:Name="MainGrid" Margin="16,0">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Left side (Launcher logo + spacing + open windows list) -->
                <ColumnDefinition Width="Auto" />
                <!-- Column 1: Middle (Centered Clock, Date, separator, battery, and media player) -->
                <ColumnDefinition Width="*" />
                <!-- Column 2: Right side (System Status Bar widgets) -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT: WallFlow Launcher & Open Windows List (Left aligned together) ===== -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- Pinned Apps Launcher Button (Grid icon: \uE71D) -->
                <!-- Pinned Apps Launcher Button (Custom Animated Matrix Grid) -->
                <Button x:Name="PinnedAppsButton"
                        Click="PinnedAppsButton_Click"
                        Width="42" Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Aplicaciones Fijadas">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="AppsIconGrid" Width="38" Height="38" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="AppsIconScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <!-- Holographic Glow (Back layer) -->
                                <Ellipse x:Name="AppsGlow" Width="34" Height="34" Opacity="0.3" Margin="0">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="8"/>
                                    </Ellipse.Effect>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FFFF007F" Offset="0" />
                                            <GradientStop Color="#00FF007F" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- 3x3 Matrix Grid -->
                                <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 9 Glowing Nodes -->
                                    <Border x:Name="Cell1" Grid.Row="0" Grid.Column="0" CornerRadius="1.5" Margin="1.5" Background="#FFFF007F" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="Scale1" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="Cell2" Grid.Row="0" Grid.Column="1" CornerRadius="1.5" Margin="1.5" Background="#FFAF52DE" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="Scale2" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="Cell3" Grid.Row="0" Grid.Column="2" CornerRadius="1.5" Margin="1.5" Background="#FF00F5FF" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="Scale3" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                    </Border>

                                    <Border x:Name="Cell4" Grid.Row="1" Grid.Column="0" CornerRadius="1.5" Margin="1.5" Background="#FFAF52DE" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="Scale4" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="Cell5" Grid.Row="1" Grid.Column="1" CornerRadius="1.5" Margin="1.5" Background="#FFFFFFFF" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="Scale5" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="Cell6" Grid.Row="1" Grid.Column="2" CornerRadius="1.5" Margin="1.5" Background="#FFAF52DE" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="Scale6" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                    </Border>

                                    <Border x:Name="Cell7" Grid.Row="2" Grid.Column="0" CornerRadius="1.5" Margin="1.5" Background="#FF00F5FF" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="Scale7" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="Cell8" Grid.Row="2" Grid.Column="1" CornerRadius="1.5" Margin="1.5" Background="#FFAF52DE" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="Scale8" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="Cell9" Grid.Row="2" Grid.Column="2" CornerRadius="1.5" Margin="1.5" Background="#FFFF007F" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="Scale9" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Loaded Ripple Animation Storyboard -->
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Name="RippleBoard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Cell 1 -->
                                            <DoubleAnimation Storyboard.TargetName="Scale1" Storyboard.TargetProperty="ScaleX" From="1" To="1.4" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.0" />
                                            <DoubleAnimation Storyboard.TargetName="Scale1" Storyboard.TargetProperty="ScaleY" From="1" To="1.4" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.0" />
                                            <DoubleAnimation Storyboard.TargetName="Cell1" Storyboard.TargetProperty="Opacity" From="0.6" To="1.0" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.0" />
                                            
                                            <!-- Cell 2, 4 -->
                                            <DoubleAnimation Storyboard.TargetName="Scale2" Storyboard.TargetProperty="ScaleX" From="1" To="1.4" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Scale2" Storyboard.TargetProperty="ScaleY" From="1" To="1.4" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Cell2" Storyboard.TargetProperty="Opacity" From="0.6" To="1.0" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.15" />
                                            
                                            <DoubleAnimation Storyboard.TargetName="Scale4" Storyboard.TargetProperty="ScaleX" From="1" To="1.4" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Scale4" Storyboard.TargetProperty="ScaleY" From="1" To="1.4" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Cell4" Storyboard.TargetProperty="Opacity" From="0.6" To="1.0" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.15" />

                                            <!-- Cell 3, 5, 7 -->
                                            <DoubleAnimation Storyboard.TargetName="Scale3" Storyboard.TargetProperty="ScaleX" From="1" To="1.4" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="Scale3" Storyboard.TargetProperty="ScaleY" From="1" To="1.4" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="Cell3" Storyboard.TargetProperty="Opacity" From="0.6" To="1.0" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.3" />

                                            <DoubleAnimation Storyboard.TargetName="Scale5" Storyboard.TargetProperty="ScaleX" From="1" To="1.4" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.3" />
                                            <DoubleAnimation Storyboard.TargetName="Scale5" Storyboard.TargetProperty="ScaleY" From="1" To="1.4" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.3" />
