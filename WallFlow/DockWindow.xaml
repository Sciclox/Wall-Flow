                                                <DoubleAnimation Storyboard.TargetName="AppsIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="AppsGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
