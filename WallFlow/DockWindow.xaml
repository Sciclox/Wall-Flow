                                                <DoubleAnimation Storyboard.TargetName="MusicIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="MusicIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="MusicGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Web Browser Button (Custom Animated Compass Navigator) -->
                <Button x:Name="WebBrowserButton"
                        Click="WebBrowserButton_Click"
                        Width="42" Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="4,0,0,0"
                        ToolTip="Navegador Web">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="BrowserContextMenu" Opened="BrowserContextMenu_Opened" Closed="ContextMenu_Closed"/>
                    </Button.ContextMenu>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="BrowserIconGrid" Width="38" Height="38" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="BrowserIconScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <!-- Cyber Glow (Back layer) -->
                                <Ellipse x:Name="BrowserGlow" Width="34" Height="34" Opacity="0.3" Margin="0">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="8"/>
                                    </Ellipse.Effect>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FF00F5FF" Offset="0" />
                                            <GradientStop Color="#0000F5FF" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Outer Compass Ring (Slow rotation with tick marks) -->
                                <Ellipse Width="28" Height="28" Stroke="White" StrokeThickness="1.5" StrokeDashArray="1,2.5" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="CompassRingRotation" Angle="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- Inner Circle -->
                                <Ellipse Width="20" Height="20" Stroke="#80FFFFFF" StrokeThickness="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- Cardinal Points (N, E, S, W as tiny dots) -->
                                <Ellipse x:Name="CardN" Width="3" Height="3" Fill="#FF00F5FF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#FF00F5FF" BlurRadius="3" ShadowDepth="0" Opacity="0.9" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Width="2" Height="2" Fill="White" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                <Ellipse Width="2" Height="2" Fill="White" Opacity="0.6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" />
                                <Ellipse Width="2" Height="2" Fill="White" Opacity="0.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" />

                                <!-- Compass Needle (Rotating arrow) -->
                                <Path x:Name="CompassNeedle" StrokeThickness="0" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                      Data="M 0,-9 L 2.5,0 L 0,2 L -2.5,0 Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFF4060" Offset="0" />
                                            <GradientStop Color="White" Offset="0.5" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="NeedleRotation" Angle="0" />
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Center Pivot -->
                                <Ellipse Width="4" Height="4" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#FF00F5FF" BlurRadius="4" ShadowDepth="0" Opacity="0.9" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Loaded Spin/Scale Animations -->
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Name="CompassBoard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Slow outer ring rotation -->
                                            <DoubleAnimation Storyboard.TargetName="CompassRingRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:12" />
                                            
                                            <!-- Needle seeking oscillation (swings then settles) -->
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NeedleRotation" Storyboard.TargetProperty="Angle">
                                                <EasingDoubleKeyFrame Value="0" KeyTime="0:0:0.0" />
                                                <EasingDoubleKeyFrame Value="35" KeyTime="0:0:0.6">
                                                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame Value="-25" KeyTime="0:0:1.2">
                                                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame Value="15" KeyTime="0:0:1.7">
                                                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame Value="-8" KeyTime="0:0:2.1">
                                                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame Value="0" KeyTime="0:0:2.5">
                                                    <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                                <EasingDoubleKeyFrame Value="0" KeyTime="0:0:5.0" /> <!-- Rest -->
                                            </DoubleAnimationUsingKeyFrames>

                                            <!-- North Cardinal Point Pulse -->
                                            <DoubleAnimation Storyboard.TargetName="CardN" Storyboard.TargetProperty="Opacity" From="0.5" To="1.0" Duration="0:0:1.0" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <!-- Mouse Hover Triggers -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BrowserIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="BrowserIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="BrowserGlow" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BrowserIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="BrowserIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="BrowserGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- Window Active State Trigger -->
                                <DataTrigger Binding="{Binding IsBrowserOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="ActiveBrowserState">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BrowserIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="BrowserIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="BrowserGlow" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BrowserIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="BrowserIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="BrowserGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Settings Button (Gear icon: \uE713) -->
                <!-- Settings Button (Custom Animated Intermeshing Gears) -->
                <Button x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        Width="42" Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="4,0,0,0"
                        ToolTip="Ajustes de Interfaz">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="SettingsIconGrid" Width="38" Height="38" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="SettingsIconScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <!-- Settings Glow -->
                                <Ellipse x:Name="SettingsGlow" Width="34" Height="34" Opacity="0.3" Margin="0">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="8"/>
                                    </Ellipse.Effect>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FF00F5FF" Offset="0" />
                                            <GradientStop Color="#0000F5FF" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Primary Spinning Gear -->
                                <Grid Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform x:Name="GearRotation" Angle="0" />
                                    </Grid.RenderTransform>
                                    <!-- Gear Teeth (Outer dashed ring) -->
                                    <Ellipse Width="20" Height="20" Stroke="White" StrokeThickness="3.5" StrokeDashArray="1.2,1.2" />
                                    <!-- Gear Body -->
                                    <Ellipse Width="15" Height="15" Stroke="White" StrokeThickness="2" Fill="Transparent" />
                                    <!-- Gear Center Hole -->
                                    <Ellipse Width="6" Height="6" Fill="White" />
                                </Grid>

                                <!-- Secondary Small Gear (Bottom Right) -->
                                <Grid Width="14" Height="14" Margin="14,14,0,0" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform x:Name="SmallGearRotation" Angle="0" />
                                    </Grid.RenderTransform>
                                    <!-- Small Gear Teeth -->
                                    <Ellipse Width="12" Height="12" Stroke="White" StrokeThickness="2" StrokeDashArray="1,1" Opacity="0.75" />
                                    <!-- Small Gear Center Hole -->
                                    <Ellipse Width="4" Height="4" Fill="White" Opacity="0.75" />
                                </Grid>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Loaded Gear Spin Animation -->
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Name="SettingsBoard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Main gear spins clockwise -->
                                            <DoubleAnimation Storyboard.TargetName="GearRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:6" />
                                            <!-- Small gear spins counter-clockwise (faster) -->
                                            <DoubleAnimation Storyboard.TargetName="SmallGearRotation" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:3.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <!-- Mouse Hover Triggers -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SettingsIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="SettingsIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="SettingsGlow" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SettingsIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="SettingsIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="SettingsGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- Window Active State Trigger -->
                                <DataTrigger Binding="{Binding IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="ActiveSettingsState">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SettingsIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="SettingsIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="SettingsGlow" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SettingsIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="SettingsIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="SettingsGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Separator between logo and apps -->
                <Border x:Name="LeftAppsSeparator" Width="1" Height="16" Background="#20FFFFFF" Margin="10,0" VerticalAlignment="Center" />

                <!-- open apps dock, left-aligned, original shape/color icons with permanent purple tiles -->
                <ItemsControl x:Name="WindowsList" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="1,0">
                                <!-- Window Icon Button -->
                                <Button x:Name="WindowBtn"
                                        Style="{StaticResource WindowIconButtonStyle}"
                                        Click="WindowItemButton_Click"
                                        ContextMenuOpening="WindowButton_ContextMenuOpening"
                                        Tag="{Binding Hwnd}"
                                        ToolTip="{Binding Title}">
                                    <Button.ContextMenu>
                                        <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                                            <MenuItem Header="Restaurar" Click="ContextRestore_Click" />
                                            <MenuItem Header="Minimizar" Click="ContextMinimize_Click" />
                                            <Separator />
                                            <MenuItem Header="Cerrar ventana" Click="ContextClose_Click" />
                                            <Separator />
                                            <MenuItem Header="Anclar al Dock" Click="ContextPin_Click" />
                                            <Separator />
                                            <MenuItem Header="Minimizar todas" Click="ContextMinimizeAll_Click" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    
                                    <!-- Active/Running Purple Tile wrapper -->
                                    <Border x:Name="ActiveBorder"
                                            BorderBrush="#10FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4"
                                            Background="{DynamicResource AccentGlowBrush}">
                                        
                                        <!-- Original Shape & Color App Icon -->
                                        <Image x:Name="WindowIcon"
                                               Source="{Binding Icon}"
                                               Width="24" Height="24"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </Button>
                            </Grid>

                            <DataTemplate.Triggers>
                                <!-- Active window: Show active purple border (#AF52DE) and brighter background -->
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="ActiveBorder" Property="Background" Value="{DynamicResource AccentActiveBrush}" />
                                    <Setter TargetName="ActiveBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="ActiveBorder" Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                                <!-- Minimized window: reduce icon opacity -->
                                <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                    <Setter TargetName="WindowBtn" Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== MIDDLE: Centered Media, Clock, Date, Separator & Larger Vertical Battery Widget ===== -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- Media Player Widget (Compact pill style, appears when media plays) -->
                <Border x:Name="MediaWidget"
                        Background="Transparent"
                        CornerRadius="14"
                        Padding="10,4"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        PreviewMouseLeftButtonDown="MediaWidget_MouseDown"
                        Cursor="Hand"
                        ToolTip="Controlador de Música (Clic para abrir Controles)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Sound Waves Visualizer (6 bars with soft gradients and spacing) -->
                        <Grid Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                <Border x:Name="WaveBar1" Width="2" Height="20" CornerRadius="1" Margin="0.6,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1.0"><Border.RenderTransform><ScaleTransform ScaleY="0.2"/></Border.RenderTransform><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFD39BFF" Offset="0" /><GradientStop Color="#FFAF52DE" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                <Border x:Name="WaveBar2" Width="2" Height="20" CornerRadius="1" Margin="0.6,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1.0"><Border.RenderTransform><ScaleTransform ScaleY="0.2"/></Border.RenderTransform><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFD39BFF" Offset="0" /><GradientStop Color="#FFAF52DE" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                <Border x:Name="WaveBar3" Width="2" Height="20" CornerRadius="1" Margin="0.6,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1.0"><Border.RenderTransform><ScaleTransform ScaleY="0.2"/></Border.RenderTransform><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFD39BFF" Offset="0" /><GradientStop Color="#FFAF52DE" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                <Border x:Name="WaveBar4" Width="2" Height="20" CornerRadius="1" Margin="0.6,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1.0"><Border.RenderTransform><ScaleTransform ScaleY="0.2"/></Border.RenderTransform><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFD39BFF" Offset="0" /><GradientStop Color="#FFAF52DE" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                <Border x:Name="WaveBar5" Width="2" Height="20" CornerRadius="1" Margin="0.6,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1.0"><Border.RenderTransform><ScaleTransform ScaleY="0.2"/></Border.RenderTransform><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFD39BFF" Offset="0" /><GradientStop Color="#FFAF52DE" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                <Border x:Name="WaveBar6" Width="2" Height="20" CornerRadius="1" Margin="0.6,0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1.0"><Border.RenderTransform><ScaleTransform ScaleY="0.2"/></Border.RenderTransform><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFD39BFF" Offset="0" /><GradientStop Color="#FFAF52DE" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                            </StackPanel>
                        </Grid>

                        <!-- Track info -->
                        <Grid VerticalAlignment="Center" Width="110">
                            <!-- Song title & Artist -->
                            <StackPanel x:Name="MediaInfoPanel" VerticalAlignment="Center" Margin="0,0,2,0">
                                <TextBlock x:Name="MediaTitleText"
                                           Text="Sin Reproducir"
                                           Foreground="White"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaArtistText"
                                           Text="Silencio"
                                           Foreground="#85FFFFFF"
                                           FontFamily="{DynamicResource AppFontFamily}"
                                           FontSize="8.5"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0.5,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Separator between media and clock (visible when media widget is visible) -->
                <Border x:Name="MediaSeparator" Width="1" Height="26" Background="#20FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center" Visibility="Collapsed" />

                <!-- Date/Time Stack -->
                <StackPanel x:Name="ClockBlock" VerticalAlignment="Center" Cursor="Hand"
                            PreviewMouseLeftButtonDown="ClockBlock_MouseDown"
                            ToolTip="Ver Calendario">
                    <!-- Date text (Uppercase, clean opacity) -->
                    <TextBlock x:Name="DateText"
                               Text="VIERNES, 3 DE JULIO"
                               Foreground="#A0FFFFFF"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <!-- Time text (Large, bold, prominent white) -->
                    <TextBlock x:Name="TimeText"
                               Text="00:00:00"
                               Foreground="#FFFFFFFF"
                               FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="15"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,1,0,0" />
                </StackPanel>

                <!-- Weather Button (Right of Clock) -->
                 <Button x:Name="WeatherButton"
                         Style="{StaticResource WeatherButtonStyle}"
                         Content="&#xE706;" Click="WeatherButton_Click"
                         ToolTip="Cargando clima..." Margin="10,0,0,0"
                         FontSize="26" VerticalAlignment="Center" />

                <!-- Separator between weather/clock and performance -->
                <Border x:Name="PerfSeparator" Width="1" Height="26" Background="#20FFFFFF" Margin="14,0,0,0" VerticalAlignment="Center" />

                <!-- Performance Monitor Panel (CPU, RAM, Net) -->
                <StackPanel x:Name="PerfMonitorPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <!-- CPU widget -->
                    <StackPanel x:Name="CpuWidget" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Uso del Procesador">
                        <!-- Custom Animated CPU Icon -->
                        <Grid Width="26" Height="26" VerticalAlignment="Center">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                            </Grid.LayoutTransform>
                            <!-- Outer Chip Board -->
                            <Border x:Name="CpuBoard" Width="18" Height="18" BorderBrush="White" BorderThickness="1.5" CornerRadius="2.5" Background="#15FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            
                            <!-- Pulsing Core -->
                            <Border x:Name="CpuCore" Width="8" Height="8" CornerRadius="1.5" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CoreScale" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF00F5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
                                </Border.Effect>
                            </Border>

                            <!-- Pins (Pulsing opacity) -->
                            <Path x:Name="CpuPins" Stroke="White" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 8,1 L 8,4 M 11,1 L 11,4 M 15,1 L 15,4 M 18,1 L 18,4 M 8,22 L 8,25 M 11,22 L 11,25 M 15,22 L 15,25 M 18,22 L 18,25 M 1,8 L 4,8 M 1,11 L 4,11 M 1,15 L 4,15 M 1,18 L 4,18 M 22,8 L 25,8 M 22,11 L 25,11 M 22,15 L 25,15 M 22,18 L 25,18" />
                            
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Name="CpuStory">
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Core Pulsation -->
                                            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleX" From="0.85" To="1.15" Duration="0:0:1.0" AutoReverse="True">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CoreScale" Storyboard.TargetProperty="ScaleY" From="0.85" To="1.15" Duration="0:0:1.0" AutoReverse="True">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <!-- Pins Electrical Pulse -->
                                            <DoubleAnimation Storyboard.TargetName="CpuPins" Storyboard.TargetProperty="Opacity" From="0.4" To="1.0" Duration="0:0:0.8" AutoReverse="True">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                        </Grid>
                        <TextBlock x:Name="CpuText" Text="0%" Foreground="#EEFFFFFF" FontFamily="{DynamicResource AppFontFamily}" FontSize="16" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    
                    <!-- RAM widget -->
                    <StackPanel x:Name="RamWidget" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Uso de Memoria RAM">
                        <!-- Custom Animated RAM Icon -->
                        <Grid Width="26" Height="26" VerticalAlignment="Center">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                            </Grid.LayoutTransform>
                            <!-- RAM Board -->
                            <Border Width="24" Height="10" BorderBrush="White" BorderThickness="1.5" CornerRadius="1.5" Background="#15FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            
                            <!-- Connectors (Bottom pin layout) -->
                            <Path Stroke="White" StrokeThickness="1.0" Opacity="0.7" Data="M 3,17 L 3,19 M 6,17 L 6,19 M 9,17 L 9,19 M 12,17 L 12,19 M 14,17 L 14,19 M 17,17 L 17,19 M 20,17 L 20,19 M 23,17 L 23,19" />
                            
                            <!-- Memory Chips (Pulsing sequentially) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0">
                                <Border x:Name="Chip1" Width="3" Height="5" CornerRadius="0.5" Background="White" Margin="1,0" Opacity="0.5" />
                                <Border x:Name="Chip2" Width="3" Height="5" CornerRadius="0.5" Background="White" Margin="1,0" Opacity="0.5" />
                                <Border x:Name="Chip3" Width="3" Height="5" CornerRadius="0.5" Background="White" Margin="1,0" Opacity="0.5" />
                                <Border x:Name="Chip4" Width="3" Height="5" CornerRadius="0.5" Background="White" Margin="1,0" Opacity="0.5" />
                            </StackPanel>

                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Name="RamStory">
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Chip 1 blink -->
                                            <DoubleAnimation Storyboard.TargetName="Chip1" Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.3" AutoReverse="True" BeginTime="0:0:0.0" />
                                            <!-- Chip 2 blink -->
                                            <DoubleAnimation Storyboard.TargetName="Chip2" Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.3" AutoReverse="True" BeginTime="0:0:0.25" />
                                            <!-- Chip 3 blink -->
                                            <DoubleAnimation Storyboard.TargetName="Chip3" Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.3" AutoReverse="True" BeginTime="0:0:0.5" />
                                            <!-- Chip 4 blink -->
                                            <DoubleAnimation Storyboard.TargetName="Chip4" Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.3" AutoReverse="True" BeginTime="0:0:0.75" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                        </Grid>
                        <TextBlock x:Name="RamText" Text="0%" Foreground="#EEFFFFFF" FontFamily="{DynamicResource AppFontFamily}" FontSize="16" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    
                    <!-- Net widget -->
                    <StackPanel x:Name="NetWidget" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Velocidad de Red">
                        <!-- Custom Animated Network Globe Icon -->
                        <Grid Width="26" Height="26" VerticalAlignment="Center">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                            </Grid.LayoutTransform>
                            <!-- Outer Sphere Ring -->
                            <Ellipse Width="18" Height="18" Stroke="White" StrokeThickness="1.5" Fill="#10FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            
                            <!-- Equator Line (Horizontal) -->
                            <Line X1="4" Y1="13" X2="22" Y2="13" Stroke="White" StrokeThickness="1.0" Opacity="0.5" />
                            
                            <!-- Meridian Ring (Rotating vertical ellipse) -->
                            <Ellipse x:Name="NetMeridian" Width="8" Height="18" Stroke="White" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="MeridianScale" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Diagonal Orbit Ring -->
                            <Ellipse Width="22" Height="6" Stroke="#FFFFF0B5" StrokeThickness="1.0" Opacity="0.7" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-30" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Name="NetStory">
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Rotate 3D Meridian Ring -->
                                            <DoubleAnimation Storyboard.TargetName="MeridianScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="-1.0" Duration="0:0:2.0" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                        </Grid>
                        <TextBlock x:Name="NetText" Text="0.0 KB/s" Foreground="#EEFFFFFF" FontFamily="{DynamicResource AppFontFamily}" FontSize="16" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Separator between performance and battery -->
                <Border x:Name="BatterySeparator" Width="1" Height="26" Background="#20FFFFFF" Margin="14,0" VerticalAlignment="Center" />

                <!-- Custom Vector Battery (Vertical, larger size, next to the clock) -->
                <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Estado de la Batería">
                    <Grid VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <!-- Battery Tip -->
                            <Border x:Name="BatteryTip" Width="4" Height="1.5"
                                    Background="#FFFFFFFF"
                                    CornerRadius="1,1,0,0"
                                    HorizontalAlignment="Center" />
                            <!-- Battery Outline Body (Vertical) -->
                            <Border x:Name="BatteryOutline"
                                    Width="14" Height="26"
                                    BorderBrush="#FFFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="2.5"
                                    Padding="1.5"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    Margin="0,0.5,0,0">
                                <!-- Colored Fill progress bar (Vertical filling from bottom to top) -->
                                <Border x:Name="BatteryFill"
                                        Background="#FFFFFFFF"
                                        CornerRadius="1"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Stretch"
                                        Height="21" />
                            </Border>
                        </StackPanel>
                        <!-- Lightning Bolt Charging Overlay -->
                        <TextBlock x:Name="BatteryChargeIndicator"
                                   Text="&#xE945;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#34C759"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,2,0,0"
                                   Visibility="Collapsed" />
                    </Grid>
                    <!-- Battery percentage text (Styled matching battery height) -->
                    <TextBlock x:Name="BatteryText" Text="--%"
                               Foreground="#EEFFFFFF" FontFamily="{DynamicResource AppFontFamily}"
                               FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

            </StackPanel>

            <!-- ===== RIGHT: System Status Bar (Clean volume, notifications, recycle bin, power) ===== -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Volume (Scroll mouse wheel on hover to change volume, click to mute) -->
                <!-- Volume Button (Custom Animated Soundwaves) -->
                <!-- Volume Button (Custom Animated Holographic Subwoofer) -->
                <Button x:Name="VolumeButton"
                        Click="VolumeButton_Click"
                        PreviewMouseWheel="VolumeButton_PreviewMouseWheel"
                        Width="42" Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="1,0"
                        ToolTip="Volumen (Rueda del mouse cambia volumen)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="VolumeIconGrid" Width="38" Height="38" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="VolumeIconScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <!-- Volume Glow -->
                                <Ellipse x:Name="VolumeGlow" Width="34" Height="34" Opacity="0.25">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="8" />
                                    </Ellipse.Effect>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FF00F5FF" Offset="0" />
                                            <GradientStop Color="#0000F5FF" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Speaker Cone / Megaphone (Premium curved design, Centered horizontally) -->
                                <Path x:Name="SpeakerCone" Stroke="White" StrokeThickness="1.5" Fill="#20FFFFFF" StrokeLineJoin="Round" Data="M 7,15 L 11,15 L 16,10 L 16,28 L 11,23 L 7,23 Z" RenderTransformOrigin="0.35,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="ConeScale" ScaleX="1" ScaleY="1" />
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Wave 1 (inner, positioned next to megaphone without overlapping) -->
                                <Path x:Name="Wave1" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 20,14 A 5,5 0 0 1 20,24" />
                                <!-- Wave 2 (outer, positioned next to Wave 1) -->
                                <Path x:Name="Wave2" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 24,11 A 8,8 0 0 1 24,27" />

                                <!-- Mute Slash (Slashing across Megaphone) -->
                                <Grid x:Name="MuteCross" Visibility="Collapsed">
                                    <Path Stroke="Red" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 7,13 L 17,25" />
                                </Grid>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Content = standard speaker glyph -->
                                <Trigger Property="Content" Value="&#xE767;">
                                    <Setter TargetName="MuteCross" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Wave1" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Wave2" Property="Visibility" Value="Visible" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Name="ActiveSoundAnim">
                                            <Storyboard RepeatBehavior="Forever">
                                                <!-- Pulsing speaker megaphone -->
                                                <DoubleAnimation Storyboard.TargetName="ConeScale" Storyboard.TargetProperty="ScaleX" From="0.95" To="1.05" Duration="0:0:0.6" AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="ConeScale" Storyboard.TargetProperty="ScaleY" From="0.95" To="1.05" Duration="0:0:0.6" AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                
                                                <!-- Wave 1 pulse propagation -->
                                                <DoubleAnimation Storyboard.TargetName="Wave1" Storyboard.TargetProperty="Opacity" From="0.1" To="1.0" Duration="0:0:0.4" BeginTime="0:0:0.0" />
                                                <DoubleAnimation Storyboard.TargetName="Wave2" Storyboard.TargetProperty="Opacity" From="0.1" To="1.0" Duration="0:0:0.4" BeginTime="0:0:0.25" />
                                                
                                                <!-- Reset wave opacities -->
                                                <DoubleAnimation Storyboard.TargetName="Wave1" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.1" BeginTime="0:0:0.7" />
                                                <DoubleAnimation Storyboard.TargetName="Wave2" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.1" BeginTime="0:0:0.7" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="ActiveSoundAnim" />
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- Content = muted speaker glyph -->
                                <Trigger Property="Content" Value="&#xE74F;">
                                    <Setter TargetName="MuteCross" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Wave1" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Wave2" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="SpeakerCone" Property="Opacity" Value="0.4" />
                                </Trigger>

                                <!-- Hover Scaling -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="VolumeIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="VolumeIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="VolumeGlow" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="VolumeIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="VolumeIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="VolumeGlow" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- Mute active (from window datatrigger binding) -->
                                <DataTrigger Binding="{Binding IsMutedActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="VolumeIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="VolumeIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="VolumeIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="VolumeIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Notifications Button (Custom Animated Swinging Bell) -->
                <Button x:Name="NotificationsButton"
                        Click="NotificationsButton_Click"
                        Width="42" Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="1,0"
                        ToolTip="Notificaciones">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="NotifyIconGrid" Width="38" Height="38" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="NotifyIconScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <!-- Bell Shape (Swings from top center, Visually Centered at Y=13) -->
                                <Path Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.2" Data="M 15,3 C 15,3 13,3 13,5 L 13,7 C 10.5,7.5 9,9.5 9,12 L 9,17 L 7,19 L 7,20 L 23,20 L 23,19 L 21,17 L 21,12 C 21,9.5 19.5,7.5 17,7 C 17,5 15,3 15,3 Z M 13,21 A 2,2 0 0 0 17,21 Z">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="BellRotation" Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Loaded Swinging Bell ring pattern (ringing periodically, then resting) -->
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Name="BellRinger">
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Concentrated swing keyframes inside first 1.5 seconds, then resting for 4.5 seconds -->
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BellRotation" Storyboard.TargetProperty="Angle">
                                                <EasingDoubleKeyFrame Value="0" KeyTime="0:0:0.0" />
                                                <EasingDoubleKeyFrame Value="-18" KeyTime="0:0:0.2" />
                                                <EasingDoubleKeyFrame Value="16" KeyTime="0:0:0.4" />
                                                <EasingDoubleKeyFrame Value="-12" KeyTime="0:0:0.6" />
                                                <EasingDoubleKeyFrame Value="10" KeyTime="0:0:0.8" />
                                                <EasingDoubleKeyFrame Value="-6" KeyTime="0:0:1.0" />
                                                <EasingDoubleKeyFrame Value="4" KeyTime="0:0:1.2" />
                                                <EasingDoubleKeyFrame Value="0" KeyTime="0:0:1.5" />
                                                <EasingDoubleKeyFrame Value="0" KeyTime="0:0:6.0" /> <!-- Rest period -->
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <!-- Hover Scale -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="NotifyIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="NotifyIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="NotifyIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="NotifyIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Separator -->
                <Border x:Name="RightSeparator1" Width="1" Height="16" Background="#20FFFFFF" Margin="6,0" VerticalAlignment="Center" />

                <!-- Recycle Bin (Singularidad de Basura) -->
                <Button x:Name="RecycleBinButton"
                        Click="RecycleBinButton_Click"
                        AllowDrop="True"
                        DragOver="RecycleBinButton_DragOver"
                        DragLeave="RecycleBinButton_DragLeave"
                        Drop="RecycleBinButton_Drop"
                        Width="42" Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="1,0"
                        ToolTip="Papelera">
                    <Button.ContextMenu>
                        <ContextMenu Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                            <MenuItem Header="Vaciar Papelera de Reciclaje" Click="ContextEmptyRecycleBin_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="SingularityGrid" Width="38" Height="38" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="SingularityScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                
                                <!-- Accretion Disk Glow (Back layer) -->
                                <Ellipse x:Name="AccretionGlow" Width="34" Height="34" Opacity="0.4" Margin="0">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="8"/>
                                    </Ellipse.Effect>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FFAF52DE" Offset="0" />
                                            <GradientStop Color="#00AF52DE" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Accretion Disk Swirl (Middle rotating layer) -->
                                <Ellipse x:Name="AccretionDisk" Width="28" Height="28" StrokeThickness="3.5" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF00F5FF" Offset="0.0" />
                                            <GradientStop Color="#FFAF52DE" Offset="0.4" />
                                            <GradientStop Color="#FFFF007F" Offset="0.8" />
                                            <GradientStop Color="#FF00F5FF" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Ellipse.Stroke>
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="AccretionRotation" Angle="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- Accretion Disk Secondary Inner Swirl (Faster counter-rotating layer) -->
                                <Ellipse x:Name="AccretionDiskInner" Width="20" Height="20" StrokeThickness="1.5" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Stroke>
                                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                            <GradientStop Color="#FFAF52DE" Offset="0.0" />
                                            <GradientStop Color="#FF00F5FF" Offset="0.5" />
                                            <GradientStop Color="#FFFF007F" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Ellipse.Stroke>
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="AccretionRotationInner" Angle="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- Event Horizon (Black Hole Center) -->
                                <Ellipse x:Name="EventHorizon" Width="10" Height="10" Fill="#FF050505" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#FFAF52DE" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                
                                <!-- Implosion/Explosion Flash Overlay -->
                                <Ellipse x:Name="FlashOverlay" Width="38" Height="38" Fill="White" Opacity="0.0" IsHitTestVisible="False" />
                            </Grid>
                            
                            <ControlTemplate.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Name="SpinBoard">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="AccretionRotation"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:3"
                                                             RepeatBehavior="Forever" />
                                            <DoubleAnimation Storyboard.TargetName="AccretionRotationInner"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="360" To="0" Duration="0:0:1.8"
                                                             RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SingularityScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SingularityScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SingularityScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SingularityScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Show Desktop -->
                <!-- Show Desktop (Custom Animated Desktop Screen & Minimizing Window) -->
                <Button x:Name="ShowDesktopButton"
                        Click="ShowDesktopButton_Click"
                        Width="42" Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="1,0"
                        ToolTip="Mostrar Escritorio">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="DesktopIconGrid" Width="38" Height="38" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="DesktopIconScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <!-- Desktop Screen frame -->
                                <Border Width="22" Height="15" BorderBrush="White" BorderThickness="1.5" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="1" Background="#20000000">
                                    <Grid>
                                        <!-- Minimizing internal window mockup -->
                                        <Border x:Name="MockWindow" Background="White" Width="14" Height="9" CornerRadius="0.5" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,1">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="WindowScale" ScaleY="1" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Border>
                                <!-- Monitor Stand -->
                                <Path Fill="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Data="M 16,27 L 22,27 L 21,29 L 17,29 Z" />
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Loaded Minimizing Window loop -->
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Name="DesktopMinimize">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="WindowScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="0.15" Duration="0:0:1.3" AutoReverse="True" BeginTime="0:0:0.5">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <!-- Hover Scale -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="DesktopIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="DesktopIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="DesktopIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="DesktopIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Separator -->
                <Border x:Name="RightSeparator2" Width="1" Height="16" Background="#20FFFFFF" Margin="6,0" VerticalAlignment="Center" />
                <!-- Power Button (Custom Animated Glowing Power Icon) -->
                <Button x:Name="PowerButton"
                        Click="PowerButton_Click"
                        Width="42" Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="1,0"
                        ToolTip="Opciones de Energía">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="PowerIconGrid" Width="38" Height="38" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="PowerIconScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <!-- Power Glow (Heartbeat red glow) -->
                                <Ellipse x:Name="PowerGlow" Width="30" Height="30" Opacity="0.25">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="6" />
                                    </Ellipse.Effect>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FFFF0033" Offset="0" />
                                            <GradientStop Color="#00FF0033" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Power Symbol Circle (Centered at Y=19) -->
                                <Path Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 14,14 A 7,7 0 1 0 24,14" />
                                <!-- Power Symbol Line (Centered at Y=19) -->
                                <Path Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 19,12 L 19,19" />
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Loaded Heartbeat red glow loop -->
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Name="PowerHeartbeat">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="PowerGlow" Storyboard.TargetProperty="Opacity" From="0.15" To="0.75" Duration="0:0:1.5" AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <!-- Hover Scale -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PowerIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="PowerIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PowerIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="PowerIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- Power Window Open state -->
                                <DataTrigger Binding="{Binding IsPowerWindowOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="ActivePowerState">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PowerIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="PowerIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="PowerGlow" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PowerIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="PowerIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
