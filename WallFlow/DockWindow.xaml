                <!-- Wallpaper Local Gallery Button (Picture frame icon: \uEB9F) -->
                <!-- Wallpaper Local Gallery Button (Custom Animated Stacked Photo Frames) -->
                <Button x:Name="LocalGalleryButton"
                        Click="WallFlowLogoButton_Click"
                        Width="42" Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="4,0,0,0"
                        ToolTip="Galería de Wallpapers">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="GalleryIconGrid" Width="38" Height="38" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="GalleryIconScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <!-- Gallery Glow -->
                                <Ellipse x:Name="GalleryGlow" Width="34" Height="34" Opacity="0.3" Margin="0">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="8"/>
                                    </Ellipse.Effect>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FF00F5FF" Offset="0" />
                                            <GradientStop Color="#0000F5FF" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Back Photo Frame -->
                                <Border x:Name="BackFrame" Width="20" Height="20" BorderBrush="White" BorderThickness="1.5" Background="#80101010" CornerRadius="1.5" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="BackRotation" Angle="12" />
                                    </Border.RenderTransform>
                                </Border>

                                <!-- Front Photo Frame (with Gradient Wallpaper landscape) -->
                                <Border x:Name="FrontFrame" Width="20" Height="20" BorderBrush="White" BorderThickness="1.5" CornerRadius="1.5" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform x:Name="FrontRotation" Angle="-8" />
                                    </Border.RenderTransform>
                                    <Border.Background>
                                        <LinearGradientBrush x:Name="WallpaperGradient" StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop x:Name="GradStop1" Color="#FF00F5FF" Offset="0.0" />
                                            <GradientStop x:Name="GradStop2" Color="#FFAF52DE" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Loaded Shift/Pulse animations -->
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Name="GalleryBoard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Alternate frame angles slightly -->
                                            <DoubleAnimation Storyboard.TargetName="BackRotation" Storyboard.TargetProperty="Angle" From="12" To="18" Duration="0:0:3.5" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="FrontRotation" Storyboard.TargetProperty="Angle" From="-8" To="-14" Duration="0:0:3.5" AutoReverse="True" />
                                            
                                            <!-- Color shifting wallpaper -->
                                            <ColorAnimation Storyboard.TargetName="GradStop1" Storyboard.TargetProperty="Color" To="#FFFF007F" Duration="0:0:5" AutoReverse="True" />
                                            <ColorAnimation Storyboard.TargetName="GradStop2" Storyboard.TargetProperty="Color" To="#FF00F5FF" Duration="0:0:5" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <!-- Mouse Hover Triggers -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GalleryIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="GalleryIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="GalleryGlow" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GalleryIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="GalleryIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="GalleryGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- Window Active State Trigger -->
                                <DataTrigger Binding="{Binding IsLocalGalleryOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="ActiveGalleryState">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GalleryIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="GalleryIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="GalleryGlow" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GalleryIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="GalleryIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="GalleryGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Wallpaper Online Gallery Button (Globe icon: \uE753) -->
                <!-- Wallpaper Online Gallery Button (Custom Animated Planet & Satellite Orbit) -->
                <Button x:Name="OnlineGalleryButton"
                        Click="OnlineGalleryButton_Click"
                        Width="42" Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="4,0,0,0"
                        ToolTip="Galería Online">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="OnlineIconGrid" Width="38" Height="38" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="OnlineIconScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <!-- Online Glow -->
                                <Ellipse x:Name="OnlineGlow" Width="34" Height="34" Opacity="0.3" Margin="0">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="8"/>
                                    </Ellipse.Effect>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FFAF52DE" Offset="0" />
                                            <GradientStop Color="#00AF52DE" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Central Planet Globe -->
                                <Ellipse x:Name="PlanetGlobe" Width="16" Height="16" Stroke="#FFAF52DE" StrokeThickness="1.5" Fill="#20000000" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- Diagonal Orbit Ring (Rotated 30 deg) -->
                                <Grid Width="28" Height="10" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform Angle="-30" />
                                            <RotateTransform x:Name="SatelliteRotation" Angle="0" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <!-- Orbit Line -->
                                    <Ellipse Stroke="#40FFFFFF" StrokeThickness="1" StrokeDashArray="3,2" Margin="0" />
                                    <!-- Satellite Node -->
                                    <Ellipse Width="4.5" Height="4.5" Fill="#FF00F5FF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="-2.25,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#FF00F5FF" BlurRadius="4" ShadowDepth="0" Opacity="0.8" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Loaded Orbit Animation -->
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Name="OnlineBoard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SatelliteRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                                <!-- Mouse Hover Triggers -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="OnlineIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="OnlineIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="OnlineGlow" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="OnlineIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="OnlineIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="OnlineGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>

                                <!-- Window Active State Trigger -->
                                <DataTrigger Binding="{Binding IsOnlineGalleryOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="ActiveOnlineState">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="OnlineIconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="OnlineIconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="OnlineGlow" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="OnlineIconScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="OnlineIconScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2" />
                                                <DoubleAnimation Storyboard.TargetName="OnlineGlow" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- YouTube Music Button (Music note icon: \uE189) -->
                <!-- YouTube Music Button (Custom Animated Equalizer Waveform) -->
                <Button x:Name="YouTubeMusicButton"
                        Click="YouTubeMusicButton_Click"
                        Width="42" Height="42"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="4,0,0,0"
                        ToolTip="YouTube Music">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="MusicIconGrid" Width="38" Height="38" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="MusicIconScale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>

                                <!-- Music Glow -->
                                <Ellipse x:Name="MusicGlow" Width="34" Height="34" Opacity="0.3" Margin="0">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="8"/>
                                    </Ellipse.Effect>
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FFFF0055" Offset="0" />
                                            <GradientStop Color="#00FF0055" Offset="1" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <!-- Equalizer Bars -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="26" Margin="0,2,0,0">
                                    <Border x:Name="Bar1" Width="3.5" Height="10" Margin="1.5,0" CornerRadius="1.5" Background="White" VerticalAlignment="Center" />
                                    <Border x:Name="Bar2" Width="3.5" Height="18" Margin="1.5,0" CornerRadius="1.5" Background="White" VerticalAlignment="Center" />
                                    <Border x:Name="Bar3" Width="3.5" Height="14" Margin="1.5,0" CornerRadius="1.5" Background="White" VerticalAlignment="Center" />
                                    <Border x:Name="Bar4" Width="3.5" Height="8" Margin="1.5,0" CornerRadius="1.5" Background="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Loaded Equalizer Bounce Animation -->
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Name="MusicBoard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="Height" From="6" To="22" Duration="0:0:0.65" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="Height" From="24" To="8" Duration="0:0:0.8" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="Height" From="10" To="26" Duration="0:0:0.55" AutoReverse="True" />
                                            <DoubleAnimation Storyboard.TargetName="Bar4" Storyboard.TargetProperty="Height" From="18" To="4" Duration="0:0:0.75" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

