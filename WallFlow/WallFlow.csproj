<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>WallFlow</AssemblyName>
    <RootNamespace>WallFlow</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>logofondo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="logofondo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WallFlow.Core\WallFlow.Core.csproj" />
    <ProjectReference Include="..\WallFlow.Browser\WallFlow.Browser.csproj" />
    <ProjectReference Include="..\WallFlow.Spotlight\WallFlow.Spotlight.csproj" />
  </ItemGroup>

</Project>
