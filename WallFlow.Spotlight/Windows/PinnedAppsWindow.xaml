<Window x:Class="WallFlow.Windows.PinnedAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WallFlowWindow}"
        Title="Pinned Apps"
        Width="700"
        Height="360"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Opacity="0"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="Transparent"
        AllowsTransparency="True"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Slim custom scrollviewer style to match acrylic glass theme -->
        <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="True" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Width="6"
                                       Margin="2,0"
                                       HorizontalAlignment="Right"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="#40FFFFFF" CornerRadius="3" Width="6" />
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean flat style for rows in Option A -->
        <Style x:Key="LauncherRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean flat style for internal action buttons -->
        <Style x:Key="CleanGlyphButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{Binding DataContext.SpotlightHoverBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{Binding DataContext.SpotlightSelectedBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular button style for favorites -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Background" Value="{DynamicResource DockBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="27"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{Binding DataContext.SpotlightSearchFocusBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.88" Duration="0:0:0.06">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.88" Duration="0:0:0.06">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Search Box Style to override default and match SettingsWindow TextBoxes -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource DockBackgroundBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentActiveBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding DataContext.SpotlightCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.4" Color="Black" Direction="270" />
                            </Border.Effect>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="Center" Margin="46,2,4,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="Background" Value="{Binding DataContext.SpotlightSearchFocusBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular style for Mode buttons -->
        <Style x:Key="ModeCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{Binding SpotlightBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderThickness" Value="{Binding SpotlightBorderThickness, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="27"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.08" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.08" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.1">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.88" Duration="0:0:0.06">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.88" Duration="0:0:0.06">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Translucent Dark Border matching Dock/PowerWindow/WeatherWindow -->
    <Border x:Name="RootBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="False">

        <Grid Margin="8,10" ClipToBounds="False">
            <Grid.RowDefinitions>
                <!-- Search Box -->
                <RowDefinition Height="Auto" />
                <!-- Pinned Apps (horizontal list below search box) -->
                <RowDefinition Height="Auto" />
                <!-- Results List -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Spotlight Search Box and Modes (Horizontal Layout) -->
            <Grid Grid.Row="0" Margin="4,0,4,10" Width="{Binding SpotlightWidth}" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Capsule -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox"
                              Style="{StaticResource SearchTextBoxStyle}"
                              Height="54"
                              Background="{Binding SpotlightBgBrush}"
                              BorderBrush="{Binding SpotlightBorderBrush}"
                              BorderThickness="{Binding SpotlightBorderThickness}"
                              Foreground="{Binding SpotlightTextBrush}"
                              CaretBrush="{Binding SpotlightTextBrush}"
                              TextChanged="SearchBox_TextChanged"
                              PreviewKeyDown="SearchBox_PreviewKeyDown"
                              GotFocus="SearchBox_GotFocus"
                              LostFocus="SearchBox_LostFocus"
                              VerticalContentAlignment="Center" />

                    <!-- Search Icon (magnifying glass) -->
                    <TextBlock Text="&#xE71E;"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{Binding SpotlightIconBrush}"
                                FontSize="16"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0"
                                IsHitTestVisible="False" />

                    <!-- Placeholder / Ghost Text -->
                    <TextBlock x:Name="PlaceholderText"
                                Text="Buscar aplicación..."
                                Foreground="{Binding SpotlightPlaceholderBrush}"
                                FontSize="14"
                                FontFamily="{DynamicResource AppFontFamily}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="48,0,0,0"
                                IsHitTestVisible="False"
                                Visibility="Visible" />
                </Grid>

                <!-- Mode Buttons (Circles next to search box) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <!-- Apps Mode Button -->
                    <Button x:Name="ModeAppsBtn" Style="{StaticResource ModeCircleButtonStyle}" Click="ModeButton_Click" Tag="Apps" ToolTip="Buscar Aplicaciones"
                            Background="{Binding ModeAppsBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                            Foreground="{Binding ModeAppsForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="&#xE5C3;" FontFamily="{StaticResource MaterialIconsFont}" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <!-- Files Mode Button -->
                    <Button x:Name="ModeFilesBtn" Style="{StaticResource ModeCircleButtonStyle}" Click="ModeButton_Click" Tag="Files" ToolTip="Buscar Archivos" Margin="6,0,0,0"
                            Background="{Binding ModeFilesBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                            Foreground="{Binding ModeFilesForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="&#xE873;" FontFamily="{StaticResource MaterialIconsFont}" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <!-- Clipboard Mode Button -->
                    <Button x:Name="ModeClipboardBtn" Style="{StaticResource ModeCircleButtonStyle}" Click="ModeButton_Click" Tag="Clipboard" ToolTip="Historial de Portapapeles" Margin="6,0,0,0"
                            Background="{Binding ModeClipboardBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                            Foreground="{Binding ModeClipboardForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="&#xE14F;" FontFamily="{StaticResource MaterialIconsFont}" FontSize="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Section 2: Pinned Apps (Horizontal layout below the Search Capsule with WrapPanel) -->
            <ItemsControl Grid.Row="1" x:Name="FavoritesControl" Visibility="{Binding SpotlightFavoritesVisibility}" ItemsSource="{Binding FavoritesList, RelativeSource={RelativeSource AncestorType=Window}}" Margin="4,4,4,20" HorizontalAlignment="Center" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CircleButtonStyle}" Background="{Binding DataContext.SpotlightBgBrush, RelativeSource={RelativeSource AncestorType=Window}}" Click="AppButton_Click" Tag="{Binding Path}" ToolTip="{Binding Name}" Margin="6,4">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.5" Color="Black" Direction="270" />
                            </Button.Effect>
                            <Grid>
                                <TextBlock Text="{Binding IconGlyph}"
                                           Visibility="{Binding IsGlyphVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{Binding DataContext.SpotlightItemForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
 
                                <Image Source="{Binding Icon}" 
                                       Visibility="{Binding IsIconVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Width="28" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Section 3: Apps List (Wrapped in floating card border) -->
            <Border Grid.Row="2" x:Name="ResultsCardBorder" 
                    Background="{Binding SpotlightBgBrush}" 
                    CornerRadius="14" 
                    BorderBrush="{Binding SpotlightBorderBrush}" 
                    BorderThickness="{Binding SpotlightBorderThickness}" 
                    Padding="4" 
                    Width="{Binding SpotlightWidth}" 
                    MaxWidth="{Binding SpotlightWidth}"
                    HorizontalAlignment="Center" 
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.4" Color="Black" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <!-- Results List -->
                    <ScrollViewer x:Name="ResultsScrollViewer" Style="{StaticResource SlimScrollViewer}" MaxHeight="288" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <ItemsControl x:Name="AppsControl" ItemsSource="{Binding PinnedAppsList, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="AppButton"
                                            Style="{StaticResource LauncherRowButtonStyle}"
                                            Click="AppButton_Click"
                                            Tag="{Binding Path}"
                                            Margin="0">
                                    
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Ejecutar como administrador" Click="RunAsAdminMenu_Click" Tag="{Binding Path}" Visibility="{Binding IsActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem Header="Abrir ubicación de archivo" Click="OpenLocationMenu_Click" Tag="{Binding Path}" Visibility="{Binding IsActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Separator Visibility="{Binding IsActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem Header="Fijar en el Dock / Favoritos" Click="PinMenu_Click" Tag="{Binding Path}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActionVisible}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                            <MenuItem Header="Desanclar / Eliminar de la lista" Click="UnpinMenu_Click" Tag="{Binding Path}">
                                                <MenuItem.Style>
                                                    <Style TargetType="MenuItem">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActionVisible}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MenuItem.Style>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>

                                    <Border x:Name="RowBorder" Background="Transparent" CornerRadius="12" BorderBrush="Transparent" BorderThickness="1" Margin="2,1">
                                        <Grid x:Name="RowContentGrid" Margin="6,4" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <TranslateTransform X="0" />
                                            </Grid.RenderTransform>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Icon -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                                    Background="{Binding DataContext.SpotlightItemBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding IconGlyph}"
                                                               Visibility="{Binding IsGlyphVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                               Foreground="{Binding DataContext.SpotlightItemForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    <Image Source="{Binding Icon}" 
                                                           Visibility="{Binding IsIconVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                            </Border>

                                            <!-- App Name and Path -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{Binding DataContext.SpotlightTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="13.5" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- Action Badge -->
                                            <Border x:Name="ActionBorder" Grid.Column="2" CornerRadius="4"
                                                    Background="{Binding DataContext.SpotlightItemBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    BorderBrush="{Binding DataContext.SpotlightHoverBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    BorderThickness="1" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock x:Name="ActionTextControl" Text="{Binding ActionText}"
                                                           Foreground="{Binding DataContext.SpotlightSecondaryTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="10.5" FontFamily="{DynamicResource AppFontFamily}" />
                                            </Border>

                                            <!-- Pin Button -->
                                            <Button x:Name="PinButton" Grid.Column="3" Width="26" Height="26" Style="{StaticResource CleanGlyphButtonStyle}" Tag="{Binding Path}" Click="PinButton_Click" Visibility="Collapsed" Margin="6,0,2,0" Focusable="False">
                                                <TextBlock x:Name="PinGlyph" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Foreground="{Binding DataContext.SpotlightSecondaryTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Button>
                                
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="AppButton" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RowBorder" Property="Background" Value="{Binding DataContext.SpotlightHoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Setter TargetName="RowBorder" Property="BorderBrush" Value="{Binding DataContext.SpotlightHoverBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Setter TargetName="PinButton" Property="Visibility" Value="Visible" />
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="RowContentGrid"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="4" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="RowContentGrid"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     To="0" Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                     <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                         <Setter TargetName="RowBorder" Property="Background" Value="{Binding DataContext.SpotlightSelectedBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                         <Setter TargetName="RowBorder" Property="BorderBrush" Value="{Binding DataContext.SpotlightSelectedBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                     </DataTrigger>
                                    <DataTrigger Binding="{Binding RunAsAdmin}" Value="True">
                                        <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource AccentGlowBrush}" />
                                        <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="ActionTextControl" Property="Foreground" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter TargetName="PinGlyph" Property="Text" Value="&#xE840;" />
                                        <Setter TargetName="PinGlyph" Property="Foreground" Value="{DynamicResource AccentActiveBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Separator between results and web search (only visible when there are results) -->
                <Border x:Name="WebSearchSeparator" Height="1"
                        Background="{Binding SpotlightSeparatorBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                        Margin="6,4,6,0" Visibility="Collapsed" />

                <!-- Web Search Row (always visible when card is open) -->
                <Button x:Name="WebSearchButton" Style="{StaticResource LauncherRowButtonStyle}" Click="WebSearchButton_Click" Cursor="Hand">
                    <Border x:Name="WebRowBorder" CornerRadius="12" BorderThickness="1" Margin="2,1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                        <Setter Property="Background" Value="{Binding DataContext.SpotlightHoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Setter Property="BorderBrush" Value="{Binding DataContext.SpotlightHoverBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Margin="6,4" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform X="0" />
                            </Grid.RenderTransform>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                         To="4" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                         To="0" Duration="0:0:0.15">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Globe Icon -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                    Background="{Binding DataContext.SpotlightItemBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                    VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{Binding DataContext.SpotlightItemForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- "Buscar en la web" text -->
                            <TextBlock x:Name="WebSearchText" Grid.Column="1"
                                       Text="Buscar en la web"
                                       Foreground="{Binding DataContext.SpotlightTextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="12.5" FontFamily="{DynamicResource AppFontFamily}"
                                       Opacity="0.75"
                                       VerticalAlignment="Center" />

                            <!-- Arrow -->
                            <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{Binding DataContext.SpotlightIconBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                       VerticalAlignment="Center" Margin="6,0,2,0" />
                        </Grid>
                    </Border>
                </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
