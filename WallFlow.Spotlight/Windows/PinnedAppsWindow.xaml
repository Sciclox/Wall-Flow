<Window x:Class="WallFlow.Windows.PinnedAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WallFlow.Windows"
        xmlns:converters="clr-namespace:WallFlow.Spotlight.Converters"
        xmlns:controls="clr-namespace:WallFlow.Spotlight.Controls"
        Style="{StaticResource WallFlowWindow}"
        Title="WallFlow Spatial Canvas"
        Width="1920"
        Height="1080"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Opacity="0"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="Transparent"
        AllowsTransparency="True"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ArcProgressConverter x:Key="ArcProgressConverter" />
        <FontFamily x:Key="LucideIconsFont">pack://application:,,,/WallFlow;component/Fonts/#lucide</FontFamily>

        <!-- Slim custom scrollviewer style to match acrylic glass theme -->
        <Style x:Key="SlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" CanContentScroll="True" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Width="6"
                                       Margin="2,0"
                                       HorizontalAlignment="Right"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="#40FFFFFF" CornerRadius="3" Width="6" />
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean flat style for rows -->
        <Style x:Key="LauncherRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean flat style for internal action buttons -->
        <Style x:Key="CleanGlyphButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{Binding DataContext.SpotlightHoverBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{Binding DataContext.SpotlightSelectedBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular button style for dock favorites -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="23"
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode Pill Button Style (Sleek horizontal capsule filters) -->
        <Style x:Key="ModePillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#95FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBorder" Background="{TemplateBinding Background}" CornerRadius="17" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Satellite Glass Button Style (Dock ribbon pills) -->
        <Style x:Key="SatelliteGlassBtn" TargetType="Button">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="21" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#30FFFFFF" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#50FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Orbital Node Button Style (Dockless Spatial Nodes) -->
        <Style x:Key="OrbitalNodeBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="rootGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <!-- Ambient Glow Layer -->
                            <Border x:Name="glowBorder"
                                    CornerRadius="25"
                                    Background="#38BDF8"
                                    Opacity="0"
                                    Margin="-3">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#38BDF8" Opacity="0.85" />
                                </Border.Effect>
                            </Border>
                            <!-- Orbital Glass Orb Border -->
                            <Border x:Name="orbBorder"
                                    CornerRadius="25"
                                    Background="#260D1525"
                                    BorderBrush="#35FFFFFF"
                                    BorderThickness="1.2"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="glowBorder" Property="Opacity" Value="0.65" />
                                <Setter TargetName="orbBorder" Property="Background" Value="#4015253F" />
                                <Setter TargetName="orbBorder" Property="BorderBrush" Value="#8038BDF8" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="rootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.18" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="rootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.18" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="rootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-7.0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="rootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="rootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="rootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="orbBorder" Property="Background" Value="#5038BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Orbital Satellite Button Style (Quick System Tools on the Arc) -->
        <Style x:Key="OrbitalSatelliteBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="satRootGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <!-- Ambient Glow Layer -->
                            <Border x:Name="satGlowBorder"
                                    CornerRadius="21"
                                    Background="#818CF8"
                                    Opacity="0"
                                    Margin="-2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#818CF8" Opacity="0.8" />
                                </Border.Effect>
                            </Border>
                            <!-- Satellite Orb Border -->
                            <Border x:Name="satBorder"
                                    CornerRadius="21"
                                    Background="#1C0D1525"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="satGlowBorder" Property="Opacity" Value="0.6" />
                                <Setter TargetName="satBorder" Property="Background" Value="#3515253F" />
                                <Setter TargetName="satBorder" Property="BorderBrush" Value="#80818CF8" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="satRootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="satRootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="satRootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-5.0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="satRootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="satRootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="satRootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="satBorder" Property="Background" Value="#40818CF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Satellite Icon Button Style (Circular controls) -->
        <Style x:Key="SatelliteIconBtn" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="21" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#30FFFFFF" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#60FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Satellite Mini Control Button (Prev, Next, Expand) - Apple Glass Style -->
        <Style x:Key="SatelliteMiniControlBtn" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#35FFFFFF" />
                                <Setter TargetName="b" Property="BorderBrush" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#50FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Satellite Mini Play/Pause Button - Apple Dynamic Island Pill -->
        <Style x:Key="SatelliteMiniPlayBtn" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="{DynamicResource AccentActiveBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="17" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="1" Color="{DynamicResource AccentColor}" Opacity="0.65" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Telemetry Progress Bar Style (RAM & Disk Gauges) -->
        <Style x:Key="MiniTelemetryProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4.5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#35FFFFFF" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2.25" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2.25">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#00F0FF" Opacity="0.7" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Mini Action Button (Minimize/Close inside active window card) -->
        <Style x:Key="WindowMiniBtn" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="#25FFFFFF" />
            <Setter Property="Foreground" Value="#E0FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#55FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inspector Action Primary Button Style -->
        <Style x:Key="InspectorActionPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentActiveBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inspector Action Secondary Button Style -->
        <Style x:Key="InspectorActionSecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{Binding SpotlightItemBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Foreground" Value="{Binding SpotlightTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderBrush" Value="{Binding SpotlightHoverBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{Binding DataContext.SpotlightHoverBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentActiveBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{Binding DataContext.SpotlightSelectedBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- FULL CANVAS ROOT: Liquid Glass & Chromatic Glow -->
    <Border x:Name="RootBorder" Background="#0C04070F" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" ClipToBounds="True"
            MouseDown="RootBorder_MouseDown">

        <Grid x:Name="SpotlightContentGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
            
            <!-- Frosted Ambient Wallpaper Layer (Deep Gaussian Blur for liquid depth) -->
            <Image x:Name="BackdropWallpaperImage"
                   Source="{Binding BentoWallpaperSource}"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Focusable="False"
                   IsHitTestVisible="False"
                   Opacity="0.28"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.Effect>
                    <BlurEffect Radius="65" RenderingBias="Performance" />
                </Image.Effect>
            </Image>

            <!-- Subtle Vignette Overlay for Crisp Contrast without Heavy Black Boxes -->
            <Border Focusable="False" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.85" RadiusY="0.85">
                        <GradientStop Color="#20050810" Offset="0.0" />
                        <GradientStop Color="#70030509" Offset="0.65" />
                        <GradientStop Color="#C0020306" Offset="1.0" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- ZONE 0: TOP AMBIENT SYSTEM HUD (Minimalist Premium Apple/Raycast Style) -->
            <Grid x:Name="TopSystemHudGrid"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Stretch"
                  Margin="36,18,36,0"
                  Height="70"
                  IsHitTestVisible="True">
                <Grid.ColumnDefinitions>
                    <!-- Left Corner: Minimalist Floating Clock -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Screen Center: Frosted Glass Music Capsule -->
                    <ColumnDefinition Width="*" />
                    <!-- Right Corner: Minimalist Precision Telemetry -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 1. MINIMALIST FLOATING CLOCK (Screen Left Corner) -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <!-- Clean typography time -->
                    <TextBlock Text="{Binding SpotlightCurrentTime}"
                               FontSize="34"
                               FontWeight="Light"
                               Foreground="#FFFFFF"
                               FontFamily="{DynamicResource AppFontFamily}"
                               LineHeight="34">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.3" Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Subtitle: Date, Weather & Battery in soft white -->
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                        <!-- Date -->
                        <TextBlock Text="{Binding SpotlightCurrentDate}"
                                   FontSize="11.5"
                                   FontWeight="Normal"
                                   Foreground="#95FFFFFF"
                                   FontFamily="{DynamicResource AppFontFamily}" />

                        <!-- Dot separator -->
                        <TextBlock Text=" • "
                                   FontSize="11"
                                   Foreground="#45FFFFFF"
                                   Visibility="{Binding HasWeatherSnippet, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- Weather snippet -->
                        <TextBlock Text="{Binding SpotlightWeatherSnippet}"
                                   Visibility="{Binding HasWeatherSnippet, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   FontSize="11"
                                   FontWeight="Normal"
                                   Foreground="#85FFFFFF"
                                   FontFamily="{DynamicResource AppFontFamily}" />

                        <!-- Dot separator -->
                        <TextBlock Text=" • "
                                   FontSize="11"
                                   Foreground="#45FFFFFF"
                                   Visibility="{Binding HasBatterySnippet, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- Battery snippet -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasBatterySnippet, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding SpotlightBatteryGlyph}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10.5"
                                       Foreground="#85FFFFFF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,3,0" />
                            <TextBlock Text="{Binding SpotlightBatteryPercentText}"
                                       FontSize="11"
                                       FontWeight="Normal"
                                       Foreground="#85FFFFFF"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 2. FROSTED GLASS MUSIC CAPSULE (Screen Center) -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#1AFFFFFF"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        CornerRadius="26"
                        Padding="14,8,18,8"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="2" Opacity="0.3" Color="Black" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Straight Square Artwork Button (Esquinas rectas) -->
                        <Button Style="{StaticResource LauncherRowButtonStyle}"
                                Click="SatelliteMedia_ToggleCard_Click"
                                ToolTip="Ver reproductor detallado"
                                Margin="0,0,12,0">
                            <Border Width="36" Height="36" CornerRadius="0" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding SatelliteMediaArtwork}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasMediaArtwork, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasNoMediaArtwork, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                        </Button>

                        <!-- Track Info (Solo nombre del video/canción) -->
                        <Button Style="{StaticResource LauncherRowButtonStyle}"
                                Click="SatelliteMedia_ToggleCard_Click"
                                ToolTip="{Binding SatelliteMediaTitle}"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <TextBlock Text="{Binding SatelliteMediaTitle}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="180"
                                       VerticalAlignment="Center" />
                        </Button>

                        <!-- Subtle Monochrome Wave Bars -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.6">
                            <Border Width="2" Height="6" CornerRadius="1" Margin="1,0" Background="White" />
                            <Border Width="2" Height="14" CornerRadius="1" Margin="1,0" Background="White" />
                            <Border Width="2" Height="8" CornerRadius="1" Margin="1,0" Background="White" />
                            <Border Width="2" Height="11" CornerRadius="1" Margin="1,0" Background="White" />
                        </StackPanel>

                        <!-- Monochrome Controls -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Prev -->
                            <Button Style="{StaticResource SatelliteMiniControlBtn}"
                                    Click="SatelliteMedia_Prev_Click"
                                    ToolTip="Pista anterior"
                                    Margin="0,0,3,0">
                                <TextBlock Text="&#xE15F;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="11.5" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>

                            <!-- Play / Pause -->
                            <Button Click="SatelliteMedia_PlayPause_Click"
                                    ToolTip="Reproducir / Pausar"
                                    Width="28" Height="28" Cursor="Hand" Margin="0,0,3,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="PlayBrd" CornerRadius="14" Background="#25FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PlayBrd" Property="Background" Value="#35FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding SatelliteMediaGlyph}" FontFamily="{DynamicResource LucideIconsFont}" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{Binding PlayGlyphMargin}" />
                            </Button>

                            <!-- Next -->
                            <Button Style="{StaticResource SatelliteMiniControlBtn}"
                                    Click="SatelliteMedia_Next_Click"
                                    ToolTip="Siguiente pista">
                                <TextBlock Text="&#xE160;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="11.5" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. MINIMALIST MONOCHROME TELEMETRY (Screen Right Corner) -->
                <Border Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#12FFFFFF"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14,8"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.3" Color="Black" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- RAM Item -->
                        <StackPanel Width="76" ToolTip="{Binding SpotlightRamUsageText}">
                            <Grid>
                                <TextBlock Text="RAM" FontSize="9.5" FontWeight="SemiBold" Foreground="#80FFFFFF" />
                                <TextBlock Text="{Binding SpotlightRamPercentText}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Style="{StaticResource MiniTelemetryProgressStyle}"
                                         Height="3"
                                         Margin="0,4,0,0"
                                         Value="{Binding SpotlightRamPercent}"
                                         Maximum="100"
                                         Foreground="#DDFFFFFF"
                                         Background="#15FFFFFF" />
                        </StackPanel>

                        <!-- Subtle vertical separator -->
                        <Border Width="1" Height="22" Background="#18FFFFFF" Margin="12,0" VerticalAlignment="Center" />

                        <!-- DISK Item -->
                        <StackPanel Width="76" ToolTip="{Binding SpotlightDiskUsageText}">
                            <Grid>
                                <TextBlock Text="DISCO" FontSize="9.5" FontWeight="SemiBold" Foreground="#80FFFFFF" />
                                <TextBlock Text="{Binding SpotlightDiskPercentText}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Style="{StaticResource MiniTelemetryProgressStyle}"
                                         Height="3"
                                         Margin="0,4,0,0"
                                         Value="{Binding SpotlightDiskPercent}"
                                         Maximum="100"
                                         Foreground="#B0FFFFFF"
                                         Background="#15FFFFFF" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ZONE 1: TOP FLOATING SEARCH CAPSULE -->
            <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,96,0,0" Width="820" Height="56">
                <Border Background="#250D121B" BorderBrush="#35FFFFFF" BorderThickness="1.2" CornerRadius="28" SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.45" Color="#00B4D8" Direction="270" />
                    </Border.Effect>
                    <Grid Margin="18,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Glowing Search Icon -->
                        <TextBlock Grid.Column="0" Text="&#xE151;"
                                   FontFamily="{DynamicResource LucideIconsFont}"
                                   Foreground="{DynamicResource AccentActiveBrush}"
                                   FontSize="22"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   IsHitTestVisible="False" />

                        <!-- Search TextBox & Fluid Placeholder -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     Foreground="White"
                                     BorderThickness="0"
                                     FontSize="16.5"
                                     FontFamily="{DynamicResource AppFontFamily}"
                                     CaretBrush="White"
                                     TextChanged="SearchBox_TextChanged"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"
                                     VerticalContentAlignment="Center" />

                            <TextBlock x:Name="PlaceholderText"
                                       Text="Buscar aplicaciones, archivos, o filtrar ventanas activas..."
                                       Foreground="#80FFFFFF"
                                       FontSize="16"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Visible" />
                        </Grid>

                        <!-- Mode Filter Pills -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button Style="{StaticResource ModePillButtonStyle}" Click="ModeButton_Click" Tag="Apps" ToolTip="Buscar Aplicaciones (Ctrl+1)"
                                    Background="{Binding ModeAppsBrush}" Foreground="{Binding ModeAppsForegroundBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE3B1;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Apps" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModePillButtonStyle}" Click="ModeButton_Click" Tag="Windows" ToolTip="Filtrar Ventanas Activas (Ctrl+2)" Margin="4,0,0,0"
                                    Background="{Binding ModeWindowsBrush}" Foreground="{Binding ModeWindowsForegroundBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE30C;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Ventanas" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModePillButtonStyle}" Click="ModeButton_Click" Tag="Files" ToolTip="Buscar Archivos (Ctrl+3)" Margin="4,0,0,0"
                                    Background="{Binding ModeFilesBrush}" Foreground="{Binding ModeFilesForegroundBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE339;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Archivos" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModePillButtonStyle}" Click="ModeButton_Click" Tag="Clipboard" ToolTip="Historial de Portapapeles (Ctrl+4)" Margin="4,0,0,0"
                                    Background="{Binding ModeClipboardBrush}" Foreground="{Binding ModeClipboardForegroundBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE0CF;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Clipboard" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ModePillButtonStyle}" Click="ModeButton_Click" Tag="AI" ToolTip="Consultar Gemini IA (Ctrl+5)" Margin="4,0,0,0"
                                    Background="{Binding ModeAiBrush}" Foreground="{Binding ModeAiForegroundBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE1BB;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="IA" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ZONE 2: CENTER - ACTIVE WINDOWS MATRIX (VENTANAS ACTIVAS & FLUJO ESPACIAL) -->
            <Grid x:Name="ActiveWindowsContainer"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Margin="0,-20,0,0"
                  MaxWidth="1300"
                  Visibility="{Binding ActiveWindowsVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <Grid Grid.Row="0" Margin="14,0,14,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="VENTANAS ACTIVAS &amp; FLUJO" FontSize="12" FontWeight="Bold" Foreground="#B0FFFFFF" Margin="0,0,12,0" />
                        <Border Background="#25FFFFFF" CornerRadius="10" Padding="8,2">
                            <TextBlock Text="{Binding ActiveWindowsCountText}" FontSize="11" Foreground="#E0FFFFFF" FontWeight="Medium" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Chromatic Floating Cards Matrix with Real Thumbnail Previews -->
                <ScrollViewer Grid.Row="1" Style="{StaticResource SlimScrollViewer}" MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ActiveWindowsList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LauncherRowButtonStyle}" Click="ActiveWindow_Click" Margin="10" Cursor="Hand">
                                    <Border Width="275" Height="170"
                                            Background="{Binding TileBackgroundBrush}"
                                            BorderBrush="{Binding BorderGlowBrush}"
                                            BorderThickness="1.2"
                                            CornerRadius="16"
                                            ClipToBounds="True"
                                            SnapsToDevicePixels="True"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="{Binding GlowColor}" Opacity="0.55" />
                                        </Border.Effect>

                                        <Grid>
                                            <!-- Opacity Mask to ensure 100% of internal content is clipped smoothly to the rounded corners -->
                                            <Grid.OpacityMask>
                                                <VisualBrush>
                                                    <VisualBrush.Visual>
                                                        <Border Background="White" Width="275" Height="170" CornerRadius="16" />
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Grid.OpacityMask>

                                            <!-- Layer 1: Window Visual Preview (Thumbnail or High-Res Icon Fallback) with native CornerRadius -->
                                            <Grid>
                                                <!-- Real Captured Miniature Preview with rounded corners -->
                                                <Border CornerRadius="14.8"
                                                        ClipToBounds="True"
                                                        Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Thumbnail}"
                                                                    Stretch="UniformToFill"
                                                                    RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border.Background>
                                                </Border>

                                                <!-- Fallback when Minimized or Initial Capture State with rounded corners -->
                                                <Border CornerRadius="14.8"
                                                        Background="{Binding TileBackgroundBrush}"
                                                        Visibility="{Binding HasNoThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border Width="48" Height="48" CornerRadius="12" Background="#20FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                            <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="{Binding ProcessName}" FontSize="13" FontWeight="SemiBold" Foreground="#E0FFFFFF" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Layer 2: Top & Bottom Frosted Vignettes with matching corner radii -->
                                            <Grid IsHitTestVisible="False">
                                                <Border Height="44" VerticalAlignment="Top" CornerRadius="14.8,14.8,0,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#B8070A0F" Offset="0" />
                                                            <GradientStop Color="#00070A0F" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Border Height="46" VerticalAlignment="Bottom" CornerRadius="0,0,14.8,14.8">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00070A0F" Offset="0" />
                                                            <GradientStop Color="#D8070A0F" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>

                                            <!-- Layer 3: Controls & Information Overlay -->
                                            <Grid Margin="12,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Header: App Icon, Process Name, Window Controls (—, ✕) -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- App Icon -->
                                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="5" Background="#30FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Process Name -->
                                                    <TextBlock Grid.Column="1" Text="{Binding ProcessName}" FontSize="12.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                    <!-- Quick Actions: Minimize & Close -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource WindowMiniBtn}" Click="ActiveWindow_Minimize_Click" Tag="{Binding Hwnd}" ToolTip="Minimizar">
                                                            <TextBlock Text="—" FontSize="11" FontWeight="Bold" />
                                                        </Button>
                                                        <Button Style="{StaticResource WindowMiniBtn}" Click="ActiveWindow_Close_Click" Tag="{Binding Hwnd}" ToolTip="Cerrar ventana">
                                                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Footer: Window Title + Status Pill -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Window Title -->
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12" Foreground="#F5FFFFFF" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                    <!-- Status Pill -->
                                                    <Border Grid.Column="1" Background="#60000000" BorderBrush="{Binding BorderGlowBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusBadge}" FontSize="10" Foreground="#E0FFFFFF" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- SEARCH RESULTS & DYNAMIC INSPECTOR (Active when user types in SearchBox) -->
            <Border x:Name="ResultsCardBorder"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,164,0,90"
                    Width="960"
                    MaxWidth="960"
                    Background="#250B0F17"
                    BorderBrush="#25FFFFFF"
                    BorderThickness="1.2"
                    CornerRadius="20"
                    Padding="10"
                    SnapsToDevicePixels="True"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.5" Color="Black" Direction="270" />
                </Border.Effect>
                <Grid>
                    <!-- 1. STANDARD SEARCH & INSPECTOR VIEW (Apps, Windows, Files, Clipboard) -->
                    <Grid x:Name="StandardResultsView" Visibility="{Binding StandardResultsViewVisibility}">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Search Results List -->
                            <ColumnDefinition Width="420" />
                            <!-- Divider -->
                            <ColumnDefinition Width="1" />
                            <!-- Right: Dynamic Live Inspector -->
                            <ColumnDefinition Width="*" MinWidth="440" />
                        </Grid.ColumnDefinitions>

                    <!-- Left Column: Results List + Web Search -->
                    <StackPanel Grid.Column="0">
                        <ScrollViewer x:Name="ResultsScrollViewer" Style="{StaticResource SlimScrollViewer}" MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <ItemsControl x:Name="AppsControl" ItemsSource="{Binding PinnedAppsList, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="AppButton"
                                                Style="{StaticResource LauncherRowButtonStyle}"
                                                Click="SearchResultRow_Click"
                                                MouseDoubleClick="SearchResultRow_DoubleClick"
                                                MouseEnter="AppButton_MouseEnter"
                                                Tag="{Binding Path}"
                                                Margin="0">
                                            <Border x:Name="RowBorder" CornerRadius="12" BorderThickness="1.2" Margin="2,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#3500B4D8" />
                                                                <Setter Property="BorderBrush" Value="#00F0FF" />
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#00B4D8" Opacity="0.55" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="#1EFFFFFF" />
                                                                <Setter Property="BorderBrush" Value="#40FFFFFF" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid x:Name="RowContentGrid" Margin="6,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon -->
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                                            Background="#20FFFFFF"
                                                            VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <Grid>
                                                            <TextBlock Text="{Binding IconGlyph}"
                                                                       Visibility="{Binding IsGlyphVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                       FontFamily="{DynamicResource LucideIconsFont}" FontSize="24"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                            <Image Source="{Binding Icon}" 
                                                                   Visibility="{Binding IsIconVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                   Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- App Name and Subtitle/Path -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock local:MarkdownHelper.FormattedText="{Binding Name}"
                                                                   Foreground="White"
                                                                   FontSize="16" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />

                                                        <TextBlock Text="{Binding Subtitle}"
                                                                   Visibility="{Binding IsSubtitleVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                   Foreground="#A0FFFFFF"
                                                                   FontSize="13" Margin="0,2,0,0"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <!-- Action Badge -->
                                                    <Border Grid.Column="2" CornerRadius="6"
                                                            Padding="8,3" VerticalAlignment="Center" Margin="6,0,0,0"
                                                            Visibility="{Binding IsActionBadgeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#15FFFFFF" />
                                                                <Setter Property="BorderBrush" Value="#25FFFFFF" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#4000B4D8" />
                                                                        <Setter Property="BorderBrush" Value="#00F0FF" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ActionText}"
                                                                   Foreground="White"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="10.5" FontFamily="{DynamicResource AppFontFamily}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Web Search Separator & Button -->
                        <Border x:Name="WebSearchSeparator" Height="1" Background="#20FFFFFF" Margin="6,4" Visibility="Collapsed" />
                        <Button x:Name="WebSearchButton" Style="{StaticResource LauncherRowButtonStyle}" Click="WebSearchButton_Click" MouseEnter="WebSearchButton_MouseEnter" Visibility="Collapsed">
                            <Border x:Name="WebSearchBorder" CornerRadius="12" BorderThickness="1.2" Padding="8,6" Margin="2,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsWebSearchSelected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Background" Value="#3500B4D8" />
                                                <Setter Property="BorderBrush" Value="#00F0FF" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#00B4D8" Opacity="0.55" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DataContext.IsWebSearchSelected, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="#1EFFFFFF" />
                                                <Setter Property="BorderBrush" Value="#40FFFFFF" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="36" Height="36" CornerRadius="6" Background="#20FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE0E8;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="20" Foreground="{DynamicResource AccentActiveBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="WebSearchText" Text="Buscar en la web" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Abrir en navegador predeterminado" Foreground="#90FFFFFF" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Button>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Grid.Column="1" Background="#20FFFFFF" Margin="8,4" />

                    <!-- Right Column: Dynamic Live Inspector -->
                    <Border Grid.Column="2" x:Name="InspectorPanel" Padding="14,10" Background="Transparent">
                        <ScrollViewer x:Name="InspectorScrollViewer" Style="{StaticResource SlimScrollViewer}" MaxHeight="{Binding MaxHeight, ElementName=ResultsScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <!-- 1. Image & Document Preview View -->
                                <StackPanel x:Name="InspectorImageView" Visibility="{Binding InspectorFileViewVisibility}">
                                    <Border CornerRadius="12" Background="#18FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" MaxHeight="240" Margin="0,0,0,12" ClipToBounds="True">
                                        <Image Source="{Binding InspectorImageSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <TextBlock Text="{Binding InspectorDimensions}" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding InspectorFileSize}" Foreground="#90FFFFFF" FontSize="12.5" Margin="0,0,0,14" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource InspectorActionPrimaryBtn}" Click="InspectorOpenFile_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE160;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Abrir archivo (↵)" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InspectorActionSecondaryBtn}" Click="InspectorSetWallpaper_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Fondo (Alt+W)" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InspectorActionSecondaryBtn}" Click="InspectorOpenFolder_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Carpeta (Alt+O)" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- 2. Code File View -->
                                <StackPanel x:Name="InspectorCodeView" Visibility="{Binding InspectorCodeViewVisibility}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding InspectorCodeLanguage}" Foreground="{DynamicResource AccentActiveBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding InspectorCodeLines}" Foreground="#90FFFFFF" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border CornerRadius="8" Background="#30000000" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="10" Margin="0,0,0,12" MaxHeight="250">
                                        <ScrollViewer Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding InspectorCodeSnippet}" Foreground="#E0FFFFFF" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5" TextWrapping="NoWrap" />
                                        </ScrollViewer>
                                    </Border>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource InspectorActionPrimaryBtn}" Click="InspectorOpenFile_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE160;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Abrir archivo (↵)" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InspectorActionSecondaryBtn}" Click="InspectorCopyContent_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Copiar código" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InspectorActionSecondaryBtn}" Click="InspectorOpenFolder_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Carpeta (Alt+O)" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- 3. Application Execution View -->
                                <StackPanel x:Name="InspectorAppView" Visibility="{Binding InspectorAppViewVisibility}">
                                    <Grid Margin="0,4,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#20FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Image Source="{Binding InspectorAppIcon}" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding InspectorAppName}" Foreground="White" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding InspectorAppStatus}" Foreground="#D0FFFFFF" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding InspectorSubtitle}" Foreground="#80FFFFFF" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Border CornerRadius="8" Background="#20FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="RAM EN USO" FontSize="10" Foreground="#80FFFFFF" FontWeight="Bold" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding InspectorAppRamUsage}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="PROCESO PID" FontSize="10" Foreground="#80FFFFFF" FontWeight="Bold" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding InspectorAppPid}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource InspectorActionPrimaryBtn}" Click="InspectorLaunchApp_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Ejecutar (↵)" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InspectorActionSecondaryBtn}" Click="InspectorRunAsAdmin_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Admin (Ctrl+Shift+↵)" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InspectorActionSecondaryBtn}" Click="InspectorOpenFolder_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Ubicación" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- 4. Clipboard History Detail View -->
                                <StackPanel x:Name="InspectorClipboardView" Visibility="{Binding InspectorClipboardViewVisibility}">
                                    
                                    <!-- Image Preview (When clipboard item is an image) -->
                                    <StackPanel Visibility="{Binding InspectorClipboardImageViewVisibility}">
                                        <Border CornerRadius="12" Background="#18FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" MaxHeight="260" Margin="0,0,0,10" ClipToBounds="True">
                                            <Image Source="{Binding InspectorClipboardImageSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock Text="{Binding InspectorClipboardImageDimensions}" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,3" />
                                        <TextBlock Text="{Binding InspectorClipboardImageDetails}" Foreground="#90FFFFFF" FontSize="12" Margin="0,0,0,14" />
                                    </StackPanel>

                                    <!-- Text Preview (When clipboard item is text / code / link) -->
                                    <StackPanel Visibility="{Binding InspectorClipboardTextViewVisibility}">
                                        <TextBlock Text="{Binding InspectorClipboardWordCount}" Foreground="#90FFFFFF" FontSize="11.5" Margin="0,0,0,8" />
                                        <Border CornerRadius="8" Background="#30000000" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="12" Margin="0,0,0,12" MaxHeight="250">
                                            <ScrollViewer Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <TextBlock Text="{Binding InspectorFullClipboardText}" Foreground="White" FontSize="13.5" TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource InspectorActionPrimaryBtn}" Click="InspectorCopyContent_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding InspectorClipboardCopyButtonText, FallbackValue='Copiar (Enter)'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InspectorActionSecondaryBtn}" Click="InspectorOpenFile_Click" Margin="0,0,8,8"
                                                Visibility="{Binding InspectorClipboardImageViewVisibility}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE160;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Abrir (↵)" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InspectorActionSecondaryBtn}" Click="InspectorSetWallpaper_Click" Margin="0,0,8,8"
                                                Visibility="{Binding InspectorClipboardImageViewVisibility}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Fondo (Alt+W)" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InspectorActionSecondaryBtn}" Click="InspectorOpenFolder_Click" Margin="0,0,8,8"
                                                Visibility="{Binding InspectorClipboardImageViewVisibility}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Carpeta (Alt+O)" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InspectorActionSecondaryBtn}" Click="InspectorOpenLink_Click" Margin="0,0,8,8"
                                                Visibility="{Binding InspectorIsLink, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE12B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Abrir enlace" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- 5. Gemini AI View -->
                                <StackPanel x:Name="InspectorAiView" Visibility="{Binding InspectorAiViewVisibility}">
                                    <Border Background="#20FFFFFF" BorderThickness="1" BorderBrush="#30FFFFFF" CornerRadius="6" Padding="10,6" Margin="0,0,0,10" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE1BB;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="14" Foreground="{DynamicResource AccentActiveBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Google Gemini AI" Foreground="White" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="8" Background="#30000000" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,0,12" MaxHeight="280">
                                        <ScrollViewer Style="{StaticResource SlimScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock local:MarkdownHelper.FormattedText="{Binding InspectorAiResponse}" Foreground="White" FontSize="14" LineHeight="22" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                    <Button Style="{StaticResource InspectorActionPrimaryBtn}" Click="InspectorCopyContent_Click" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Copiar Respuesta" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- 6. Web Search View -->
                                <StackPanel x:Name="InspectorWebView" Visibility="{Binding InspectorWebViewVisibility}">
                                    <Grid Margin="0,4,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#2000B4D8" BorderBrush="#4000F0FF" BorderThickness="1.2" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE0E8;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="24" Foreground="{DynamicResource AccentActiveBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Búsqueda en la Web" Foreground="White" FontSize="18" FontWeight="Bold" />
                                            <TextBlock Text="Google / Navegador predeterminado" Foreground="#A0FFFFFF" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <Border CornerRadius="10" Background="#20000000" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="CONSULTA A BUSCAR" FontSize="10.5" Foreground="#80FFFFFF" FontWeight="Bold" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding InspectorWebQuery}" Foreground="{DynamicResource AccentActiveBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource InspectorActionPrimaryBtn}" Click="InspectorOpenWeb_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE12B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Abrir en navegador (Enter)" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InspectorActionSecondaryBtn}" Click="InspectorCopyContent_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Copiar consulta" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- 7. Music / YouTube Music View -->
                                <StackPanel x:Name="InspectorMusicView" Visibility="{Binding InspectorMusicViewVisibility}">
                                    <!-- High-Resolution Artwork / Thumbnail Container (Uncropped Full View) -->
                                    <Border CornerRadius="14" Background="#18050912" BorderBrush="#25FFFFFF" BorderThickness="1" MinHeight="160" MaxHeight="240" Margin="0,2,0,12" ClipToBounds="True">
                                        <Grid>
                                            <!-- Fallback Lucide Icon Placeholder -->
                                            <TextBlock Text="&#xE217;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="38" Foreground="#30FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <!-- Ambient Blurred Glow Backdrop (Fills edges seamlessly with matching colors) -->
                                            <Image Source="{Binding InspectorMusicArtwork}" Stretch="UniformToFill" Opacity="0.32" RenderOptions.BitmapScalingMode="LowQuality">
                                                <Image.Effect>
                                                    <BlurEffect Radius="35" RenderingBias="Performance" />
                                                </Image.Effect>
                                            </Image>
                                            <Border Background="#20000000" />

                                            <!-- Crisp 100% Complete Uncropped Artwork / Thumbnail -->
                                            <Image Source="{Binding InspectorMusicArtwork}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black" />
                                                </Image.Effect>
                                            </Image>

                                            <!-- Duration badge overlay -->
                                            <Border Background="#B8000000" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Visibility="{Binding InspectorMusicDurationVisibility}">
                                                <TextBlock Text="{Binding InspectorMusicDuration}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Video Title and Channel -->
                                    <TextBlock Text="{Binding InspectorMusicTitle}" Foreground="White" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding InspectorMusicSubtitle}" Foreground="#A0FFFFFF" FontSize="12.5" FontWeight="Medium" Margin="0,0,0,10" />

                                    <!-- Status / Animated Equalizer Info -->
                                    <Border CornerRadius="8" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="10,8" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Animated Equalizer Bars -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Height="14" Margin="0,0,10,0"
                                                        Visibility="{Binding InspectorMusicEqualizerVisibility}">
                                                <Border Width="3" Height="10" Background="#FF0000" CornerRadius="1.5" Margin="1.5,0" />
                                                <Border Width="3" Height="14" Background="{DynamicResource AccentActiveBrush}" CornerRadius="1.5" Margin="1.5,0" />
                                                <Border Width="3" Height="7" Background="#00F0FF" CornerRadius="1.5" Margin="1.5,0" />
                                                <Border Width="3" Height="12" Background="{DynamicResource AccentActiveBrush}" CornerRadius="1.5" Margin="1.5,0" />
                                                <Border Width="3" Height="8" Background="#FF0000" CornerRadius="1.5" Margin="1.5,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding InspectorMusicStatus}" Foreground="#D0FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>

                                    <!-- Action Buttons -->
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource InspectorActionPrimaryBtn}" Click="InspectorPlayMusic_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Reproducir (↵)" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InspectorActionSecondaryBtn}" Click="InspectorOpenMusicBrowser_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE12B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="YouTube Web" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InspectorActionSecondaryBtn}" Click="InspectorOpenMusicWindow_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Ventana YTM" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- 8. Default Empty View -->
                                <Grid x:Name="InspectorDefaultView" Visibility="{Binding InspectorDefaultViewVisibility}" MinHeight="260">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE151;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="36" Foreground="{DynamicResource AccentActiveBrush}" Opacity="0.4" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="Selecciona un resultado para previsualizarlo" Foreground="#80FFFFFF" FontSize="14" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    </Grid>

                    <!-- 2. CONVERSATIONAL AI CHAT VIEW (Active when _searchMode == "AI") -->
                    <Grid x:Name="AiChatView" Visibility="{Binding AiChatViewVisibility}" Margin="4,2">
                        <Grid.RowDefinitions>
                            <!-- Row 0: Chat Header Bar (Status badge + New chat button) -->
                            <RowDefinition Height="Auto" />
                            <!-- Row 1: Chat Thread / Empty State -->
                            <RowDefinition Height="*" MinHeight="320" MaxHeight="480" />
                        </Grid.RowDefinitions>

                        <!-- Header bar -->
                        <Grid Grid.Row="0" Margin="10,4,10,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#2000B4D8" BorderBrush="#4000F0FF" BorderThickness="1" CornerRadius="12" Padding="8,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#00F0FF" Margin="0,0,6,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#00F0FF" Opacity="0.8" />
                                            </Border.Effect>
                                        </Border>
                                        <TextBlock Text="{Binding ActiveAiModelName}" Foreground="#00F0FF" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Conversación activa" Foreground="#70FFFFFF" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- New Chat button -->
                            <Button Style="{StaticResource CleanGlyphButtonStyle}"
                                    Click="AiNewChat_Click"
                                    HorizontalAlignment="Right"
                                    Padding="10,5"
                                    Background="#14FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    ToolTip="Iniciar una nueva conversación y limpiar el historial">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE107;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="12" Foreground="#D0FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Nuevo chat" FontSize="11.5" FontWeight="SemiBold" Foreground="#E0FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Empty State (Shown when AiChatMessages is empty) -->
                        <Grid Grid.Row="1" Visibility="{Binding AiChatEmptyStateVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,10">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="640">
                                <Border Width="52" Height="52" CornerRadius="26" Background="#2000B4D8" BorderBrush="#4000F0FF" BorderThickness="1.2" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="&#xE1BB;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="24" Foreground="#00F0FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="¿En qué te puedo ayudar hoy?" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Escribe tu mensaje en la barra de búsqueda o prueba una de estas sugerencias:" Foreground="#85FFFFFF" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,18" />

                                <!-- Quick Suggestion Chips -->
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource CleanGlyphButtonStyle}" Click="AiSuggestionChip_Click" Tag="Explícame cómo funciona una API REST de forma sencilla" Margin="4" Padding="12,7" Background="#16FFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#00F0FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="¿Cómo funciona una API REST?" Foreground="#E8E8E8" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CleanGlyphButtonStyle}" Click="AiSuggestionChip_Click" Tag="Escribe una función en C# para leer un archivo asíncronamente con manejo de errores" Margin="4" Padding="12,7" Background="#16FFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BE;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#00F0FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Ejemplo de C# moderno" Foreground="#E8E8E8" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CleanGlyphButtonStyle}" Click="AiSuggestionChip_Click" Tag="Resume las mejores prácticas de diseño de interfaz minimalista y moderna" Margin="4" Padding="12,7" Background="#16FFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#00F0FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Diseño minimalista de UI" Foreground="#E8E8E8" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource CleanGlyphButtonStyle}" Click="AiSuggestionChip_Click" Tag="Dame 5 atajos de teclado esenciales de Windows 11 para productividad" Margin="4" Padding="12,7" Background="#16FFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#00F0FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Atajos de Windows útiles" Foreground="#E8E8E8" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Chat Messages ScrollViewer -->
                        <ScrollViewer Grid.Row="1" x:Name="AiChatScrollViewer"
                                      Style="{StaticResource SlimScrollViewer}"
                                      MaxHeight="450"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding AiChatThreadVisibility}"
                                      Padding="10,0,14,10">
                            <ItemsControl ItemsSource="{Binding AiChatMessages, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6" HorizontalAlignment="Stretch">
                                            <!-- USER MESSAGE BUBBLE -->
                                            <Border x:Name="UserBubble"
                                                    Visibility="{Binding UserMessageVisibility}"
                                                    HorizontalAlignment="Right"
                                                    MaxWidth="720"
                                                    Background="#3200B4D8"
                                                    BorderBrush="#5500F0FF"
                                                    BorderThickness="1"
                                                    CornerRadius="16,16,4,16"
                                                    Padding="14,10"
                                                    Margin="40,2,4,2">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Content}"
                                                               Foreground="White"
                                                               FontSize="13.5"
                                                               LineHeight="20"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding FormattedTime}"
                                                               Foreground="#80FFFFFF"
                                                               FontSize="10"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- AI RESPONSE CARD -->
                                            <Border x:Name="AiBubble"
                                                    Visibility="{Binding AiMessageVisibility}"
                                                    HorizontalAlignment="Left"
                                                    MaxWidth="860"
                                                    Background="#1AFFFFFF"
                                                    BorderBrush="#25FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="16,16,16,4"
                                                    Padding="16,12"
                                                    Margin="4,2,40,2">
                                                <StackPanel>
                                                    <!-- Header -->
                                                    <Grid Margin="0,0,0,8">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="18" Height="18" CornerRadius="9" Background="#2500B4D8" Margin="0,0,6,0">
                                                                <TextBlock Text="&#xE1BB;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="10" Foreground="#00F0FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="Gemini AI" FontSize="11.5" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" />
                                                            <TextBlock Text="•" Foreground="#50FFFFFF" Margin="6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding FormattedTime}" FontSize="10.5" Foreground="#70FFFFFF" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <!-- Copy button -->
                                                        <Button Style="{StaticResource CleanGlyphButtonStyle}"
                                                                Visibility="{Binding ActionButtonsVisibility}"
                                                                Click="AiCopyMessage_Click"
                                                                Tag="{Binding Content}"
                                                                HorizontalAlignment="Right"
                                                                Padding="8,4"
                                                                Background="#16FFFFFF"
                                                                Cursor="Hand"
                                                                ToolTip="Copiar respuesta al portapapeles">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#B0FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Copiar" FontSize="11" Foreground="#D0FFFFFF" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Loading Indicator -->
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding LoadingVisibility}" Margin="4,6">
                                                        <TextBlock Text="&#xE1BB;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="14" Foreground="#00F0FF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="Gemini está pensando..." Foreground="#A0FFFFFF" FontSize="13" FontStyle="Italic" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Formatted Markdown Text -->
                                                    <TextBlock Visibility="{Binding ContentVisibility}"
                                                               local:MarkdownHelper.FormattedText="{Binding Content}"
                                                               Foreground="#F5F5F5"
                                                               FontSize="13.5"
                                                               LineHeight="21"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= YOUTUBE MUSIC EXPANDED PLAYER CARD (DROPDOWN FROM TOP HUD) ================= -->
            <Border x:Name="PlayerExpandedCard"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,90,0,0"
                    Width="360"
                    Background="#E60B0F17"
                    BorderBrush="#35FFFFFF"
                    BorderThickness="1.2"
                    CornerRadius="20"
                    Padding="16"
                    SnapsToDevicePixels="True"
                    Visibility="{Binding IsPlayerExpandedVisibility}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.65" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0: Header (YouTube Music brand + Close button) -->
                        <RowDefinition Height="Auto" />
                        <!-- 1: Body (Artwork, Title, Artist, Visualizer) -->
                        <RowDefinition Height="Auto" />
                        <!-- 2: Controls (Prev, Play/Pause, Next) -->
                        <RowDefinition Height="Auto" />
                        <!-- 3: Footer Action Button (Open Full YouTube Music Web App) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#FF0000" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="&#xE13C;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0" />
                            </Border>
                            <TextBlock Text="YouTube Music" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource CleanGlyphButtonStyle}" Click="SatelliteMedia_ToggleCard_Click" HorizontalAlignment="Right" Width="26" Height="26" ToolTip="Cerrar reproductor">
                            <TextBlock Text="&#xE1B2;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="13" Foreground="#90FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- Body: Artwork + Details -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Album Artwork / Thumbnail (68x68) with rounded clipping -->
                        <Border Grid.Column="0" Width="68" Height="68" CornerRadius="12" Background="#20FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Margin="0,0,14,0">
                            <Grid>
                                <Border CornerRadius="11">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,66,66" RadiusX="11" RadiusY="11" />
                                    </Border.Clip>
                                    <Image Source="{Binding SatelliteMediaArtwork}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasMediaArtwork, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Border>
                                <Grid Visibility="{Binding HasNoMediaArtwork, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border Background="#E6121212" CornerRadius="11" />
                                    <TextBlock Text="&#xE122;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="28" Foreground="{DynamicResource AccentActiveBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Details: Title & Artist -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SatelliteMediaTitle}" FontSize="14.5" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SatelliteMediaArtist}" FontSize="12" FontWeight="Medium" Foreground="#A0FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                       Visibility="{Binding HasMediaArtist, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Controls: Prev, Play/Pause, Next (Lucide Vector Glyphs) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Button Style="{StaticResource SatelliteMiniControlBtn}" Click="SatelliteMedia_Prev_Click" ToolTip="Pista anterior" Width="36" Height="36" Margin="6,0">
                            <TextBlock Text="&#xE15F;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="15" Foreground="#D0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource SatelliteMiniPlayBtn}" Click="SatelliteMedia_PlayPause_Click" ToolTip="Reproducir / Pausar" Width="44" Height="44" Margin="10,0">
                            <TextBlock Text="{Binding SatelliteMediaGlyph}" FontFamily="{DynamicResource LucideIconsFont}" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{Binding PlayGlyphMargin}" />
                        </Button>
                        <Button Style="{StaticResource SatelliteMiniControlBtn}" Click="SatelliteMedia_Next_Click" ToolTip="Siguiente pista" Width="36" Height="36" Margin="6,0">
                            <TextBlock Text="&#xE160;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="15" Foreground="#D0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>

                    <!-- Footer Button: Open Full YouTube Music Window -->
                    <Button Grid.Row="3"
                            Style="{StaticResource InspectorActionPrimaryBtn}"
                            Click="SatelliteMedia_OpenYtMusic_Click"
                            HorizontalAlignment="Stretch"
                            ToolTip="Abrir interfaz completa de YouTube Music">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE0B9;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Abrir reproductor web completo" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ZONE 3: SPATIAL ORBITAL ARC (DOCKLESS GRAVITATIONAL HUD) -->
            <Grid x:Name="BottomOrbitalZone"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,24"
                  SnapsToDevicePixels="True">

                <!-- ATMOSPHERIC NEBULA HORIZON (Soft Aurora Glow Base - No cutting wire) -->
                <Grid VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-6" IsHitTestVisible="False">
                    <!-- Deep Nebula Ambient Glow (Large Soft Atmosphere) -->
                    <Border Height="68"
                            Width="980"
                            CornerRadius="34"
                            Opacity="0.45"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,-12">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.7" GradientOrigin="0.5,0.7" RadiusX="0.5" RadiusY="0.7">
                                <GradientStop Color="#5538BDF8" Offset="0.0" />
                                <GradientStop Color="#30818CF8" Offset="0.45" />
                                <GradientStop Color="#000D1525" Offset="1.0" />
                            </RadialGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <BlurEffect Radius="42" />
                        </Border.Effect>
                    </Border>

                    <!-- Core Horizon Crest Light Line (Soft wide ambient crest below the items) -->
                    <Border Height="2"
                            Width="780"
                            Opacity="0.65"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0038BDF8" Offset="0.0" />
                                <GradientStop Color="#5038BDF8" Offset="0.2" />
                                <GradientStop Color="#CC818CF8" Offset="0.5" />
                                <GradientStop Color="#5038BDF8" Offset="0.8" />
                                <GradientStop Color="#0038BDF8" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#38BDF8" Opacity="0.85" />
                        </Border.Effect>
                    </Border>
                </Grid>

                <!-- Orbital Elements Stack -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <!-- 1. Pinned Apps in Parabolic Orbital Arc -->
                    <ItemsControl ItemsSource="{Binding FavoritesList}" Margin="0,0,6,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:OrbitalArcPanel ArcHeight="18" Spacing="8" VerticalAlignment="Bottom" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource OrbitalNodeBtnStyle}"
                                        Click="AppButton_Click"
                                        Tag="{Binding Path}"
                                        ToolTip="{Binding Name}">
                                    <Grid>
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   Visibility="{Binding IsGlyphVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   FontFamily="{DynamicResource LucideIconsFont}" FontSize="24"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Icon}"
                                               Visibility="{Binding IsIconVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <!-- Active running indicator micro-beacon -->
                                        <Border Width="4" Height="4" CornerRadius="2" Background="#38BDF8"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" Color="#38BDF8" Opacity="0.95" ShadowDepth="0" />
                                            </Border.Effect>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 2. Ethereal Light Particle Slit (Celestial Divider) -->
                    <Border Width="1.5" Height="26" VerticalAlignment="Bottom" Margin="8,0,10,12" CornerRadius="0.75">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0038BDF8" Offset="0.0" />
                                <GradientStop Color="#9038BDF8" Offset="0.5" />
                                <GradientStop Color="#0038BDF8" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#38BDF8" Opacity="0.85" ShadowDepth="0" />
                        </Border.Effect>
                    </Border>

                    <!-- 3. Satellite Action Nodes (In subtle orbital arc) -->
                    <controls:OrbitalArcPanel ArcHeight="8" Spacing="6" VerticalAlignment="Bottom" Margin="0,0,0,2">
                        <!-- Wallpaper Gallery Button -->
                        <Button Style="{StaticResource OrbitalSatelliteBtnStyle}"
                                Click="SatelliteWallpaper_Click"
                                MouseRightButtonUp="SatelliteWallpaper_MouseRightButtonUp"
                                ToolTip="Fondos de Pantalla (Clic: Galería en Abanico | Clic derecho: Fondo aleatorio)">
                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- System Action Controls (Pure Vector Icons) -->
                        <Button Style="{StaticResource OrbitalSatelliteBtnStyle}" Click="SatelliteNotifications_Click" ToolTip="Notificaciones">
                            <Grid>
                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Width="7" Height="7" CornerRadius="3.5" Background="#FF3B30" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                        Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource OrbitalSatelliteBtnStyle}" Click="SatelliteDevices_Click" ToolTip="Dispositivos Conectados">
                            <Grid>
                                <TextBlock Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Width="7" Height="7" CornerRadius="3.5" Background="#34C759" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                        Visibility="{Binding HasConnectedDevices, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource OrbitalSatelliteBtnStyle}" Click="SatelliteVolume_Click" ToolTip="Silenciar / Alternar Volumen">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource OrbitalSatelliteBtnStyle}" Click="SatelliteRecycleBin_Click" ToolTip="Vaciar Papelera de Reciclaje">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource OrbitalSatelliteBtnStyle}" Click="SatelliteLock_Click" ToolTip="Bloquear Sesión (Win+L)">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource OrbitalSatelliteBtnStyle}" Click="SatelliteAi_Click" ToolTip="Consultar Gemini IA">
                            <TextBlock Text="&#xE1BB;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </controls:OrbitalArcPanel>
                </StackPanel>
            </Grid>

            <!-- ================= IN-WINDOW NOTIFICATIONS CARD ================= -->
            <Border x:Name="NotificationsCard"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="0,24,36,0"
                    Width="400"
                    MaxHeight="540"
                    Background="#E60B0F17"
                    BorderBrush="#35FFFFFF"
                    BorderThickness="1.2"
                    CornerRadius="20"
                    Padding="16"
                    SnapsToDevicePixels="True"
                    Visibility="{Binding NotificationsCardVisibility}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.65" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0: Header (Icon, Title, Count, Clear Button, Close Button) -->
                        <RowDefinition Height="Auto" />
                        <!-- 1: Divider -->
                        <RowDefinition Height="Auto" />
                        <!-- 2: Body (List or Empty State) -->
                        <RowDefinition Height="*" />
                        <!-- 3: Footer (Abrir en Windows / Win+N) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#20FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Notificaciones" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Background="#25FFFFFF" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NotificationsCountText}" FontSize="11" FontWeight="Medium" Foreground="#B0FFFFFF" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Limpiar todas -->
                            <Button Style="{StaticResource CleanGlyphButtonStyle}"
                                    Click="ClearAllNotifications_Click"
                                    Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,0,8,0"
                                    Padding="8,4"
                                    ToolTip="Limpiar todas las notificaciones">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#B0FFFFFF" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Limpiar" FontSize="11.5" Foreground="#B0FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Cerrar panel -->
                            <Button Style="{StaticResource CleanGlyphButtonStyle}"
                                    Click="CloseNotificationsCard_Click"
                                    Width="26" Height="26"
                                    ToolTip="Cerrar panel">
                                <TextBlock Text="&#xE1B2;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="13" Foreground="#90FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Subtle Divider -->
                    <Border Grid.Row="1" Height="1" Background="#18FFFFFF" Margin="-16,0,-16,12" />

                    <!-- Body: List or Empty State -->
                    <Grid Grid.Row="2" MinHeight="140" MaxHeight="380">
                        <!-- Empty State View -->
                        <Grid Visibility="{Binding HasNoNotifications, Converter={StaticResource BooleanToVisibilityConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="50" Height="50" CornerRadius="25" Background="#12FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No tienes notificaciones pendientes"
                                           FontSize="13.5" FontWeight="SemiBold" Foreground="#E0FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="Las nuevas notificaciones del sistema aparecerán aquí."
                                           FontSize="11.5" Foreground="#70FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
                            </StackPanel>
                        </Grid>

                        <!-- Notification List -->
                        <ScrollViewer Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Style="{StaticResource SlimScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding NotificationsList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Margin="0,0,0,8" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- App Icon or Glyph -->
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#22FFFFFF" VerticalAlignment="Top" Margin="0,2,10,0">
                                                    <TextBlock Text="{Binding AppGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#E0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Content -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding AppName}" FontSize="11" FontWeight="Bold" Foreground="#A0FFFFFF" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#65FFFFFF" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                                                    <TextBlock Text="{Binding Body}"
                                                               Visibility="{Binding HasBody, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               FontSize="11.5" Foreground="#B0FFFFFF" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Dismiss Button -->
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource WindowMiniBtn}"
                                                        Click="DismissNotification_Click"
                                                        Tag="{Binding Id}"
                                                        ToolTip="Descartar"
                                                        Width="22" Height="22"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="&#xE1B2;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="10" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Footer -->
                    <Border Grid.Row="3" Margin="0,12,0,0">
                        <Button Style="{StaticResource InspectorActionSecondaryBtn}"
                                Click="OpenWindowsNotificationCenter_Click"
                                HorizontalAlignment="Stretch"
                                ToolTip="Abrir centro de notificaciones nativo de Windows (Win+N)">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE0B9;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Abrir en Windows (Win+N)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= IN-WINDOW CONNECTED DEVICES CARD ================= -->
            <Border x:Name="ConnectedDevicesCard"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Margin="0,24,36,0"
                    Width="400"
                    MaxHeight="540"
                    Background="#E60B0F17"
                    BorderBrush="#35FFFFFF"
                    BorderThickness="1.2"
                    CornerRadius="20"
                    Padding="16"
                    SnapsToDevicePixels="True"
                    Visibility="{Binding ConnectedDevicesCardVisibility}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.65" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0: Header (Icon, Title, Count, Refresh Button, Close Button) -->
                        <RowDefinition Height="Auto" />
                        <!-- 1: Divider -->
                        <RowDefinition Height="Auto" />
                        <!-- 2: Body (List or Empty State) -->
                        <RowDefinition Height="*" />
                        <!-- 3: Footer (Abrir Configuración Bluetooth / Sonido) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#2034C759" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#34C759" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Dispositivos" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Background="#25FFFFFF" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConnectedDevicesCountText}" FontSize="11" FontWeight="Medium" Foreground="#B0FFFFFF" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Actualizar lista -->
                            <Button Style="{StaticResource CleanGlyphButtonStyle}"
                                    Click="RefreshConnectedDevices_Click"
                                    Width="26" Height="26"
                                    Margin="0,0,4,0"
                                    ToolTip="Actualizar dispositivos">
                                <TextBlock Text="&#xE116;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="12.5" Foreground="#90FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>

                            <!-- Cerrar panel -->
                            <Button Style="{StaticResource CleanGlyphButtonStyle}"
                                    Click="CloseConnectedDevicesCard_Click"
                                    Width="26" Height="26"
                                    ToolTip="Cerrar panel">
                                <TextBlock Text="&#xE1B2;" FontFamily="{DynamicResource LucideIconsFont}" FontSize="13" Foreground="#90FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Subtle Divider -->
                    <Border Grid.Row="1" Height="1" Background="#18FFFFFF" Margin="-16,0,-16,12" />

                    <!-- Body: List or Empty State -->
                    <Grid Grid.Row="2" MinHeight="140" MaxHeight="380">
                        <!-- Empty State View -->
                        <Grid Visibility="{Binding HasNoConnectedDevices, Converter={StaticResource BooleanToVisibilityConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="50" Height="50" CornerRadius="25" Background="#12FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No se detectaron dispositivos"
                                           FontSize="13.5" FontWeight="SemiBold" Foreground="#E0FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="Los dispositivos Bluetooth, audio, controles y unidades USB conectados aparecerán aquí."
                                           FontSize="11.5" Foreground="#70FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
                            </StackPanel>
                        </Grid>

                        <!-- Devices List -->
                        <ScrollViewer Visibility="{Binding HasConnectedDevices, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Style="{StaticResource SlimScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ConnectedDevicesList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Background="#18FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Margin="0,0,0,8" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Device Glyph Circle -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#22FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Content (Name, Category, Status) -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <!-- Title & Category pill -->
                                                    <Grid Margin="0,0,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="1" Background="#25FFFFFF" CornerRadius="6" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Medium" Foreground="#D0FFFFFF" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Subtitle: Status Dot + Details -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="6" Height="6" CornerRadius="3" Background="#34C759" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Medium" Foreground="#A0FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="•" FontSize="11" Foreground="#50FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                   Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock Text="{Binding DetailsText}" FontSize="11" Foreground="#75FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Footer: Quick settings links -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource InspectorActionSecondaryBtn}"
                                Click="OpenBluetoothSettings_Click"
                                ToolTip="Abrir Configuración de Bluetooth y Dispositivos de Windows">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#B0FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Bluetooth" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource InspectorActionSecondaryBtn}"
                                Click="OpenSoundSettings_Click"
                                ToolTip="Abrir Configuración de Sonido de Windows">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#B0FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Sonido" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= FLOATING WALLPAPER FAN DECK (PURE ARTWORK) ================= -->
            <Grid x:Name="WallpaperFanCard"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Width="1600"
                  Height="560"
                  Margin="0,15,0,0"
                  Background="Transparent"
                  PreviewMouseWheel="FanStage_PreviewMouseWheel"
                  Visibility="{Binding WallpaperFanCardVisibility}">

                <!-- Fan Deck Canvas -->
                <ItemsControl ItemsSource="{Binding FanWallpapersList}"
                              Visibility="{Binding HasFanWallpapers, Converter={StaticResource BooleanToVisibilityConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="1600" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <!-- Canvas positioning: Centered around (1600 - 480)/2 = 560, (560 - 270)/2 = 145 -->
                            <Setter Property="Canvas.Left" Value="560" />
                            <Setter Property="Canvas.Top" Value="145" />
                            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                            <Setter Property="Opacity" Value="{Binding Opacity}" />
                            <Setter Property="Visibility" Value="{Binding Visibility}" />
                            <Setter Property="RenderTransformOrigin" Value="0.5, 0.90" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                                        <RotateTransform Angle="{Binding RotationAngle}" />
                                        <TranslateTransform X="{Binding TranslateX}" Y="{Binding TranslateY}" />
                                    </TransformGroup>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="480" Height="270"
                                    CornerRadius="24"
                                    BorderThickness="1.8"
                                    Cursor="Hand"
                                    Background="#141824"
                                    RenderOptions.BitmapScalingMode="Linear"
                                    RenderOptions.EdgeMode="Unspecified"
                                    PreviewMouseLeftButtonDown="FanCard_PreviewMouseLeftButtonDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#40FFFFFF" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black" RenderingBias="Performance" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHero}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FFFFFF" />
                                                <Setter Property="BorderThickness" Value="2.8" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.85" Color="#6366F1" RenderingBias="Performance" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid ClipToBounds="True">
                                    <Border CornerRadius="22">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

        </Grid>
    </Border>
</Window>
